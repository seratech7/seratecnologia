# ===== SERVIDOR =====
PORT=3001
NODE_ENV=production
SESSION_SECRET=troque-esta-chave-por-uma-longa-e-aleatoria

# ===== ADMIN =====
ADMIN_PATH=/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Troque123!

# ===== MONERO (modo de operacao) =====
# mock = simula a carteira localmente (sem node), ideal para testes/desenvolvimento
# live = usa um node Monero real + monero-wallet-rpc
WALLET_MODE=mock

# ===== MONERO LIVE (usado quando WALLET_MODE=live) =====
# URL do monero-wallet-rpc (conta-mestra). NUNCA exponha publicamente.
MONERO_RPC_URL=http://127.0.0.1:18082/json_rpc
MONERO_RPC_USERNAME=
MONERO_RPC_PASSWORD=

# ===== SCANNER DE DEPOSITOS =====
SCAN_INTERVAL_SECONDS=20
MIN_CONFIRMATIONS=10

# ===== TAXA DE SAQUE (XMR) =====
WITHDRAWAL_FEE_XMR=0.0001

# ===== SITE =====
SITE_NAME=MoneroWallet
SITE_URL=http://localhost:3001

# ===== API PARA INTEGRACAO COM O MARKETPLACE =====
# Chaves separadas por virgula. O marketplace usara estas chaves para
# consultar saldo e reter/capturar pagamentos em XMR.
API_KEYS=troque-esta-chave-api