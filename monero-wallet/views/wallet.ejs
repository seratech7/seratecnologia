<%- include('partials/header') %>
<meta name="csrf-token" content="<%= csrfToken %>">

<div class="balance-hero">
  <div>
    <div class="balance-label">Saldo disponível</div>
    <div class="balance-value"><span id="user-balance" data-balance="<%= balance %>"><%= fmt(balance) %></span> <small>XMR</small></div>
    <div class="muted">Bem-vindo(a), <%= user.display_name || user.email %></div>
  </div>
  <div class="balance-actions">
    <a class="btn btn-xmr" href="/deposit">Depositar</a>
    <a class="btn btn-ok" href="/withdraw">Sacar</a>
  </div>
</div>

<div class="grid grid-2 mt">
  <div class="card">
    <h3>Seu endereço de depósito</h3>
    <div class="address-box">
      <code id="deposit-address"><%= address %></code>
      <button class="btn btn-sm btn-ghost" data-copy="<%= address %>">Copiar</button>
    </div>
    <div class="hint mt">Envie XMR para este endereço. O valor entra automaticamente na sua carteira após a confirmação na rede.</div>
    <div class="mt">
      <a class="btn btn-sm" href="/deposit">Ver QR code e instruções</a>
    </div>
  </div>

  <div class="card">
    <h3>Atividade recente</h3>
    <% if (recent.length === 0) { %>
      <p class="muted">Nenhuma movimentação ainda.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Tipo</th><th>Valor</th><th>Data</th></tr></thead>
          <tbody>
            <% recent.forEach(function(t) { %>
              <tr>
                <td>
                  <% if (t.type === 'deposit') { %><span class="pos">Depósito</span>
                  <% } else if (t.type === 'withdraw') { %><span class="neg">Saque</span>
                  <% } else if (t.type === 'hold') { %><span>Reserva</span>
                  <% } else if (t.type === 'release') { %><span class="pos">Reembolso</span>
                  <% } else if (t.type === 'adjustment') { %><span>Ajuste</span>
                  <% } else if (t.type === 'refund') { %><span class="pos">Estorno</span>
                  <% } else { %><%= t.type %><% } %>
                </td>
                <td class="<%= t.amount_atomic.startsWith('-') ? 'neg' : 'pos' %> mono">
                  <%= (t.amount_atomic.startsWith('-') ? '-' : '+') + fmt(t.amount_atomic.replace('-','')) %> XMR
                </td>
                <td class="muted"><%= t.created_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <a class="btn btn-sm btn-ghost mt" href="/history">Ver histórico completo</a>
    <% } %>
  </div>
</div>

<div class="grid grid-2 mt">
  <div class="card">
    <h3>Depósitos</h3>
    <% if (deposits.length === 0) { %>
      <p class="muted">Nenhum depósito.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Valor</th><th>Status</th><th>Data</th></tr></thead>
          <tbody>
            <% deposits.forEach(function(d) { %>
              <tr>
                <td class="pos mono"><%= fmt(d.amount_atomic) %> XMR</td>
                <td><span class="badge badge-<%= d.status %>"><%= d.status %></span></td>
                <td class="muted"><%= d.created_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="card">
    <h3>Saques</h3>
    <% if (withdrawals.length === 0) { %>
      <p class="muted">Nenhum saque.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Valor</th><th>Status</th><th>Data</th></tr></thead>
          <tbody>
            <% withdrawals.forEach(function(w) { %>
              <tr>
                <td class="neg mono"><%= fmt(w.amount_atomic) %> XMR</td>
                <td><span class="badge badge-<%= w.status %>"><%= w.status %></span></td>
                <td class="muted"><%= w.requested_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>