<%- include('partials/header') %>
<meta name="csrf-token" content="<%= csrfToken %>">

<div class="card form-box">
  <h2 class="text-center">Autenticação 2FA</h2>
  <% if (enabled) { %>
    <div class="alert alert-ok">2FA está <strong>ativado</strong> na sua conta.</div>
    <p class="muted mb">Digite um código do seu aplicativo autenticador para desativar.</p>
    <form id="form-disable">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label>Código 2FA</label>
        <input class="input" type="text" name="code" inputmode="numeric" required>
      </div>
      <button class="btn btn-block btn-danger" type="submit">Desativar 2FA</button>
    </form>
  <% } else { %>
    <p class="muted mb">Use um aplicativo autenticador (Google Authenticator, Authy, etc.) para escanear o QR code e ativar a proteção.</p>
    <div class="text-center mb">
      <img id="qr-img" alt="QR code 2FA" style="display:none;border-radius:8px;background:#fff;padding:8px;width:200px;height:200px">
      <p id="qr-loading" class="muted">Carregando QR code...</p>
    </div>
    <div class="field">
      <label>Segredo manual</label>
      <input class="input mono" id="secret-field" type="text" readonly>
    </div>
    <form id="form-enable">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="pending_secret" id="pending-secret" value="<%= pendingSecret || '' %>">
      <div class="field">
        <label>Digite o código do autenticador para confirmar</label>
        <input class="input" type="text" name="code" inputmode="numeric" required>
      </div>
      <button class="btn btn-block btn-ok" type="submit">Ativar 2FA</button>
    </form>
  <% } %>
</div>

<script>
(function () {
  var secret = '<%= pendingSecret || "" %>';
  if (secret) {
    fetch('/account/2fa/qr').then(function (r) { return r.json(); }).then(function (j) {
      if (j.qr) {
        document.getElementById('qr-img').src = j.qr;
        document.getElementById('qr-img').style.display = 'inline-block';
        document.getElementById('qr-loading').style.display = 'none';
        document.getElementById('secret-field').value = j.secret;
        document.getElementById('pending-secret').value = j.secret;
      }
    });
  }

  function submit(formId, url, successMsg) {
    var f = document.getElementById(formId);
    if (!f) return;
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      apiPost(url, new URLSearchParams(new FormData(f)).toString().replace(/\+/g, '%20') ? Object.fromEntries(new URLSearchParams(new FormData(f))) : {}, function () {
        toast(successMsg);
        setTimeout(function () { location.reload(); }, 1200);
      });
    });
  }
  submit('form-enable', '/account/2fa', '2FA ativado com sucesso');
  submit('form-disable', '/account/2fa', '2FA desativado');
})();
</script>

<%- include('partials/footer') %>