<%- include('partials/header') %>
<meta name="csrf-token" content="<%= csrfToken %>">

<div class="grid grid-2">
  <div class="card">
    <h3>Usuário #<%= user.id %> — <%= user.email %></h3>
    <p class="muted mb">Registro: <%= user.created_at %> · Último login: <%= user.last_login_at || '—' %></p>

    <div class="stats-row mb">
      <div class="stat"><div class="v"><%= fmt(user.balance_atomic) %></div><div class="l">Saldo (XMR)</div></div>
      <div class="stat"><div class="v"><%= user.totp_enabled ? 'Sim' : 'Não' %></div><div class="l">2FA</div></div>
      <div class="stat"><div class="v"><span class="badge badge-<%= user.status %>"><%= user.status %></span></div><div class="l">Status</div></div>
    </div>

    <h3>Ajuste de saldo</h3>
    <form id="balance-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid grid-2">
        <div class="field">
          <label>Valor (XMR)</label>
          <input class="input" type="text" name="amount" placeholder="0.01" required>
        </div>
        <div class="field">
          <label>Direção</label>
          <select class="select" name="direction">
            <option value="credit">Crédito (+)</option>
            <option value="debit">Débito (−)</option>
          </select>
        </div>
      </div>
      <div class="field">
        <label>Descrição</label>
        <input class="input" type="text" name="description" placeholder="Motivo do ajuste">
      </div>
      <button class="btn btn-sm" type="submit">Aplicar ajuste</button>
    </form>

    <div class="mt">
      <button class="btn btn-sm <%= user.status === 'blocked' ? 'btn-ok' : 'btn-danger' %>" id="btn-status">
        <%= user.status === 'blocked' ? 'Desbloquear' : 'Bloquear' %> usuário
      </button>
      <button class="btn btn-sm btn-danger" id="btn-delete" style="margin-left:8px">Excluir</button>
    </div>
  </div>

  <div class="card">
    <h3>Transações</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Tipo</th><th>Valor</th><th>Saldo após</th><th>Data</th></tr></thead>
        <tbody>
          <% txns.forEach(function(t) { %>
            <tr>
              <td><%= t.type %></td>
              <td class="<%= t.amount_atomic.startsWith('-') ? 'neg' : 'pos' %> mono"><%= fmt(t.amount_atomic.replace('-','')) %> XMR</td>
              <td class="mono"><%= fmt(t.balance_after_atomic) %></td>
              <td class="muted"><%= t.created_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="grid grid-2 mt">
  <div class="card">
    <h3>Depósitos</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Valor</th><th>Status</th><th>Data</th></tr></thead>
        <tbody>
          <% deposits.forEach(function(d) { %>
            <tr>
              <td class="pos mono"><%= fmt(d.amount_atomic) %> XMR</td>
              <td><span class="badge badge-<%= d.status %>"><%= d.status %></span></td>
              <td class="muted"><%= d.created_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h3>Saques</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Valor</th><th>Status</th><th>Data</th></tr></thead>
        <tbody>
          <% withdrawals.forEach(function(w) { %>
            <tr>
              <td class="neg mono"><%= fmt(w.amount_atomic) %> XMR</td>
              <td><span class="badge badge-<%= w.status %>"><%= w.status %></span></td>
              <td class="muted"><%= w.requested_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
document.getElementById('balance-form').addEventListener('submit', function (e) {
  e.preventDefault();
  apiPost('<%= adminPath %>/users/<%= user.id %>/balance', new URLSearchParams(new FormData(this)), function () {
    toast('Saldo atualizado');
    setTimeout(function () { location.reload(); }, 1200);
  });
});
document.getElementById('btn-status').addEventListener('click', function () {
  apiPost('<%= adminPath %>/users/<%= user.id %>/status', { status: '<%= user.status === "blocked" ? "active" : "blocked" %>' }, function () {
    toast('Status atualizado');
    setTimeout(function () { location.reload(); }, 1200);
  });
});
document.getElementById('btn-delete').addEventListener('click', function () {
  if (!confirm('Excluir definitivamente este usuário e todos os registros?')) return;
  apiPost('<%= adminPath %>/users/<%= user.id %>/delete', {}, function () {
    toast('Usuário excluído');
    setTimeout(function () { location.href = '<%= adminPath %>/users'; }, 1200);
  });
});
</script>

<%- include('partials/footer') %>