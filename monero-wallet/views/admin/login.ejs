<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="site">
  <div class="container main">
    <div class="form-box">
      <div class="card">
        <h2 class="text-center">Login Administrador</h2>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <form method="POST" action="<%= adminPath %>/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label>Usuário</label>
            <input class="input" type="text" name="username" required autocomplete="username">
          </div>
          <div class="field">
            <label>Senha</label>
            <input class="input" type="password" name="password" required autocomplete="current-password">
          </div>
          <div class="field">
            <label>Código 2FA <span class="hint">(se ativado)</span></label>
            <input class="input" type="text" name="totp" placeholder="000000" inputmode="numeric">
          </div>
          <button class="btn btn-block btn-xmr" type="submit">Entrar</button>
        </form>
      </div>
    </div>
  </div>
  <script src="/js/app.js"></script>
</body>
</html>