<%- include('partials/header') %>
<meta name="csrf-token" content="<%= csrfToken %>">

<div class="card">
  <h2>Logs de Auditoria</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>ID</th><th>Admin</th><th>Ação</th><th>Detalhes</th><th>IP</th><th>Data</th></tr></thead>
      <tbody>
        <% logs.forEach(function(l) { %>
          <tr>
            <td class="mono">#<%= l.id %></td>
            <td><%= l.admin_id ? 'Admin #' + l.admin_id : '—' %></td>
            <td><code><%= l.action %></code></td>
            <td class="muted"><%= l.details %></td>
            <td class="mono"><%= l.ip %></td>
            <td class="muted"><%= l.created_at %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="pagination">
    <% if (page > 1) { %><a href="<%= adminPath %>/logs?page=<%= page - 1 %>">← Anterior</a><% } %>
    <span>Página <%= page %> de <%= pages %></span>
    <% if (page < pages) { %><a href="<%= adminPath %>/logs?page=<%= page + 1 %>">Próxima →</a><% } %>
  </div>
</div>

<%- include('partials/footer') %>