<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="site">
  <header class="navbar">
    <div class="container navbar-inner">
      <a href="<%= adminPath %>" class="logo">◉ <span>Admin</span> MoneroWallet</a>
      <nav class="nav-links">
        <a href="<%= adminPath %>">Dashboard</a>
        <a href="<%= adminPath %>/users">Usuários</a>
        <a href="<%= adminPath %>/deposits">Depósitos</a>
        <a href="<%= adminPath %>/withdrawals">Saques</a>
        <a href="<%= adminPath %>/wallet">Conta-Mestra</a>
        <a href="<%= adminPath %>/settings">Configurações</a>
        <a href="<%= adminPath %>/security">Segurança</a>
        <a href="<%= adminPath %>/logs">Logs</a>
        <form method="POST" action="<%= adminPath %>/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-link" type="submit">Sair</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="container main">
    <% if (flash && flash.length) { %>
      <% flash.forEach(function(f) { %>
        <div class="alert alert-<%= f.type %>"><%= f.text %></div>
      <% }) %>
    <% } %>