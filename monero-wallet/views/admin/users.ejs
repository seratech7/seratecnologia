<%- include('partials/header') %>
<meta name="csrf-token" content="<%= csrfToken %>">

<div class="card">
  <h2>Usuários</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>ID</th><th>Email</th><th>Status</th><th>Saldo (XMR)</th><th>2FA</th><th>Registro</th><th></th></tr></thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr>
            <td class="mono">#<%= u.id %></td>
            <td><a href="<%= adminPath %>/users/<%= u.id %>"><%= u.email %></a></td>
            <td><span class="badge badge-<%= u.status %>"><%= u.status %></span></td>
            <td class="mono"><%= fmt(u.balance_atomic) %></td>
            <td><%= u.totp_enabled ? 'Sim' : '—' %></td>
            <td class="muted"><%= u.created_at %></td>
            <td><a class="btn btn-sm btn-ghost" href="<%= adminPath %>/users/<%= u.id %>">Abrir</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="pagination">
    <% if (page > 1) { %><a href="<%= adminPath %>/users?page=<%= page - 1 %>">← Anterior</a><% } %>
    <span>Página <%= page %> de <%= pages %></span>
    <% if (page < pages) { %><a href="<%= adminPath %>/users?page=<%= page + 1 %>">Próxima →</a><% } %>
  </div>
</div>

<%- include('partials/footer') %>