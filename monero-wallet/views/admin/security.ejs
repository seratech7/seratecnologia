<%- include('partials/header') %>
<meta name="csrf-token" content="<%= csrfToken %>">

<div class="grid grid-2">
  <div class="card">
    <h3>Autenticação 2FA do admin</h3>
    <% if (totpEnabled) { %>
      <div class="alert alert-ok">2FA está ativado para este admin.</div>
      <form id="form-disable">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label>Código 2FA</label>
          <input class="input" type="text" name="code" inputmode="numeric" required>
        </div>
        <button class="btn btn-sm btn-danger" type="submit">Desativar 2FA</button>
      </form>
    <% } else { %>
      <div class="text-center mb">
        <img id="qr-img" alt="QR code 2FA" style="display:none;border-radius:8px;background:#fff;padding:8px;width:200px;height:200px">
        <p id="qr-loading" class="muted">Carregando QR code...</p>
      </div>
      <div class="field">
        <label>Segredo manual</label>
        <input class="input mono" id="secret-field" type="text" readonly>
      </div>
      <form id="form-enable">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="pending_secret" id="pending-secret" value="">
        <div class="field">
          <label>Digite o código do autenticador para confirmar</label>
          <input class="input" type="text" name="code" inputmode="numeric" required>
        </div>
        <button class="btn btn-sm btn-ok" type="submit">Ativar 2FA</button>
      </form>
    <% } %>
  </div>

  <div class="card">
    <h3>Alterar senha do admin</h3>
    <form id="password-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label>Senha atual</label>
        <input class="input" type="password" name="current" required autocomplete="current-password">
      </div>
      <div class="field">
        <label>Nova senha</label>
        <input class="input" type="password" name="next" required minlength="8" autocomplete="new-password">
      </div>
      <div class="field">
        <label>Confirmar nova senha</label>
        <input class="input" type="password" name="confirm" required minlength="8" autocomplete="new-password">
      </div>
      <button class="btn" type="submit">Alterar senha</button>
    </form>
  </div>
</div>

<script>
(function () {
  if (!document.getElementById('form-enable')) return;
  fetch('<%= adminPath %>/security/2fa/qr').then(function (r) { return r.json(); }).then(function (j) {
    if (j.qr) {
      document.getElementById('qr-img').src = j.qr;
      document.getElementById('qr-img').style.display = 'inline-block';
      document.getElementById('qr-loading').style.display = 'none';
      document.getElementById('secret-field').value = j.secret;
      document.getElementById('pending-secret').value = j.secret;
    }
  });
})();
var fEnable = document.getElementById('form-enable');
if (fEnable) fEnable.addEventListener('submit', function (e) {
  e.preventDefault();
  apiPost('<%= adminPath %>/security/2fa', new URLSearchParams(new FormData(this)), function () {
    toast('2FA ativado');
    setTimeout(function () { location.reload(); }, 1200);
  });
});
var fDisable = document.getElementById('form-disable');
if (fDisable) fDisable.addEventListener('submit', function (e) {
  e.preventDefault();
  apiPost('<%= adminPath %>/security/2fa', new URLSearchParams(new FormData(this)), function () {
    toast('2FA desativado');
    setTimeout(function () { location.reload(); }, 1200);
  });
});
document.getElementById('password-form').addEventListener('submit', function (e) {
  e.preventDefault();
  apiPost('<%= adminPath %>/security/password', new URLSearchParams(new FormData(this)), function () { toast('Senha alterada'); });
});
</script>

<%- include('partials/footer') %>