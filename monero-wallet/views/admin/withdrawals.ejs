<%- include('partials/header') %>
<meta name="csrf-token" content="<%= csrfToken %>">

<div class="card">
  <h2>Saques</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>ID</th><th>Usuário</th><th>Valor (XMR)</th><th>Destino</th><th>Status</th><th>Data</th><th>TxID</th><th></th></tr></thead>
      <tbody>
        <% withdrawals.forEach(function(w) { %>
          <tr>
            <td class="mono">#<%= w.id %></td>
            <td><%= w.user_name || w.user_email || '—' %></td>
            <td class="neg mono"><%= fmt(w.amount_atomic) %></td>
            <td class="mono"><%= w.address.slice(0, 16) %>…</td>
            <td><span class="badge badge-<%= w.status %>"><%= w.status %></span></td>
            <td class="muted"><%= w.requested_at %></td>
            <td class="mono"><%= w.txid ? w.txid.slice(0, 12) + '…' : '—' %></td>
            <td>
              <% if (w.status === 'pending') { %>
                <button class="btn btn-sm btn-ok" data-approve="<%= w.id %>">Aprovar e enviar</button>
                <button class="btn btn-sm btn-danger" data-reject="<%= w.id %>">Rejeitar</button>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="pagination">
    <% if (page > 1) { %><a href="<%= adminPath %>/withdrawals?page=<%= page - 1 %>">← Anterior</a><% } %>
    <span>Página <%= page %> de <%= pages %></span>
    <% if (page < pages) { %><a href="<%= adminPath %>/withdrawals?page=<%= page + 1 %>">Próxima →</a><% } %>
  </div>
</div>

<script>
document.querySelectorAll('[data-approve]').forEach(function (b) {
  b.addEventListener('click', function () {
    if (!confirm('Confirmar envio do saque a partir da conta-mestra?')) return;
    b.disabled = true; b.textContent = 'Enviando...';
    apiPost('<%= adminPath %>/withdrawals/' + b.dataset.approve + '/approve', {}, function (j) {
      toast('Saque enviado: ' + (j.txid ? j.txid.slice(0, 20) + '…' : ''));
      setTimeout(function () { location.reload(); }, 1200);
    });
  });
});
document.querySelectorAll('[data-reject]').forEach(function (b) {
  b.addEventListener('click', function () {
    if (!confirm('Rejeitar este saque e devolver o saldo?')) return;
    apiPost('<%= adminPath %>/withdrawals/' + b.dataset.reject + '/reject', { note: 'Rejeitado pelo administrador' }, function () { location.reload(); });
  });
});
</script>

<%- include('partials/footer') %>