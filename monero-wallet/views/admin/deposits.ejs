<%- include('partials/header') %>
<meta name="csrf-token" content="<%= csrfToken %>">

<div class="card">
  <h2>Depósitos</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>ID</th><th>Usuário</th><th>Valor (XMR)</th><th>Confirmações</th><th>Status</th><th>Data</th><th></th></tr></thead>
      <tbody>
        <% deposits.forEach(function(d) { %>
          <tr>
            <td class="mono">#<%= d.id %></td>
            <td><%= d.user_name || d.user_email || '—' %></td>
            <td class="pos mono"><%= fmt(d.amount_atomic) %></td>
            <td class="mono"><%= d.confirmations %></td>
            <td><span class="badge badge-<%= d.status %>"><%= d.status %></span></td>
            <td class="muted"><%= d.created_at %></td>
            <td>
              <% if (d.status === 'pending') { %>
                <button class="btn btn-sm btn-ok" data-confirm="<%= d.id %>">Confirmar</button>
              <% } %>
              <button class="btn btn-sm btn-danger" data-refund="<%= d.id %>" <%= d.status === 'refunded' ? 'disabled' : '' %>>Reverter</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="pagination">
    <% if (page > 1) { %><a href="<%= adminPath %>/deposits?page=<%= page - 1 %>">← Anterior</a><% } %>
    <span>Página <%= page %> de <%= pages %></span>
    <% if (page < pages) { %><a href="<%= adminPath %>/deposits?page=<%= page + 1 %>">Próxima →</a><% } %>
  </div>
</div>

<script>
document.querySelectorAll('[data-confirm]').forEach(function (b) {
  b.addEventListener('click', function () {
    apiPost('<%= adminPath %>/deposits/' + b.dataset.confirm + '/confirm', {}, function () { location.reload(); });
  });
});
document.querySelectorAll('[data-refund]').forEach(function (b) {
  b.addEventListener('click', function () {
    if (!confirm('Reverter este depósito (estornar saldo)?')) return;
    apiPost('<%= adminPath %>/deposits/' + b.dataset.refund + '/refund', {}, function () { location.reload(); });
  });
});
</script>

<%- include('partials/footer') %>