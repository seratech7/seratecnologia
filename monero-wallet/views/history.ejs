<%- include('partials/header') %>
<meta name="csrf-token" content="<%= csrfToken %>">

<div class="card">
  <h2>Histórico de transações</h2>
  <% if (txns.length === 0) { %>
    <p class="muted">Nenhuma transação.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Tipo</th><th>Valor</th><th>Saldo após</th><th>Descrição</th><th>Data</th></tr></thead>
        <tbody>
          <% txns.forEach(function(t) { %>
            <tr>
              <td>
                <% if (t.type === 'deposit') { %><span class="pos">Depósito</span>
                <% } else if (t.type === 'withdraw') { %><span class="neg">Saque</span>
                <% } else if (t.type === 'hold') { %><span>Reserva</span>
                <% } else if (t.type === 'release') { %><span class="pos">Reembolso</span>
                <% } else if (t.type === 'adjustment') { %><span>Ajuste</span>
                <% } else if (t.type === 'refund') { %><span class="pos">Estorno</span>
                <% } else if (t.type === 'debit') { %><span class="neg">Pagamento</span>
                <% } else { %><%= t.type %><% } %>
              </td>
              <td class="<%= t.amount_atomic.startsWith('-') ? 'neg' : 'pos' %> mono">
                <%= (t.amount_atomic.startsWith('-') ? '-' : '+') + fmt(t.amount_atomic.replace('-','')) %> XMR
              </td>
              <td class="mono"><%= fmt(t.balance_after_atomic) %></td>
              <td class="muted"><%= t.description %></td>
              <td class="muted"><%= t.created_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <div class="pagination">
    <% if (page > 1) { %><a href="/history?page=<%= page - 1 %>">← Anterior</a><% } %>
    <span>Página <%= page %> de <%= pages %></span>
    <% if (page < pages) { %><a href="/history?page=<%= page + 1 %>">Próxima →</a><% } %>
  </div>
</div>

<%- include('partials/footer') %>