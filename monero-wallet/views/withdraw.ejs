<%- include('partials/header') %>
<meta name="csrf-token" content="<%= csrfToken %>">

<div class="grid grid-2">
  <div class="card">
    <h2>Sacar XMR</h2>
    <% if (!enabled) { %>
      <div class="alert alert-warn">Os saques estão temporariamente desativados.</div>
    <% } else { %>
      <p class="muted mb">Os saques são revisados pelo administrador antes de serem enviados da conta-mestra.</p>
      <form id="withdraw-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label>Endereço Monero de destino</label>
          <input class="input" type="text" name="address" placeholder="Endereço XMR (4...)" required>
          <div class="hint">O saque será enviado para este endereço externo.</div>
        </div>
        <div class="field">
          <label>Valor (XMR)</label>
          <input class="input" type="text" name="amount" placeholder="0.000000000000" required inputmode="decimal">
        </div>
        <div class="alert alert-info">Taxa de saque: <strong><%= fmt(fee) %> XMR</strong></div>
        <button class="btn btn-block btn-ok" type="submit">Solicitar saque</button>
      </form>
    <% } %>
  </div>

  <div class="card">
    <h3>Histórico de saques</h3>
    <% if (history.length === 0) { %>
      <p class="muted">Nenhum saque.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Valor</th><th>Status</th><th>Data</th></tr></thead>
          <tbody>
            <% history.forEach(function(w) { %>
              <tr>
                <td class="neg mono"><%= fmt(w.amount_atomic) %> XMR</td>
                <td><span class="badge badge-<%= w.status %>"><%= w.status %></span></td>
                <td class="muted"><%= w.requested_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
var form = document.getElementById('withdraw-form');
if (form) {
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var data = new URLSearchParams(new FormData(form)).toString();
    fetch('/withdraw', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
      body: data
    }).then(function (r) { return r.json(); }).then(function (json) {
      if (json.error) { toast(json.error, 'error'); }
      else { toast('Saque solicitado e em análise'); form.reset(); setTimeout(function () { location.reload(); }, 1200); }
    }).catch(function () { toast('Falha de conexão', 'error'); });
  });
}
</script>

<%- include('partials/footer') %>