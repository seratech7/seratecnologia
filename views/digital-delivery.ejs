<%- include('partials/header') %>

<div class="marketplace-container" style="padding:40px 16px;max-width:620px;margin:0 auto;text-align:center;">
  <div style="background:var(--card-bg);border:1px solid var(--hack-border);border-radius:16px;padding:32px;">
    <div style="width:64px;height:64px;border-radius:50%;background:rgba(76,175,80,.15);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
      <i class="fas fa-check" style="font-size:30px;color:#4caf50;"></i>
    </div>
    <h1 style="font-size:24px;margin:0 0 8px;">Entrega realizada!</h1>
    <p style="color:var(--hack-dim);margin:0 0 24px;">Seus dados de acesso foram liberados abaixo.</p>

    <div style="text-align:left;background:var(--hack-bg-2);border:1px solid var(--hack-border);border-radius:12px;padding:20px;margin-bottom:20px;">
      <h3 style="margin:0 0 12px;font-size:16px;color:var(--primary);"><i class="fas fa-box"></i> <%= sale.product_name %></h3>
      <div style="font-size:14px;line-height:1.9;">
        <div><span style="color:var(--hack-dim);">Acesso/Credencial:</span> <code style="background:rgba(255,255,255,.08);padding:2px 8px;border-radius:5px;user-select:all;"><%= sale.credential %></code></div>
        <% if (sale.password) { %><div style="margin-top:8px;"><span style="color:var(--hack-dim);">Senha:</span> <code style="background:rgba(255,255,255,.08);padding:2px 8px;border-radius:5px;user-select:all;"><%= sale.password %></code></div><% } %>
        <% if (sale.note) { %><div style="margin-top:8px;"><span style="color:var(--hack-dim);">Observações:</span> <%= sale.note %></div><% } %>
      </div>
    </div>

    <div style="background:rgba(21,101,192,.1);border:1px solid rgba(21,101,192,.3);border-radius:10px;padding:14px;margin-bottom:20px;">
      <span style="font-size:13px;color:var(--hack-dim);">Código de rastreio da entrega:</span><br>
      <code style="font-size:16px;font-weight:600;color:var(--primary);user-select:all;"><%= sale.delivery_code %></code>
    </div>

    <p style="font-size:12px;color:var(--hack-dim);">Guarde este código. Você pode acessar esta entrega novamente em <a href="/entrega/<%= sale.delivery_code %>" style="color:var(--primary);">/entrega/<%= sale.delivery_code %></a></p>

    <a href="/logins" class="btn-primary" style="display:inline-block;margin-top:16px;padding:12px 24px;text-decoration:none;">Voltar aos logins</a>
  </div>
</div>

<%- include('partials/footer') %>
