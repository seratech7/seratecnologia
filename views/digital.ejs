<%- include('partials/header') %>

<div class="marketplace-container" style="padding:24px 16px;max-width:1100px;margin:0 auto;">
  <div class="admin-header-bar" style="margin-bottom:20px;">
    <h1 style="font-size:26px;display:flex;align-items:center;gap:10px;">
      <i class="fas fa-key" style="color:var(--primary);"></i> Logins & Contas
    </h1>
    <span style="font-size:13px;color:var(--hack-dim);">Entrega automática após a compra</span>
  </div>

  <form action="/logins" method="GET" class="search-form" style="margin-bottom:20px;max-width:480px;">
    <i class="fas fa-search"></i>
    <input type="text" name="search" placeholder="Buscar logins..." value="<%= search %>">
    <button type="submit">Buscar</button>
  </form>

  <% if (categories.length > 0) { %>
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px;">
    <a href="/logins" class="btn-small <%= !selectedCategory ? 'active' : '' %>">Todos</a>
    <% categories.forEach(function(c) { %>
      <a href="/logins?category=<%= encodeURIComponent(c.category) %>" class="btn-small <%= selectedCategory === c.category ? 'active' : '' %>"><%= c.category %></a>
    <% }) %>
  </div>
  <% } %>

  <% if (products.length === 0) { %>
    <div class="empty-row" style="text-align:center;padding:40px;color:var(--hack-dim);">Nenhum produto disponível no momento.</div>
  <% } else { %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px;">
    <% products.forEach(function(p) { %>
      <a href="/login/<%= p.slug %>" style="text-decoration:none;color:inherit;background:var(--card-bg);border:1px solid var(--hack-border);border-radius:12px;overflow:hidden;display:flex;flex-direction:column;transition:transform .15s;">
        <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" style="width:100%;height:150px;object-fit:cover;"><% } %>
        <div style="padding:14px;display:flex;flex-direction:column;flex:1;">
          <% if (p.badge) { %><span class="status-badge active" style="align-self:flex-start;font-size:11px;margin-bottom:6px;"><%= p.badge %></span><% } %>
          <h3 style="margin:0 0 8px;font-size:16px;line-height:1.3;"><%= p.name %></h3>
          <p style="color:var(--hack-dim);font-size:13px;margin:0 0 auto;"><%= (p.description || '').slice(0,80) %><%= (p.description || '').length > 80 ? '...' : '' %></p>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px;">
            <strong style="font-size:18px;color:var(--primary);">R$ <%= Number(p.price).toFixed(2) %></strong>
            <span style="font-size:12px;color:<%= p.stock_count > 0 ? '#4caf50' : '#c62828' %>;"><%= p.stock_count > 0 ? p.stock_count + ' em estoque' : 'Esgotado' %></span>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
