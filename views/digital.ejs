<%- include('partials/header') %>

<style>
.dfg-wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px 50px; }
.dfg-site { color: var(--text); }

/* HERO ENTREGA AUTOMÁTICA */
.dfg-hero {
  background: linear-gradient(135deg, #0b0b12 0%, #1a0306 60%, #2a0608 100%);
  border-radius: 16px;
  margin: 18px 0;
  padding: 38px 28px;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255,60,60,.25);
}
.dfg-hero::after {
  content: ""; position: absolute; right: -60px; top: -60px;
  width: 260px; height: 260px; border-radius: 50%;
  background: radial-gradient(circle, rgba(229,9,20,.35), transparent 70%);
}
.dfg-hero h1 {
  margin: 0; font-size: 40px; line-height: 1.05; font-weight: 900; letter-spacing: .5px;
  background: linear-gradient(90deg, #ff4d4d, #ff8a3d); -webkit-background-clip: text; background-clip: text; color: transparent;
}
.dfg-hero h1 small { display:block; font-size: 18px; color:#ffd2c2; -webkit-text-fill-color: #ffd2c2; margin-top:6px; font-weight:700; letter-spacing:2px; }
.dfg-hero p.sub { color: #ffd9cf; margin: 14px 0 0; font-size: 15px; max-width: 560px; }
.dfg-feats { display:flex; gap:14px; flex-wrap:wrap; margin-top:22px; }
.dfg-feat {
  background: rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12);
  border-radius: 12px; padding: 12px 16px; display:flex; align-items:center; gap:10px; color:#fff; font-size:13px; font-weight:600;
}
.dfg-feat i { color:#ff5b5b; font-size:18px; }
.dfg-ver-btn {
  display:inline-flex; align-items:center; gap:8px; margin-top:24px;
  background: linear-gradient(90deg,#e50914,#ff5b3a); color:#fff; font-weight:800;
  padding:13px 26px; border-radius:30px; text-decoration:none; font-size:15px;
  box-shadow: 0 8px 24px rgba(229,9,20,.35);
}
.dfg-ver-btn:hover { transform: translateY(-1px); }

/* BANNER STREAMING + BUSCA */
.dfg-stream {
  background: linear-gradient(120deg,#101018,#1c0a14);
  border:1px solid var(--hack-border); border-radius:14px; padding:22px;
  display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap;
  margin-bottom: 18px;
}
.dfg-stream .stxt { color:#fff; }
.dfg-stream .stxt .big { font-size:22px; font-weight:900; letter-spacing:1px; }
.dfg-stream .stxt .big b { color:#ff5b5b; }
.dfg-stream .stxt .small { font-size:13px; color:#cfcfe0; margin-top:4px; letter-spacing:2px; }
.dfg-search { display:flex; background:#fff; border-radius:30px; overflow:hidden; min-width:300px; flex:1; max-width:460px; }
.dfg-search input { flex:1; border:0; outline:0; padding:13px 18px; font-size:14px; }
.dfg-search button { border:0; background:#e50914; color:#fff; padding:0 22px; cursor:pointer; font-weight:700; }

/* HIGHLIGHTS */
.dfg-highlights { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:26px; }
.dfg-hl {
  flex:1; min-width:150px; background:var(--card-bg); border:1px solid var(--hack-border);
  border-radius:12px; padding:16px; text-align:center;
}
.dfg-hl i { font-size:22px; color:var(--primary); display:block; margin-bottom:8px; }
.dfg-hl span { font-size:13px; font-weight:700; color:var(--text); }

/* SEÇÕES */
.dfg-section-title { display:flex; align-items:center; gap:12px; margin: 10px 0 18px; }
.dfg-section-title h2 { margin:0; font-size:24px; font-weight:900; color:var(--text); text-transform:uppercase; letter-spacing:.5px; }
.dfg-badge-dest { background:linear-gradient(90deg,#e50914,#ff5b3a); color:#fff; font-size:11px; font-weight:800; padding:4px 10px; border-radius:4px; letter-spacing:1px; }
.dfg-cat-title { font-size:20px; font-weight:900; text-transform:uppercase; margin:30px 0 14px; color:var(--text); border-left:4px solid var(--primary); padding-left:10px; }

/* FILTRO CATEGORIAS */
.dfg-cats { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:22px; }
.dfg-cats a {
  text-decoration:none; font-size:13px; font-weight:600; padding:8px 16px; border-radius:30px;
  background:var(--card-bg); border:1px solid var(--hack-border); color:var(--text);
}
.dfg-cats a.active, .dfg-cats a:hover { background:linear-gradient(90deg,#e50914,#ff5b3a); color:#fff; border-color:transparent; }

/* FILTRO RÁPIDO (abaixo da pesquisa) */
.dfg-filterbar { margin: 0 0 22px; }
.dfg-filter-form {
  display:flex; gap:14px; flex-wrap:wrap; align-items:flex-end;
  background:var(--card-bg); border:1px solid var(--hack-border); border-radius:14px; padding:16px 18px;
}
.ffield { display:flex; flex-direction:column; gap:5px; }
.ffield label { font-size:11px; font-weight:800; color:var(--hack-dim); text-transform:uppercase; letter-spacing:.6px; }
.ffield select {
  padding:10px 14px; border-radius:9px; border:1px solid var(--hack-border);
  background:#fff; color:#111; font-size:14px; min-width:170px; cursor:pointer; outline:none;
}
.ffield select:focus { border-color:var(--primary); box-shadow:0 0 0 2px rgba(229,9,20,.12); }
.ffield.fcheck { justify-content:flex-end; }
.fcheck-label { display:flex; align-items:center; gap:7px; font-size:13px; font-weight:600; color:var(--text); cursor:pointer; padding-bottom:10px; }
.fcheck-label input { width:16px; height:16px; accent-color:var(--primary); cursor:pointer; }
.fclear {
  margin-left:auto; align-self:center; font-size:12px; font-weight:700; color:var(--primary);
  text-decoration:none; display:inline-flex; align-items:center; gap:5px; padding:8px 12px;
  border:1px solid var(--hack-border); border-radius:9px;
}
.fclear:hover { background:var(--primary); color:#fff; border-color:transparent; }
.dfg-result-count {
  font-size:13px; font-weight:600; color:var(--hack-dim); margin: 4px 0 16px;
  display:flex; align-items:center; gap:8px; flex-wrap:wrap;
}
.dfg-result-count i { color:var(--primary); }
.dfg-result-count span { color:var(--text); font-weight:700; }
@media (max-width:600px){ .ffield select{ min-width:140px; } .fclear{ margin-left:0; } }

/* GRADE */
.dfg-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:16px; }
.dfg-card {
  background:var(--card-bg); border:1px solid var(--hack-border); border-radius:14px; overflow:hidden;
  display:flex; flex-direction:column; text-decoration:none; color:inherit; transition:transform .15s, box-shadow .15s;
}
.dfg-card:hover { transform:translateY(-3px); box-shadow:0 10px 26px rgba(0,0,0,.25); }
.dfg-card-img { position:relative; height:170px; background:#0e0e16; }
.dfg-card-img img { width:100%; height:100%; object-fit:cover; }
.dfg-auto {
  position:absolute; top:8px; left:8px; background:rgba(229,9,20,.92); color:#fff;
  font-size:10px; font-weight:800; padding:3px 8px; border-radius:4px; letter-spacing:.5px;
}
.dfg-card-body { padding:12px; display:flex; flex-direction:column; flex:1; }
.dfg-vendor { font-size:11px; color:var(--primary); font-weight:700; }
.dfg-cat-link { font-size:11px; color:var(--hack-dim); margin-left:6px; }
.dfg-card-title { font-size:14px; font-weight:700; line-height:1.3; margin:6px 0 6px; color:var(--text); }
.dfg-stars { color:#ffb400; font-size:12px; }
.dfg-stars .cnt { color:var(--hack-dim); margin-left:4px; font-size:11px; }
.dfg-price { font-size:18px; font-weight:900; color:var(--primary); margin:8px 0; }
.dfg-buy {
  margin-top:auto; display:block; text-align:center; background:linear-gradient(90deg,#e50914,#ff5b3a);
  color:#fff; font-weight:800; font-size:13px; padding:10px; border-radius:8px; text-decoration:none;
}
.dfg-buy:hover { filter:brightness(1.08); }
.dfg-empty { text-align:center; padding:50px; color:var(--hack-dim); }
@media (max-width:600px){ .dfg-hero h1{font-size:30px;} .dfg-stream{flex-direction:column;align-items:stretch;} }

/* CARROSSEL TOPO (info + 5 destaques) */
.dfg-carousel { position: relative; margin: 18px 0; border-radius: 16px; overflow: hidden; min-height: 360px; }
.dfg-carousel-track { position: relative; min-height: 360px; }
.dfg-slide {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  padding: 22px; opacity: 0; transform: scale(.98); transition: opacity .6s ease, transform .6s ease;
  z-index: 1; pointer-events: none;
}
.dfg-slide.dfg-active { opacity: 1; transform: scale(1); z-index: 2; pointer-events: auto; }
.dfg-slide-hero .dfg-hero { margin: 0; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; }
.dfg-prod-slide {
  display: flex; gap: 26px; align-items: center; width: 100%; max-width: 920px;
  background: linear-gradient(135deg, #0b0b12 0%, #1a0306 60%, #2a0608 100%);
  border: 1px solid rgba(255,60,60,.3); border-radius: 16px; padding: 22px 28px;
  text-decoration: none; box-shadow: 0 8px 30px rgba(0,0,0,.3);
}
.dfg-ps-img { position: relative; width: 240px; height: 200px; flex: 0 0 auto; border-radius: 12px; overflow: hidden; background: #0e0e16; }
.dfg-ps-img img { width: 100%; height: 100%; object-fit: cover; }
.dfg-ps-info { flex: 1; display: flex; flex-direction: column; gap: 8px; }
.dfg-ps-info .dfg-card-title { font-size: 22px; color: #fff; }
.dfg-ps-info .dfg-price { font-size: 26px; margin: 4px 0 8px; }
.dfg-car-arrow {
  position: absolute; top: 50%; transform: translateY(-50%); z-index: 5;
  width: 42px; height: 42px; border-radius: 50%; border: 1px solid rgba(255,255,255,.25);
  background: rgba(0,0,0,.45); color: #fff; cursor: pointer; font-size: 18px;
  display: flex; align-items: center; justify-content: center; transition: background .2s;
}
.dfg-car-prev { left: 12px; } .dfg-car-next { right: 12px; }
.dfg-car-arrow:hover { background: rgba(229,9,20,.9); }
.dfg-car-dots { position: absolute; bottom: 12px; left: 0; right: 0; z-index: 5; display: flex; gap: 8px; justify-content: center; }
.dfg-dot { width: 10px; height: 10px; border-radius: 50%; border: 0; background: rgba(255,255,255,.4); cursor: pointer; padding: 0; transition: all .25s; }
.dfg-dot.active { background: #ffd400; width: 22px; border-radius: 6px; }
@media (max-width: 640px){
  .dfg-carousel, .dfg-carousel-track { min-height: 440px; }
  .dfg-prod-slide { flex-direction: column; text-align: center; }
  .dfg-ps-img { width: 100%; height: 170px; }
}

/* MODO DARK: destaques amarelos na pagina DFGMAX */
body.hacker-theme .dfg-badge-dest { background: linear-gradient(90deg,#ffd400,#ffae00); color:#1a1400; }
body.hacker-theme .dfg-buy { background: linear-gradient(90deg,#ffd400,#ffae00); color:#1a1400; }
body.hacker-theme .dfg-buy:hover { filter:brightness(1.1); }
body.hacker-theme .dfg-auto { background: rgba(255,212,0,.95); color:#1a1400; }
body.hacker-theme .dfg-hero { border-color: rgba(255,212,0,.3); box-shadow: 0 8px 30px rgba(255,212,0,.12); }
body.hacker-theme .dfg-hero h1 { background: linear-gradient(90deg,#ffe066,#ffd400); -webkit-background-clip:text; background-clip:text; color:transparent; }
body.hacker-theme .dfg-hero p.sub { color:#ffe9a8; }
body.hacker-theme .dfg-feat { background: rgba(255,212,0,.08); border-color: rgba(255,212,0,.25); }
body.hacker-theme .dfg-feat i { color:#ffd400; }
body.hacker-theme .dfg-ver-btn { background: linear-gradient(90deg,#ffd400,#ffae00); color:#1a1400; box-shadow: 0 8px 24px rgba(255,212,0,.35); }
body.hacker-theme .dfg-stream { border-color: var(--hack-border); }
body.hacker-theme .dfg-search button { background:#ffd400; color:#1a1400; }
body.hacker-theme .dfg-cats a.active, body.hacker-theme .dfg-cats a:hover { background: linear-gradient(90deg,#ffd400,#ffae00); color:#1a1400; border-color:transparent; }
body.hacker-theme .dfg-cat-title { border-left-color:#ffd400; }
body.hacker-theme .dfg-price { color:#ffd400; }
body.hacker-theme .dfg-vendor { color:#ffd400; }
body.hacker-theme .dfg-car-arrow { border-color: rgba(255,212,0,.4); }
body.hacker-theme .dfg-car-arrow:hover { background:#ffd400; color:#1a1400; }
body.hacker-theme .dfg-dot { background: rgba(255,255,255,.3); }
body.hacker-theme .dfg-dot.active { background:#ffd400; }
body.hacker-theme .dfg-prod-slide { border-color: rgba(255,212,0,.3); }
body.hacker-theme .dfg-filter-form { background: var(--hack-panel); border-color: rgba(255,212,0,.3); }
body.hacker-theme .ffield label { color: var(--hack-dim); }
body.hacker-theme .ffield select { background:#0b0f18; color: var(--hack-text); border-color: rgba(255,212,0,.3); }
body.hacker-theme .ffield select:focus { border-color:#ffd400; box-shadow:0 0 0 2px rgba(255,212,0,.18); }
body.hacker-theme .fcheck-label { color: var(--hack-text); }
body.hacker-theme .fclear { color:#ffd400; border-color: rgba(255,212,0,.3); }
body.hacker-theme .fclear:hover { background:#ffd400; color:#1a1400; border-color:transparent; }
body.hacker-theme .dfg-result-count { color: var(--hack-dim); }
body.hacker-theme .dfg-result-count span { color: var(--hack-text); }
</style>

<div class="dfg-wrap dfg-site">

  <!-- CARROSSEL TOPO: informacoes + 5 produtos em destaque -->
  <section class="dfg-carousel" id="dfgTopCarousel">
    <div class="dfg-carousel-track">
      <!-- Slide 0: informacoes (mantidas) -->
      <div class="dfg-slide dfg-slide-hero dfg-active">
        <div class="dfg-hero">
          <h1>ENTREGA AUTOMÁTICA<small>+ RÁPIDA DO BRASIL</small></h1>
          <p class="sub">Receba sua chave ou acesso na hora. Compra 100% segura com suporte especializado e humanizado.</p>
          <div class="dfg-feats">
            <div class="dfg-feat"><i class="fas fa-bolt"></i> Recebeu, usou!</div>
            <div class="dfg-feat"><i class="fas fa-shield-alt"></i> Compra 100% segura</div>
            <div class="dfg-feat"><i class="fas fa-headset"></i> Suporte especializado</div>
          </div>
          <a href="#produtos" class="dfg-ver-btn">Ver produtos <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>
      <!-- Slides 1..n: produtos em destaque -->
      <% (featured || []).slice(0, 5).forEach(function(p){ %>
      <% var out = (p.status === 'sold_out') || ((p.stock_count || 0) === 0); %>
      <div class="dfg-slide dfg-slide-prod">
        <a href="/logins/<%= p.slug %>" class="dfg-prod-slide">
          <div class="dfg-ps-img">
            <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"><% } %>
            <span class="dfg-auto" style="<%= out ? 'background:rgba(120,120,120,.94);' : '' %>"><%= out ? 'ESGOTADO' : 'ENTREGA AUTOMÁTICA' %></span>
          </div>
          <div class="dfg-ps-info">
            <div><span class="dfg-vendor"><%= typeof siteConfig !== 'undefined' && siteConfig.site_name ? siteConfig.site_name : 'Loja' %></span><span class="dfg-cat-link"><%= p.category || '' %></span></div>
            <div class="dfg-card-title"><%= p.name %></div>
            <div class="dfg-stars">★★★★★ <span class="cnt">(<%= p.sold_count || 0 %>)</span></div>
            <div class="dfg-price">R$ <%= Number(p.price).toFixed(2) %></div>
            <span class="dfg-buy" style="<%= out ? 'background:#6b6b6b;cursor:not-allowed;' : '' %>"><%= out ? 'Esgotado' : 'Comprar' %></span>
          </div>
        </a>
      </div>
      <% }) %>
    </div>
    <button class="dfg-car-arrow dfg-car-prev" aria-label="Anterior" onclick="dfgCarouselGo(-1)"><i class="fas fa-chevron-left"></i></button>
    <button class="dfg-car-arrow dfg-car-next" aria-label="Próximo" onclick="dfgCarouselGo(1)"><i class="fas fa-chevron-right"></i></button>
    <div class="dfg-car-dots" id="dfgCarDots"></div>
  </section>

  <script>
  (function(){
    var car = document.getElementById('dfgTopCarousel');
    if (!car) return;
    var slides = car.querySelectorAll('.dfg-slide');
    var dotsWrap = document.getElementById('dfgCarDots');
    if (slides.length <= 1) return;
    var idx = 0, timer = null;
    slides.forEach(function(s, i){
      var d = document.createElement('button');
      d.className = 'dfg-dot' + (i === 0 ? ' active' : '');
      d.setAttribute('aria-label', 'Slide ' + (i + 1));
      d.addEventListener('click', function(){ dfgShow(i); dfgRestart(); });
      dotsWrap.appendChild(d);
    });
    var dots = dotsWrap.querySelectorAll('.dfg-dot');
    function dfgShow(n){
      idx = (n + slides.length) % slides.length;
      slides.forEach(function(s, i){ s.classList.toggle('dfg-active', i === idx); });
      dots.forEach(function(d, i){ d.classList.toggle('active', i === idx); });
    }
    function dfgRestart(){ if (timer) clearInterval(timer); timer = setInterval(function(){ dfgShow(idx + 1); }, 4500); }
    window.dfgCarouselGo = function(step){ dfgShow(idx + step); dfgRestart(); };
    car.addEventListener('mouseenter', function(){ if (timer) clearInterval(timer); });
    car.addEventListener('mouseleave', dfgRestart);
    dfgShow(0); dfgRestart();
  })();
  </script>

  <!-- BANNER STREAMING + BUSCA -->
  <section class="dfg-stream">
    <div class="stxt">
      <div class="big">ND<b>+</b> Prime</div>
      <div class="small">Streaming premium: Filmes • Séries • Canais • e muito mais</div>
    </div>
    <form action="/logins" method="GET" class="dfg-search">
      <input type="hidden" name="category" value="<%= selectedCategory %>">
      <input type="hidden" name="sort" value="<%= sort %>">
      <input type="hidden" name="instock" value="<%= instock %>">
      <input type="text" name="search" placeholder="Buscar logins, contas, acessos..." value="<%= search %>">
      <button type="submit"><i class="fas fa-search"></i></button>
    </form>
  </section>

  <!-- FILTRO RÁPIDO (abaixo da pesquisa) -->
  <section class="dfg-filterbar">
    <form method="GET" action="/logins" class="dfg-filter-form">
      <input type="hidden" name="search" value="<%= search %>">
      <div class="ffield">
        <label>Categoria</label>
        <select name="category" onchange="this.form.submit()">
          <option value="">Todas</option>
          <% (categories || []).forEach(function(c){ %>
            <option value="<%= c.category %>" <%= selectedCategory === c.category ? 'selected' : '' %>><%= c.category %></option>
          <% }) %>
        </select>
      </div>
      <div class="ffield">
        <label>Ordenar por</label>
        <select name="sort" onchange="this.form.submit()">
          <option value="">Mais recentes</option>
          <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Menor preço</option>
          <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Maior preço</option>
          <option value="sold" <%= sort === 'sold' ? 'selected' : '' %>>Mais vendidos</option>
        </select>
      </div>
      <div class="ffield fcheck">
        <label class="fcheck-label">
          <input type="checkbox" name="instock" value="1" <%= instock ? 'checked' : '' %> onchange="this.form.submit()"> Com estoque
        </label>
      </div>
      <% if (search || selectedCategory || sort || instock) { %>
        <a href="/logins" class="fclear" title="Limpar filtros"><i class="fas fa-times"></i> Limpar</a>
      <% } %>
    </form>
  </section>

  <!-- HIGHLIGHTS -->
  <section class="dfg-highlights">
    <div class="dfg-hl"><i class="fas fa-truck-fast"></i><span>Entrega Automática</span></div>
    <div class="dfg-hl"><i class="fas fa-lock"></i><span>Compra Segura</span></div>
    <div class="dfg-hl"><i class="fas fa-clock"></i><span>Suporte 24h</span></div>
    <div class="dfg-hl"><i class="fas fa-tags"></i><span>Melhores Preços</span></div>
    <div class="dfg-hl"><i class="fas fa-smile"></i><span>Satisfação Garantida</span></div>
  </section>

  <!-- DESTAQUE -->
  <% if (destaque && destaque.length > 0) { %>
  <div class="dfg-section-title">
    <span class="dfg-badge-dest">DESTAQUE</span>
    <h2>Em evidência</h2>
  </div>
  <div class="dfg-grid">
    <% destaque.forEach(function(p){ %>
      <% var out = (p.status === 'sold_out') || ((p.stock_count || 0) === 0); %>
      <a href="/logins/<%= p.slug %>" class="dfg-card">
        <div class="dfg-card-img">
          <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"><% } %>
          <span class="dfg-auto" style="<%= out ? 'background:rgba(120,120,120,.94);' : '' %>"><%= out ? 'ESGOTADO' : 'ENTREGA AUTOMÁTICA' %></span>
        </div>
        <div class="dfg-card-body">
          <div><span class="dfg-vendor"><%= typeof siteConfig !== 'undefined' && siteConfig.site_name ? siteConfig.site_name : 'Loja' %></span><span class="dfg-cat-link"><%= p.category %></span></div>
          <div class="dfg-card-title"><%= p.name %></div>
          <div class="dfg-stars">★★★★★ <span class="cnt">(<%= p.sold_count || 0 %>)</span></div>
          <div class="dfg-price">R$ <%= Number(p.price).toFixed(2) %></div>
          <span class="dfg-buy" style="<%= out ? 'background:#6b6b6b;cursor:not-allowed;' : '' %>"><%= out ? 'Esgotado' : 'Comprar' %></span>
        </div>
      </a>
    <% }) %>
  </div>
  <% } %>

  <!-- PRODUTOS -->
  <div id="produtos"></div>
  <div class="dfg-section-title">
    <h2>Nossos produtos mais recentes</h2>
    <span class="dfg-badge-dest">ENTREGA AUTOMÁTICA</span>
  </div>

  <div class="dfg-result-count">
    <i class="fas fa-list"></i> <%= products.length %> produto(s)
    <% if (search) { %> <span>para “<%= search %>”</span><% } %>
    <% if (selectedCategory) { %> <span>em <%= selectedCategory %></span><% } %>
    <% if (sort) { %> <span>• <%= sort === 'price_asc' ? 'menor preço' : sort === 'price_desc' ? 'maior preço' : sort === 'sold' ? 'mais vendidos' : '' %></span><% } %>
    <% if (instock) { %> <span>• com estoque</span><% } %>
  </div>

  <% if (products.length === 0) { %>
    <div class="dfg-empty">Nenhum produto disponível no momento.</div>
  <% } else if (selectedCategory) { %>
    <div class="dfg-grid">
      <% products.forEach(function(p){ %>
        <% var out = (p.status === 'sold_out') || ((p.stock_count || 0) === 0); %>
        <a href="/logins/<%= p.slug %>" class="dfg-card">
          <div class="dfg-card-img">
            <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"><% } %>
            <span class="dfg-auto" style="<%= out ? 'background:rgba(120,120,120,.94);' : '' %>"><%= out ? 'ESGOTADO' : 'ENTREGA AUTOMÁTICA' %></span>
          </div>
          <div class="dfg-card-body">
            <div><span class="dfg-vendor"><%= typeof siteConfig !== 'undefined' && siteConfig.site_name ? siteConfig.site_name : 'Loja' %></span><span class="dfg-cat-link"><%= p.category %></span></div>
            <div class="dfg-card-title"><%= p.name %></div>
            <div class="dfg-stars">★★★★★ <span class="cnt">(<%= p.sold_count || 0 %>)</span></div>
            <div class="dfg-price">R$ <%= Number(p.price).toFixed(2) %></div>
            <span class="dfg-buy" style="<%= out ? 'background:#6b6b6b;cursor:not-allowed;' : '' %>"><%= out ? 'Esgotado' : 'Comprar' %></span>
          </div>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <% var grouped = {}; products.forEach(function(p){ (grouped[p.category] = grouped[p.category] || []).push(p); }); %>
    <% Object.keys(grouped).forEach(function(cat){ %>
      <h3 class="dfg-cat-title"><%= cat.toUpperCase() %></h3>
      <div class="dfg-grid">
        <% grouped[cat].forEach(function(p){ %>
          <% var out = (p.status === 'sold_out') || ((p.stock_count || 0) === 0); %>
          <a href="/logins/<%= p.slug %>" class="dfg-card">
            <div class="dfg-card-img">
              <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"><% } %>
              <span class="dfg-auto" style="<%= out ? 'background:rgba(120,120,120,.94);' : '' %>"><%= out ? 'ESGOTADO' : 'ENTREGA AUTOMÁTICA' %></span>
            </div>
            <div class="dfg-card-body">
              <div><span class="dfg-vendor"><%= typeof siteConfig !== 'undefined' && siteConfig.site_name ? siteConfig.site_name : 'Loja' %></span><span class="dfg-cat-link"><%= p.category %></span></div>
              <div class="dfg-card-title"><%= p.name %></div>
              <div class="dfg-stars">★★★★★ <span class="cnt">(<%= p.sold_count || 0 %>)</span></div>
              <div class="dfg-price">R$ <%= Number(p.price).toFixed(2) %></div>
              <span class="dfg-buy" style="<%= out ? 'background:#6b6b6b;cursor:not-allowed;' : '' %>"><%= out ? 'Esgotado' : 'Comprar' %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% }) %>
  <% } %>

</div>

<%- include('partials/footer') %>
