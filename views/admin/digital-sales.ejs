<%- include('../partials/admin-header') %>

<div class="dashboard-header">
  <h1><i class="fas fa-receipt"></i> Vendas de Logins</h1>
  <p>Acompanhe os pagamentos do Mercado Pago (aprovados, pendentes e não pagos)</p>
</div>

<div style="margin-bottom:20px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between;">
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <a href="/admin/digital/vendas" class="btn-small" style="<%= filter === 'all' ? 'background:var(--primary);color:#fff;' : '' %>">Todas</a>
    <a href="/admin/digital/vendas?filter=approved" class="btn-small" style="<%= filter === 'approved' ? 'background:var(--primary);color:#fff;' : '' %>">Pagas</a>
    <a href="/admin/digital/vendas?filter=pending" class="btn-small" style="<%= filter === 'pending' ? 'background:var(--primary);color:#fff;' : '' %>">Pendentes</a>
    <a href="/admin/digital/vendas?filter=unpaid" class="btn-small" style="<%= filter === 'unpaid' ? 'background:var(--primary);color:#fff;' : '' %>">Não pagas</a>
  </div>
</div>

<% if (error) { %>
<div class="alert alert-error" style="margin-bottom:16px;"><%= error %></div>
<% } %>

<% if (sales.length === 0) { %>
<div style="text-align:center;padding:60px;color:var(--hack-dim);">
  <i class="fas fa-receipt" style="font-size:48px;opacity:0.3;margin-bottom:16px;"></i>
  <p>Nenhuma venda encontrada</p>
</div>
<% } else { %>
<div class="notif-card-list">
  <% sales.forEach(function(s) { %>
  <%
    var st = s.payment_status || 'pending';
    var chip = st === 'approved' ? { t:'Pago', c:'#2e7d32', bg:'rgba(46,125,50,.16)' }
            : st === 'pending' ? { t:'Pendente', c:'#b8860b', bg:'rgba(255,212,0,.16)' }
            : st === 'rejected' || st === 'cancelled' ? { t:'Não pago', c:'#c62828', bg:'rgba(198,40,40,.16)' }
            : { t: st, c:'#8a93a0', bg:'rgba(120,130,140,.16)' };
  %>
  <div class="notif-card nt-<%= st === 'approved' ? 'payment' : (st === 'pending' ? 'info' : 'error') %>">
    <div class="notif-card-ic"><i class="fas fa-<%= st === 'approved' ? 'credit-card' : (st === 'pending' ? 'clock' : 'times-circle') %>"></i></div>
    <div class="notif-card-body">
      <div class="notif-card-msg"><%= s.product_name || 'Produto' %> <span style="color:var(--hack-dim);font-weight:400;">— R$ <%= Number(s.price).toFixed(2) %></span></div>
      <div class="notif-card-meta">
        <span class="notif-type-chip"><%= s.buyer_name %></span>
        <span style="font-size:11px;color:var(--hack-dim);"><%= s.buyer_email %></span>
        <span style="font-size:11px;padding:1px 8px;border-radius:6px;font-weight:700;color:<%= chip.c %>;background:<%= chip.bg %>;"><%= chip.t %></span>
        <span class="notif-card-time"><i class="far fa-clock"></i> <%= s.created_at %></span>
      </div>
    </div>
    <div class="notif-card-actions">
      <a href="/entrega/<%= s.delivery_code %>" class="btn-small" style="text-decoration:none;" title="Ver entrega"><i class="fas fa-eye"></i></a>
    </div>
  </div>
  <% }); %>
</div>

<% if (totalPages > 1) { %>
<div style="display:flex;gap:8px;justify-content:center;margin-top:20px;">
  <% for(var p=1;p<=totalPages;p++){ %>
    <a href="/admin/digital/vendas?filter=<%= filter %>&page=<%= p %>" class="btn-small" style="<%= p===page?'background:var(--primary);color:#fff;':'' %>min-width:36px;text-align:center;text-decoration:none;"><%= p %></a>
  <% } %>
</div>
<% } %>
<% } %>

<%- include('../partials/admin-footer') %>
