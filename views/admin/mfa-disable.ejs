<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin-hacker.css">
  <link rel="stylesheet" href="/fonts/fontawesome.min.css">
</head>
<body class="admin-page" style="padding:32px;">

<div class="admin-layout" style="max-width:520px;margin:0 auto;">
  <div class="form-card" style="padding:28px;">
    <span class="sys-tag">[ SYS::MFA.DISABLE ]</span>
    <h3 style="margin:0 0 4px;font-size:20px;color:var(--hack-text-hi);"><i class="fas fa-shield-halved" style="color:var(--hack-red);"></i> Desativar MFA</h3>
    <p style="color:var(--hack-dim);font-size:13px;margin:0 0 16px;">Desativar o MFA reduz a segurança da sua conta. Recomendamos manter ativado.</p>

    <div class="alert alert-warning" style="background:rgba(255,204,0,0.08);border:1px solid rgba(255,204,0,0.4);color:var(--hack-amber);padding:10px 16px;border-radius:8px;margin-bottom:16px;font-size:13px;">
      <i class="fas fa-exclamation-triangle"></i> Desativar MFA reduz a segurança da sua conta.
    </div>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error" style="margin-bottom:16px;"><%= error %></div><% } %>

    <form method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group" style="margin-bottom:14px;">
        <label>Senha atual</label>
        <input type="password" name="password" class="admin-input" required autocomplete="current-password" style="width:100%;">
      </div>

      <div class="form-group" style="margin-bottom:14px;">
        <label>Código MFA (do app autenticador)</label>
        <input type="text" name="totp" class="admin-input" placeholder="000000" maxlength="6" pattern="\d{6}" style="width:100%;text-align:center;letter-spacing:0.5rem;">
        <div style="font-size:12px;color:var(--hack-dim);margin-top:4px;">OU use um código de recuperação abaixo</div>
      </div>

      <div class="form-group" style="margin-bottom:18px;">
        <label>Código de recuperação</label>
        <input type="text" name="recovery_code" class="admin-input" placeholder="ABCD1234" maxlength="8" style="width:100%;">
      </div>

      <div style="display:flex;gap:8px;">
        <button type="submit" class="btn-danger" style="padding:10px 18px;border-radius:8px;cursor:pointer;font-size:13px;font-weight:700;flex:1;"><i class="fas fa-shield-halved"></i> Desativar MFA</button>
        <a href="/admin/dashboard" class="btn-secondary" style="padding:10px 18px;border-radius:8px;font-size:13px;text-align:center;"><i class="fas fa-arrow-left"></i> Cancelar</a>
      </div>
    </form>
  </div>
</div>

</body>
</html>
