<%- include('../partials/admin-header', { title: title, currentPath: '/admin/config' }) %>

<div class="admin-content">
  <div class="admin-header-bar">
    <h1><i class="fas fa-cog"></i> Configurações do Site</h1>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

  <form method="POST" action="/admin/config">
    <div class="form-card" style="margin-bottom:20px;">
      <h3><i class="fas fa-globe"></i> Informações Gerais</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Nome do Site</label>
          <input type="text" name="site_name" value="<%= config.site_name || 'SeraTecnologia' %>" class="admin-input" required>
        </div>
        <div class="form-group">
          <label>Email de Contato</label>
          <input type="email" name="site_email" value="<%= config.site_email || '' %>" class="admin-input">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group" style="flex:1;">
          <label>Descrição do Site</label>
          <input type="text" name="site_description" value="<%= config.site_description || '' %>" class="admin-input">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>WhatsApp Geral (com DDD, apenas números)</label>
          <input type="text" name="site_whatsapp" value="<%= config.site_whatsapp || '' %>" class="admin-input" placeholder="5511999999999">
        </div>
        <div class="form-group">
          <label>Chave PIX da Plataforma</label>
          <input type="text" name="pix_key_platform" value="<%= config.pix_key_platform || '' %>" class="admin-input">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Telefone</label>
          <input type="text" name="site_phone" value="<%= config.site_phone || '' %>" class="admin-input" placeholder="(11) 99999-9999">
        </div>
        <div class="form-group">
          <label>Endereço</label>
          <input type="text" name="site_address" value="<%= config.site_address || '' %>" class="admin-input" placeholder="Rua, número, cidade">
        </div>
      </div>
      <div class="form-group">
        <label>Texto do Rodapé</label>
        <input type="text" name="footer_text" value="<%= config.footer_text || '' %>" class="admin-input" placeholder="© 2026 SeraTecnologia. Todos os direitos reservados.">
      </div>
    </div>

    <div class="form-card" style="margin-bottom:20px;">
      <h3><i class="fas fa-image"></i> Logo e Favicon</h3>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div class="form-group">
          <label>Logo do Site</label>
          <% if (config.site_logo_url) { %>
            <div style="margin-bottom:8px;"><img src="<%= config.site_logo_url %>" alt="Logo" style="max-height:60px;background:#fff;padding:6px;border-radius:6px;border:1px solid #eee;"></div>
          <% } %>
          <form method="POST" action="/admin/config/upload-logo" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;">
            <input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="admin-input" style="flex:1;">
            <button type="submit" class="btn-primary" style="padding:8px 16px;font-size:13px;"><i class="fas fa-upload"></i> Enviar</button>
          </form>
          <% if (config.site_logo_url) { %>
            <form method="POST" action="/admin/config" style="margin-top:8px;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="site_logo_url" value="">
              <button type="submit" class="btn-secondary" style="padding:6px 12px;font-size:12px;"><i class="fas fa-times"></i> Remover logo</button>
            </form>
          <% } %>
        </div>
        <div class="form-group">
          <label>Favicon</label>
          <% if (config.site_favicon_url) { %>
            <div style="margin-bottom:8px;"><img src="<%= config.site_favicon_url %>" alt="Favicon" style="max-height:32px;background:#fff;padding:4px;border-radius:4px;border:1px solid #eee;"></div>
          <% } %>
          <form method="POST" action="/admin/config/upload-favicon" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;">
            <input type="file" name="favicon" accept="image/png,image/x-icon,image/webp" class="admin-input" style="flex:1;">
            <button type="submit" class="btn-primary" style="padding:8px 16px;font-size:13px;"><i class="fas fa-upload"></i> Enviar</button>
          </form>
          <% if (config.site_favicon_url) { %>
            <form method="POST" action="/admin/config" style="margin-top:8px;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="site_favicon_url" value="">
              <button type="submit" class="btn-secondary" style="padding:6px 12px;font-size:12px;"><i class="fas fa-times"></i> Remover favicon</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <div class="form-card" style="margin-bottom:20px;">
      <h3><i class="fas fa-share-alt"></i> Redes Sociais</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Instagram</label>
          <input type="text" name="social_instagram" value="<%= config.social_instagram || '' %>" class="admin-input" placeholder="https://instagram.com/suapagina">
        </div>
        <div class="form-group">
          <label>Facebook</label>
          <input type="text" name="social_facebook" value="<%= config.social_facebook || '' %>" class="admin-input" placeholder="https://facebook.com/suapagina">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>TikTok</label>
          <input type="text" name="social_tiktok" value="<%= config.social_tiktok || '' %>" class="admin-input" placeholder="https://tiktok.com/@suapagina">
        </div>
        <div class="form-group">
          <label>YouTube</label>
          <input type="text" name="social_youtube" value="<%= config.social_youtube || '' %>" class="admin-input" placeholder="https://youtube.com/@suapagina">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Discord</label>
          <input type="text" name="social_discord" value="<%= config.social_discord || '' %>" class="admin-input" placeholder="https://discord.gg/...">
        </div>
      </div>
    </div>

    <div class="form-card" style="margin-bottom:20px;">
      <h3><i class="fas fa-dollar-sign"></i> Financeiro</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Comissão Padrão (%)</label>
          <input type="number" name="commission_pct" value="<%= config.commission_pct || '10' %>" class="admin-input" min="0" max="100" step="0.1" required>
        </div>
        <div class="form-group">
          <label>Mercado Pago Access Token</label>
          <input type="password" name="mp_access_token" value="<%= config.mp_access_token || '' %>" class="admin-input" placeholder="Deixe vazio para desativar">
        </div>
        <div class="form-group">
          <label>Mercado Pago Public Key</label>
          <input type="text" name="mp_public_key" value="<%= config.mp_public_key || '' %>" class="admin-input" placeholder="APP_USR-...">
        </div>
      </div>
    </div>

    <div class="form-card" style="margin-bottom:20px;">
      <h3><i class="fas fa-code"></i> CSS / JS Personalizado</h3>
      <div class="form-row">
        <div class="form-group" style="flex:1;">
          <label>CSS Customizado</label>
          <textarea name="custom_css" class="admin-input" rows="4" style="font-family:monospace;font-size:13px;"><%= config.custom_css || '' %></textarea>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group" style="flex:1;">
          <label>JavaScript Customizado</label>
          <textarea name="custom_js" class="admin-input" rows="4" style="font-family:monospace;font-size:13px;"><%= config.custom_js || '' %></textarea>
        </div>
      </div>
    </div>

    <div class="form-card" style="margin-bottom:20px;">
      <h3><i class="fas fa-bolt"></i> Ofertas Relâmpago</h3>
      <div class="form-group">
        <label>Categoria de Ofertas Relâmpago</label>
        <select name="flash_category_id" class="admin-select">
          <option value="">Todas as categorias</option>
          <% if (typeof categories !== 'undefined') { categories.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= config.flash_category_id == c.id ? 'selected' : '' %>><%= c.icon || '📦' %> <%= c.name %></option>
          <% }); } %>
        </select>
        <span style="font-size:12px;color:#888;">Se definida, apenas produtos desta categoria poderão ser ofertas relâmpago</span>
      </div>
    </div>

    <div class="form-card" style="margin-bottom:20px;">
      <h3><i class="fas fa-newspaper"></i> Banner de Notícias (Destaques)</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Velocidade de rotação (segundos)</label>
          <input type="number" name="news_banner_speed" value="<%= config.news_banner_speed || '7' %>" class="admin-input" min="3" max="30" step="1">
          <span style="font-size:12px;color:#888;">Tempo que cada notícia fica visível no carrossel da home e da página de notícias</span>
        </div>
      </div>
    </div>

    <div class="form-card" style="margin-bottom:20px;">
      <h3><i class="fas fa-sliders-h"></i> Comportamento</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Status Padrão de Produtos Novos</label>
          <select name="default_product_status" class="admin-select">
            <option value="pending" <%= config.default_product_status === 'pending' ? 'selected' : '' %>>Pendente (precisa aprovação)</option>
            <option value="active" <%= config.default_product_status === 'active' ? 'selected' : '' %>>Ativo (direto)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Modo de Manutenção</label>
          <select name="maintenance_mode" class="admin-select">
            <option value="0" <%= config.maintenance_mode === '0' ? 'selected' : '' %>>Desativado</option>
            <option value="1" <%= config.maintenance_mode === '1' ? 'selected' : '' %>>Ativado (site fora do ar)</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Máx. Produtos por Vendedor</label>
          <input type="number" name="max_products_per_seller" value="<%= config.max_products_per_seller || '50' %>" class="admin-input" min="1" max="1000">
        </div>
      </div>
    </div>

    <div style="display:flex;gap:12px;margin-top:20px;">
      <button type="submit" class="btn-primary" style="padding:12px 32px;font-size:16px;">
        <i class="fas fa-save"></i> Salvar Configurações
      </button>
    </div>
  </form>

  <div class="form-card" style="margin-top:30px;">
    <h3><i class="fas fa-database"></i> Informações do Sistema</h3>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px;">
      <div style="padding:12px;background:var(--hack-bg-2);border:1px solid var(--hack-border);border-radius:8px;">
        <div style="font-size:12px;color:var(--hack-dim);">Ambiente</div>
        <div style="font-weight:600;color:var(--hack-text-hi);"><%= process.env.NODE_ENV || 'development' %></div>
      </div>
      <div style="padding:12px;background:var(--hack-bg-2);border:1px solid var(--hack-border);border-radius:8px;">
        <div style="font-size:12px;color:var(--hack-dim);">URL Base</div>
        <div style="font-weight:600;color:var(--hack-text-hi);"><%= process.env.BASE_URL || 'https://seratecnologia-1.onrender.com' %></div>
      </div>
      <div style="padding:12px;background:var(--hack-bg-2);border:1px solid var(--hack-border);border-radius:8px;">
        <div style="font-size:12px;color:var(--hack-dim);">Versão Node</div>
        <div style="font-weight:600;color:var(--hack-text-hi);"><%= process.version %></div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/admin-footer') %>