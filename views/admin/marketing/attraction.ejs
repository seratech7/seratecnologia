<%- include('../../partials/admin-header', { title: title, currentPath: '/admin/marketing/attraction' }) %>
<div class="admin-content">
  <div class="admin-header-bar">
    <h1><i class="fas fa-users"></i> Atração de Visitantes</h1>
    <span style="font-size:13px;color:#666;">5 funções automáticas para trazer visitantes</span>
    <a href="/admin/marketing" class="btn-secondary"><i class="fas fa-arrow-left"></i> Painel</a>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

  <!-- Stats -->
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px;">
    <div class="gstat-card"><div class="gstat-icon" style="background:#e8f5e9;color:#2e7d32;"><i class="fas fa-share-alt"></i></div><div class="gstat-value"><%= refStats.total %></div><div class="gstat-label">Visitas via indicação</div></div>
    <div class="gstat-card"><div class="gstat-icon" style="background:#fff3e0;color:#e65100;"><i class="fas fa-ticket-alt"></i></div><div class="gstat-value"><%= gaStats.total %></div><div class="gstat-label">Participantes do sorteio</div></div>
    <div class="gstat-card"><div class="gstat-icon" style="background:#fce4ec;color:#c62828;"><i class="fas fa-undo"></i></div><div class="gstat-value"><%= abandonedCount %></div><div class="gstat-label">Visitas recuperáveis</div></div>
    <div class="gstat-card"><div class="gstat-icon" style="background:#e3f2fd;color:#1565c0;"><i class="fas fa-bell"></i></div><div class="gstat-value"><%= pushCount %></div><div class="gstat-label">Assinantes Push</div></div>
  </div>

  <!-- Função cards -->
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:15px;margin-bottom:24px;">
    <div class="afun-card" style="border-top:4px solid #7c4dff;">
      <div style="font-size:28px;">🎁</div>
      <h4>1. Programa de Indicação</h4>
      <p style="font-size:12px;color:#666;margin:6px 0 10px;">Link /convite/CODIGO. Quem indica ganha 5%, quem chega ganha 10%.</p>
      <a href="<%= siteUrl %>/convite/<%= 'TESTE' %>" target="_blank" class="btn-secondary" style="display:block;text-align:center;font-size:12px;">Ver link exemplo</a>
    </div>
    <div class="afun-card" style="border-top:4px solid #ff6f00;">
      <div style="font-size:28px;">🍀</div>
      <h4>2. Sorteio Automático</h4>
      <p style="font-size:12px;color:#666;margin:6px 0 10px;">Popup captura nome + WhatsApp. <strong><%= gaStats.total %></strong> participantes.</p>
      <form method="POST" action="/admin/marketing/attraction/draw" onsubmit="return confirm('Sortear vencedor agora?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-primary" style="width:100%;background:#FF6F00;border-color:#FF6F00;font-size:13px;"><i class="fas fa-dice"></i> Sortear Vencedor</button>
      </form>
    </div>
    <div class="afun-card" style="border-top:4px solid #e91e63;">
      <div style="font-size:28px;">🛒</div>
      <h4>3. Recuperação de Visitas</h4>
      <p style="font-size:12px;color:#666;margin:6px 0 10px;">Quem volta ao mesmo produto 2+ vezes ganha cupom de 5% automaticamente.</p>
      <span class="badge badge-success" style="align-self:flex-start;">Automatizado</span>
    </div>
    <div class="afun-card" style="border-top:4px solid #1565c0;">
      <div style="font-size:28px;">🔔</div>
      <h4>4. Notificações Push</h4>
      <p style="font-size:12px;color:#666;margin:6px 0 10px;">PWA instalável + alertas de produtos novos.</p>
      <span class="badge badge-<%= pushConfigured ? 'success' : 'muted' %>"><%= pushConfigured ? 'Configurado' : 'Sem VAPID keys' %></span>
      <% if (!pushConfigured) { %>
      <form method="POST" action="/admin/marketing/attraction/vapid" style="margin-top:8px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-secondary" style="font-size:12px;"><i class="fas fa-key"></i> Gerar chaves VAPID</button>
      </form>
      <% } %>
    </div>
    <div class="afun-card" style="border-top:4px solid #00c853;">
      <div style="font-size:28px;">🏆</div>
      <h4>5. Prova Social</h4>
      <p style="font-size:12px;color:#666;margin:6px 0 10px;">Ticker de vendas ao vivo + top mais vendidos.</p>
      <span class="badge badge-success" style="align-self:flex-start;">Ativo</span>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
    <!-- Top indicadores -->
    <div class="card">
      <h3><i class="fas fa-trophy"></i> Top Indicadores</h3>
      <% if (refStats.top && refStats.top.length) { %>
      <table class="admin-table" style="font-size:13px;">
        <thead><tr><th>Código</th><th>Visitas</th><th>Convertidas</th></tr></thead>
        <tbody><% refStats.top.forEach(function(r) { %>
          <tr><td><%= r.referrer_code %></td><td><%= r.visits %></td><td><%= r.conv || 0 %></td></tr>
        <% }) %></tbody>
      </table>
      <% } else { %><p style="color:#999;font-size:13px;">Nenhuma indicação ainda. Compartilhe seu link /convite/CODIGO!</p><% } %>
    </div>
    <!-- Top vendidos -->
    <div class="card">
      <h3><i class="fas fa-fire"></i> Mais Vendidos (para divulgar)</h3>
      <% if (top.length) { %>
      <table class="admin-table" style="font-size:13px;">
        <thead><tr><th>Produto</th><th>Vendas</th><th>Receita</th></tr></thead>
        <tbody><% top.forEach(function(p) { %>
          <tr><td><%= p.name %></td><td><%= p.sales_count || 0 %></td><td>R$ <%= Number(p.revenue||0).toFixed(2).replace('.',',') %></td></tr>
        <% }) %></tbody>
      </table>
      <% } else { %><p style="color:#999;font-size:13px;">Sem vendas registradas.</p><% } %>
    </div>
  </div>
</div>

<style>
.gstat-card { background:var(--card-bg,#fff); border:1px solid var(--border,#ddd); border-radius:10px; padding:16px; display:flex; flex-direction:column; align-items:center; text-align:center; }
.gstat-icon { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:8px; }
.gstat-value { font-size:22px; font-weight:700; line-height:1.2; }
.gstat-label { font-size:11px; color:#666; margin-top:2px; }
.afun-card { background:var(--card-bg,#fff); border:1px solid var(--border,#ddd); border-radius:10px; padding:18px; display:flex; flex-direction:column; gap:4px; }
.btn-secondary { background:#f5f5f5; color:#333; padding:8px 16px; border-radius:6px; text-decoration:none; font-size:13px; border:1px solid #ddd; cursor:pointer; display:inline-block; }
.btn-secondary:hover { background:#e0e0e0; }
.btn-primary { padding:12px 16px; border:none; border-radius:8px; color:#fff; font-size:14px; cursor:pointer; font-weight:600; }
.badge-success { background:#e8f5e9; color:#2e7d32; padding:2px 8px; border-radius:10px; font-size:11px; }
.badge-muted { background:#f5f5f5; color:#999; padding:2px 8px; border-radius:10px; font-size:11px; }
</style>
<%- include('../../partials/admin-footer') %>