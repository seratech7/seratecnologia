<%- include('../../partials/admin-header', { title: title, currentPath: '/admin/marketing/automation' }) %>
<div class="admin-content">
  <div class="admin-header-bar">
    <h1><i class="fas fa-robot"></i> Automação</h1>
    <span style="font-size:13px;color:#666;">Divulgação no piloto automático</span>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

  <!-- Status cards -->
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px;">
    <div class="astat-card"><div class="astat-icon" style="background:#e3f2fd;color:#1565c0;"><i class="fas fa-search"></i></div><div class="astat-value"><%= indexNowConfigured ? 'Ativo' : 'Inativo' %></div><div class="astat-label">IndexNow (Bing/Seznam/Yandex)</div></div>
    <div class="astat-card"><div class="astat-icon" style="background:#fdecea;color:#c62828;"><i class="fab fa-google"></i></div><div class="astat-value"><%= googleConfigured ? 'Ativo' : 'Inativo' %></div><div class="astat-label">Google Indexing API</div></div>
    <div class="astat-card"><div class="astat-icon" style="background:#e8f5e9;color:#2e7d32;"><i class="fab fa-discord"></i></div><div class="astat-value"><%= discordConfigured ? 'Ativo' : 'Inativo' %></div><div class="astat-label">Discord Webhook</div></div>
    <div class="astat-card"><div class="astat-icon" style="background:<%= autoDisabled ? '#fdecea' : '#e8f5e9' %>;color:<%= autoDisabled ? '#c62828' : '#2e7d32' %>;"><i class="fas fa-clock"></i></div><div class="astat-value"><%= autoDisabled ? 'Desligado' : 'Ligado' %></div><div class="astat-label">Agendador</div></div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
    <!-- Ações manuais -->
    <div class="card">
      <h3><i class="fas fa-bolt"></i> Executar Agora</h3>
      <p style="font-size:13px;color:#666;">Disparo manual de cada automação</p>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <form method="POST" action="/admin/marketing/automation/index">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-primary" style="width:100%;background:#1565c0;border-color:#1565c0;"><i class="fas fa-search"></i> Indexar Produtos Novos (Google + IndexNow)</button>
        </form>
        <form method="POST" action="/admin/marketing/automation/promote">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-primary" style="width:100%;background:#FF6F00;border-color:#FF6F00;"><i class="fas fa-rocket"></i> Executar Promoção Completa Agora</button>
        </form>
      </div>
    </div>

    <!-- Configurações -->
    <div class="card">
      <h3><i class="fas fa-cog"></i> Configuração (.env)</h3>
      <p style="font-size:13px;color:#666;">Adicione estas variáveis no arquivo <code style="background:#f5f5f5;padding:2px 6px;border-radius:4px;">.env</code>:</p>
      <div style="font-size:12px;background:#fafafa;border:1px solid #eee;border-radius:8px;padding:12px;font-family:monospace;line-height:1.8;white-space:pre-wrap;">
AUTO_PING_INTERVAL=6          # horas entre indexações
AUTO_PROMOTE_HOUR=9           # hora da promoção diária
AUTO_ANN_HOUR=18              # hora do anúncio de novidades
AUTO_DISABLED=false           # true para desligar
INDEXNOW_KEY=seu_id           # gerar em indexnow.org
GOOGLE_INDEXING_KEY={JSON}    # service account
DISCORD_WEBHOOK_URL=https://...
      </div>
    </div>
  </div>

  <!-- Último estado -->
  <div class="card">
    <h3><i class="fas fa-history"></i> Últimas Execuções Automáticas</h3>
    <table class="admin-table" style="font-size:13px;">
      <thead><tr><th>Evento</th><th>Data/Hora</th></tr></thead>
      <tbody>
        <tr><td>Última indexação</td><td><%= state.lastIndex ? new Date(state.lastIndex).toLocaleString() : '—' %></td></tr>
        <tr><td>Última promoção</td><td><%= state.lastPromote ? new Date(state.lastPromote).toLocaleString() : '—' %></td></tr>
        <tr><td>Último produto indexado (ID)</td><td><%= state.lastIndexedId || '—' %></td></tr>
      </tbody>
    </table>
  </div>

  <div class="card" style="margin-top:20px;background:#fff8e1;border-color:#ffe082;">
    <h3><i class="fas fa-lightbulb"></i> Dica de indexação instantânea</h3>
    <p style="font-size:13px;color:#666;margin:0;">
      Para o IndexNow funcionar, o arquivo <code style="background:#fff;padding:2px 6px;border-radius:4px;"><%= baseUrl %>/<%= indexNowKeyFile %></code> deve estar acessível publicamente com o conteúdo da sua chave. A rota já foi adicionada no servidor.
    </p>
  </div>
</div>

<style>
.astat-card { background:var(--card-bg,#fff); border:1px solid var(--border,#ddd); border-radius:10px; padding:16px; display:flex; flex-direction:column; align-items:center; text-align:center; }
.astat-icon { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:8px; }
.astat-value { font-size:18px; font-weight:700; line-height:1.2; }
.astat-label { font-size:11px; color:#666; margin-top:2px; text-align:center; }
.btn-primary { padding:12px 16px; border:none; border-radius:8px; color:#fff; font-size:14px; cursor:pointer; font-weight:600; }
</style>
<%- include('../../partials/admin-footer') %>