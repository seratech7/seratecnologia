<%- include('../partials/admin-header') %>

<div class="admin-content">
  <span class="sys-tag">[ SYS::DASHBOARD ]</span>
  <div class="page-header">
    <div>
      <h1><i class="fas fa-microchip"></i> Dashboard</h1>
      <p>Bem-vindo, <%= session.adminName %>!</p>
    </div>
    <div class="header-actions">
      <span class="header-date"><%= new Date().toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></span>
    </div>
  </div>

  <!-- Alertas -->
  <% if (stats.pending > 0 || stats.pendingSales > 0 || (stats.pendingPayouts||0) > 0 || (stats.lowStockCount||0) > 0) { %>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
      <% if (stats.pending > 0) { %><a href="/admin/products?filter=pending" class="btn-primary" style="background:#ff9800;font-size:13px;padding:6px 14px;"><i class="fas fa-clock"></i> <%= stats.pending %> produto(s) pendente(s)</a><% } %>
      <% if (stats.pendingSales > 0) { %><a href="/admin/sales?filter=pending" class="btn-primary" style="background:#ff9800;font-size:13px;padding:6px 14px;"><i class="fas fa-shopping-bag"></i> <%= stats.pendingSales %> venda(s) pendente(s)</a><% } %>
      <% if ((stats.pendingPayouts||0) > 0) { %><a href="/admin/financeiro" class="btn-primary" style="background:#e65100;font-size:13px;padding:6px 14px;"><i class="fas fa-money-bill"></i> <%= stats.pendingPayouts %> saque(s) pendente(s) — <%= new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(stats.pendingPayoutsTotal) %></a><% } %>
      <% if ((stats.lowStockCount||0) > 0) { %><a href="/admin/products?filter=active" class="btn-primary" style="background:#c62828;font-size:13px;padding:6px 14px;"><i class="fas fa-exclamation-triangle"></i> <%= stats.lowStockCount %> produto(s) com estoque baixo</a><% } %>
    </div>
  <% } %>

  <div class="quick-actions">
    <a href="/admin/ai-audit" class="quick-action-card" style="background:linear-gradient(135deg,#9b59b6,#6c3483);border:2px solid #d7a1f9;">
      <i class="fas fa-robot"></i>
      <span>Auditoria IA</span>
    </a>
    <a href="/admin/products/new" class="quick-action-card">
      <i class="fas fa-plus-circle"></i>
      <span>Novo Produto</span>
    </a>
    <a href="/admin/sales" class="quick-action-card">
      <i class="fas fa-shopping-bag"></i>
      <span>Vendas</span>
    </a>
    <a href="/admin/marketing/autopromo" class="quick-action-card">
      <i class="fas fa-bolt"></i>
      <span>Auto-Promo</span>
    </a>
    <a href="/admin/financeiro" class="quick-action-card">
      <i class="fas fa-coins"></i>
      <span>Financeiro</span>
    </a>
    <a href="/admin/seguranca" class="quick-action-card">
      <i class="fas fa-shield-alt"></i>
      <span>Segurança</span>
    </a>
    <a href="/admin/analytics" class="quick-action-card">
      <i class="fas fa-chart-line"></i>
      <span>Analytics</span>
    </a>
    <a href="/admin/sessions" class="quick-action-card">
      <i class="fas fa-devices"></i>
      <span>Sessões</span>
    </a>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon products-icon"><i class="fas fa-box"></i></div>
      <div class="stat-info">
        <span class="stat-number"><%= stats.total %></span>
        <span class="stat-label">Total de Produtos</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon active-icon"><i class="fas fa-check-circle"></i></div>
      <div class="stat-info">
        <span class="stat-number"><%= stats.active %></span>
        <span class="stat-label">Produtos Ativos</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
        <i class="fas fa-clock"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= stats.pending %></span>
        <span class="stat-label">Pendentes</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon categories-icon"><i class="fas fa-store-alt"></i></div>
      <div class="stat-info">
        <span class="stat-number"><%= stats.sellers %></span>
        <span class="stat-label">Vendedores</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #ffd700, #ffaa00);">
        <i class="fas fa-star"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= stats.featured %></span>
        <span class="stat-label">Em Destaque</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #00c853, #00a844);">
        <i class="fas fa-shopping-bag"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= stats.totalSales %></span>
        <span class="stat-label">Vendas Realizadas</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #9c27b0, #7b1fa2);">
        <i class="fas fa-dollar-sign"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(stats.revenue) %></span>
        <span class="stat-label">Receita Total</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #ff9800, #f57c00);">
        <i class="fas fa-clock"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= stats.pendingSales %></span>
        <span class="stat-label">Vendas Pendentes</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #00838f, #00695c);">
        <i class="fas fa-truck"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= statusBreakdown.shipped %></span>
        <span class="stat-label">Enviadas</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #43a047, #2e7d32);">
        <i class="fas fa-box-open"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= statusBreakdown.delivered %></span>
        <span class="stat-label">Entregues</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #e53935, #b71c1c);">
        <i class="fas fa-times-circle"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= statusBreakdown.cancelled %></span>
        <span class="stat-label">Canceladas</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #8e24aa, #6a1b9a);">
        <i class="fas fa-star-half-alt"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= pendingReviews %></span>
        <span class="stat-label">Avaliações Pendentes</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #5e35b1, #4527a0);">
        <i class="fas fa-percent"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(stats.totalCommission) %></span>
        <span class="stat-label">Comissão Acumulada</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #00695c, #004d40);">
        <i class="fas fa-wallet"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(stats.sellerWalletTotal) %></span>
        <span class="stat-label">Saldo Total dos Vendedores</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #c62828, #b71c1c);">
        <i class="fas fa-receipt"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(stats.avgOrder) %></span>
        <span class="stat-label">Ticket Médio</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #37474f, #263238);">
        <i class="fas fa-user-plus"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= stats.newSellers %></span>
        <span class="stat-label">Novos Vendedores (30d)</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #2196f3, #1565c0);">
        <i class="fas fa-eye"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= stats.totalViews %></span>
        <span class="stat-label">Total de Visualizações</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #00bcd4, #00838f);">
        <i class="fas fa-chart-bar"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= stats.todayViews %></span>
        <span class="stat-label">Views Hoje</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #7c4dff, #536dfe);">
        <i class="fas fa-percentage"></i>
      </div>
      <div class="stat-info">
        <span class="stat-number"><%= typeof conversionRate !== 'undefined' ? conversionRate + '%' : '—' %></span>
        <span class="stat-label">Conversão (vendas/views)</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background: linear-gradient(135deg, #26a69a, #00897b);">
        <i class="fas fa-trend-up"></i>
      </div>
      <div class="stat-info">
        <% var trendPct = (revenueBefore > 0) ? Math.round(((revenueNow - revenueBefore) / revenueBefore) * 100) : 0; %>
        <span class="stat-number" style="color:<%= trendPct >= 0 ? 'var(--hack-green)' : 'var(--hack-red)' %>;"><%= trendPct >= 0 ? '▲' : '▼' %> <%= Math.abs(trendPct) %>%</span>
        <span class="stat-label">Variação 30 dias</span>
      </div>
    </div>
  </div>

  <!-- Painel: Logins Digitais (Mercado Pago) -->
  <div class="admin-section" style="grid-column:1/-1;margin-top:20px;">
    <div class="section-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
      <h2><i class="fas fa-receipt" style="color:#00c853;"></i> Logins Digitais — Pagamentos (Mercado Pago)</h2>
      <a href="/admin/digital/vendas" class="btn-small" style="text-decoration:none;"><i class="fas fa-eye"></i> Ver todas as vendas</a>
    </div>
    <div style="display:flex;gap:16px;flex-wrap:wrap;">
      <div style="flex:1;min-width:170px;background:var(--card-bg);border:1px solid var(--hack-border);border-radius:12px;padding:18px;display:flex;align-items:center;gap:14px;">
        <div style="width:44px;height:44px;border-radius:10px;background:rgba(46,125,50,.16);display:flex;align-items:center;justify-content:center;"><i class="fas fa-check-circle" style="color:#2e7d32;font-size:20px;"></i></div>
        <div><div style="font-size:24px;font-weight:700;color:#2e7d32;"><%= digitalStats.approved %></div><div style="font-size:12px;color:var(--hack-dim);">Aprovados</div></div>
      </div>
      <div style="flex:1;min-width:170px;background:var(--card-bg);border:1px solid var(--hack-border);border-radius:12px;padding:18px;display:flex;align-items:center;gap:14px;">
        <div style="width:44px;height:44px;border-radius:10px;background:rgba(255,212,0,.16);display:flex;align-items:center;justify-content:center;"><i class="fas fa-clock" style="color:#b8860b;font-size:20px;"></i></div>
        <div><div style="font-size:24px;font-weight:700;color:#b8860b;"><%= digitalStats.pending %></div><div style="font-size:12px;color:var(--hack-dim);">Em análise</div></div>
      </div>
      <div style="flex:1;min-width:170px;background:var(--card-bg);border:1px solid var(--hack-border);border-radius:12px;padding:18px;display:flex;align-items:center;gap:14px;">
        <div style="width:44px;height:44px;border-radius:10px;background:rgba(198,40,40,.16);display:flex;align-items:center;justify-content:center;"><i class="fas fa-times-circle" style="color:#c62828;font-size:20px;"></i></div>
        <div><div style="font-size:24px;font-weight:700;color:#c62828;"><%= digitalStats.rejected %></div><div style="font-size:12px;color:var(--hack-dim);">Rejeitados</div></div>
      </div>
    </div>
    <% if (recentDigital && recentDigital.length) { %>
    <div style="margin-top:14px;background:var(--card-bg);border:1px solid var(--hack-border);border-radius:12px;padding:12px 14px;">
      <div style="font-size:12px;color:var(--hack-dim);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px;">Últimos logins vendidos</div>
      <% recentDigital.forEach(function(d) { %>
        <%
          var st = d.payment_status || 'pending';
          var chip = st === 'approved' ? { t:'Pago', c:'#2e7d32', bg:'rgba(46,125,50,.16)' }
                  : st === 'pending' ? { t:'Em análise', c:'#b8860b', bg:'rgba(255,212,0,.16)' }
                  : { t:'Rejeitado', c:'#c62828', bg:'rgba(198,40,40,.16)' };
        %>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:7px 0;border-top:1px solid var(--hack-border);font-size:13px;">
          <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= d.product_name || 'Produto' %> <span style="color:var(--hack-dim);">— R$ <%= Number(d.price).toFixed(2) %></span></span>
          <span style="font-size:11px;padding:2px 10px;border-radius:6px;font-weight:700;color:<%= chip.c %>;background:<%= chip.bg %>;white-space:nowrap;"><%= chip.t %></span>
        </div>
      <% }); %>
    </div>
    <% } %>
  </div>

  <% if (goalProgress) { %>
  <div class="admin-section" style="grid-column:1/-1;">
    <div class="section-header">
      <h2><i class="fas fa-bullseye" style="color:#ffd700;"></i> Meta Ativa: <%= goalProgress.title %></h2>
      <span style="font-size:13px;color:var(--hack-dim);"><%= goalProgress.start_date %> até <%= goalProgress.end_date %></span>
    </div>
    <div style="background:linear-gradient(145deg,var(--hack-panel),var(--hack-panel-2));border:1px solid var(--hack-border);border-radius:10px;padding:16px;">
      <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:8px;">
        <span style="font-weight:700;color:<%= goalProgress.achieved ? 'var(--hack-green)' : 'var(--hack-text-hi)' %>;">
          <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(goalProgress.progress) %> / <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(goalProgress.target) %>
          <% if (goalProgress.achieved) { %> <span style="color:var(--hack-green);"><i class="fas fa-check-circle"></i> Meta atingida!</span><% } %>
        </span>
        <span style="font-weight:700;color:var(--hack-cyan);"><%= goalProgress.pct %>%</span>
      </div>
      <div style="height:14px;background:var(--hack-bg-2);border:1px solid var(--hack-border);border-radius:7px;overflow:hidden;">
        <div style="height:100%;width:<%= goalProgress.pct %>%;background:linear-gradient(90deg,#ffd700,#ff9800);transition:width 0.5s;"></div>
      </div>
    </div>
  </div>
  <% } %>

  <div class="dashboard-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px;">
    <!-- Sales Chart -->
    <div class="admin-section" style="grid-column:1/-1;">
      <div class="section-header">
        <h2><i class="fas fa-chart-bar"></i> Vendas (últimos 30 dias)</h2>
      </div>
      <% if (chartSales && chartSales.length > 0) { %>
      <% var maxVal = Math.max(...chartSales.map(function(d){return d.sales}), 1); %>
      <% var maxRev = 1; if (chartRevenue) chartRevenue.forEach(function(d){ maxRev = Math.max(maxRev, d.revenue); }); %>
      <div style="display:flex;align-items:end;gap:2px;height:100px;padding-top:12px;">
        <% chartSales.forEach(function(d) { %>
          <% var rev = 0; if (chartRevenue) { var m = chartRevenue.find(function(x){return x.day === d.day;}); if (m) rev = m.revenue; } %>
          <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:1px;height:100px;justify-content:flex-end;">
            <div style="width:100%;background:linear-gradient(180deg,#00e5ff,#0077cc);border-radius:2px 2px 0 0;height:<%= Math.max(2, (d.sales / maxVal) * 78) %>px;" title="<%= d.sales %> vendas em <%= d.day %>"></div>
            <div style="width:100%;background:linear-gradient(180deg,#00c853,#009688);border-radius:2px 2px 0 0;height:<%= Math.max(1, (rev / maxRev) * 18) %>px;" title="<%= new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(rev) %> receita em <%= d.day %>"></div>
          </div>
        <% }) %>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--hack-dim);margin-top:4px;">
        <span><%= chartSales[0] ? chartSales[0].day : '' %></span>
        <span><%= chartSales[chartSales.length-1] ? chartSales[chartSales.length-1].day : '' %></span>
      </div>
      <div style="display:flex;gap:16px;margin-top:8px;font-size:12px;color:var(--hack-dim);">
        <span><span style="display:inline-block;width:12px;height:12px;background:#00e5ff;border-radius:2px;vertical-align:middle;"></span> Vendas (qtd)</span>
        <span><span style="display:inline-block;width:12px;height:12px;background:#00c853;border-radius:2px;vertical-align:middle;"></span> Receita (R$)</span>
      </div>
      <% } else { %><p style="color:var(--hack-dim);text-align:center;padding:16px;font-size:13px;">Nenhuma venda no período</p><% } %>
    </div>

    <!-- Recent Sales -->
    <div class="admin-section">
      <div class="section-header">
        <h2><i class="fas fa-shopping-bag"></i> Últimas Vendas</h2>
        <a href="/admin/sales" class="btn-small">Ver todas</a>
      </div>
      <% if (recentSales && recentSales.length > 0) { %>
        <% recentSales.forEach(function(s) { %>
          <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--hack-border);">
            <div style="width:8px;height:8px;border-radius:50%;background:<%= s.status === 'delivered' ? 'var(--hack-green)' : s.status === 'shipped' ? 'var(--hack-cyan)' : s.status === 'approved' ? 'var(--hack-amber)' : s.status === 'pending' ? 'var(--hack-red)' : 'var(--hack-dim)' %>;flex-shrink:0;"></div>
            <div style="flex:1;min-width:0;">
              <div style="font-size:13px;font-weight:600;"><%= s.product_name %></div>
              <div style="font-size:11px;color:var(--hack-dim);"><%= s.buyer_name %> • <%= s.seller_name || '-' %></div>
            </div>
            <div style="text-align:right;flex-shrink:0;">
              <div style="font-size:13px;font-weight:700;color:var(--hack-cyan);"><%= new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(s.product_price) %></div>
              <div style="font-size:10px;color:var(--hack-dim);"><%= new Date(s.created_at).toLocaleDateString('pt-BR') %></div>
            </div>
          </div>
        <% }) %>
      <% } else { %><p style="color:var(--hack-dim);text-align:center;padding:16px;font-size:13px;">Nenhuma venda ainda</p><% } %>
    </div>

    <!-- Top Sellers / Quick Info -->
    <div class="admin-section">
      <div class="section-header">
        <h2><i class="fas fa-trophy"></i> Top Vendedores</h2>
        <a href="/admin/sellers" class="btn-small">Ver todos</a>
      </div>
      <% if (topSellers && topSellers.length > 0) { %>
        <% topSellers.forEach(function(s) { %>
          <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--hack-border);">
            <% if (s.avatar) { %><img src="<%= s.avatar %>" style="width:36px;height:36px;border-radius:50%;object-fit:cover;border:1px solid var(--hack-border);"><% } else { %><div style="width:36px;height:36px;border-radius:50%;background:var(--hack-bg-2);border:1px solid var(--hack-border);display:flex;align-items:center;justify-content:center;color:var(--hack-cyan);font-size:14px;font-weight:700;"><%= (s.name||'?')[0] %></div><% } %>
            <div style="flex:1;min-width:0;"><div style="font-size:13px;font-weight:600;"><%= s.name %></div><div style="font-size:11px;color:var(--hack-dim);"><%= s.sales_count %> vendas</div></div>
            <div style="font-size:13px;font-weight:700;color:var(--hack-green);"><%= new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(s.revenue) %></div>
          </div>
        <% }) %>
      <% } else { %><p style="color:var(--hack-dim);text-align:center;padding:16px;font-size:13px;">Nenhum vendedor ativo</p><% } %>
    </div>

    <!-- Featured Products -->
    <% if (featuredProducts.length > 0) { %>
    <div class="admin-section" style="grid-column:1/-1;">
      <div class="section-header">
        <h2><i class="fas fa-star" style="color:#ffd700;"></i> Produtos em Destaque</h2>
        <a href="/admin/products?filter=featured" class="btn-small">Gerenciar</a>
      </div>
      <div class="featured-carousel">
        <div class="products-grid featured-admin-grid">
          <% featuredProducts.forEach(p => { %>
            <a href="/admin/products/edit/<%= p.id %>" class="product-card featured-admin-card">
              <div class="product-image">
                <% if (p.image) { %><img src="<%= p.image %>" alt=""><% } else { %><div class="no-image"><i class="fas fa-image"></i></div><% } %>
                <span class="featured-badge"><i class="fas fa-star"></i> Destaque</span>
              </div>
              <div class="product-info">
                <h3 class="product-name"><%= p.name %></h3>
                <p class="product-price"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(p.price) %></p>
                <div class="product-meta">
                  <span><%= p.category_name || '-' %></span>
                  <% if (p.seller_name) { %><span class="product-category"><%= p.seller_name %></span><% } %>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Recent Products -->
    <div class="admin-section" style="grid-column:1/-1;">
      <div class="section-header">
        <h2><i class="fas fa-clock"></i> Produtos Recentes</h2>
        <a href="/admin/products" class="btn-small">Ver todos</a>
      </div>
      <div class="table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Preço</th>
              <th>Categoria</th>
              <th>Status</th>
              <th>Data</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentProducts.length === 0) { %>
              <tr><td colspan="6" class="empty-row">Nenhum produto cadastrado</td></tr>
            <% } else { %>
              <% recentProducts.forEach(p => { %>
                <tr>
                  <td class="product-cell">
                    <div class="product-cell-info">
                      <% if (p.image) { %><img src="<%= p.image %>" alt="" class="thumb"><% } %>
                      <span><%= p.name %><% if (p.featured) { %> <span class="featured-tag"><i class="fas fa-star"></i></span><% } %></span>
                    </div>
                  </td>
                  <td class="price-cell"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(p.price) %></td>
                  <td><%= p.category_name || '-' %></td>
                  <td>
                    <% if (p.status === 'active') { %><span class="status-badge active">Ativo</span>
                    <% } else if (p.status === 'pending') { %><span class="status-badge pending">Pendente</span>
                    <% } else if (p.status === 'rejected') { %><span class="status-badge" style="background:rgba(255,56,96,0.10);color:var(--hack-red);">Rejeitado</span>
                    <% } else { %><span class="status-badge inactive">Inativo</span><% } %>
                  </td>
                  <td><%= new Date(p.created_at).toLocaleDateString('pt-BR') %></td>
                  <td>
                    <a href="/admin/products/edit/<%= p.id %>" class="btn-icon" title="Editar"><i class="fas fa-edit"></i></a>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/admin-footer') %>
