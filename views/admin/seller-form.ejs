<%- include('../partials/admin-header') %>

<div class="admin-content">
  <div class="page-header">
    <h1><i class="fas fa-edit"></i> Editar Vendedor</h1>
    <a href="/admin/sellers/<%= seller.id %>" class="btn-small"><i class="fas fa-arrow-left"></i> Voltar</a>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="form-card">
    <form action="/admin/sellers/edit/<%= seller.id %>" method="POST" class="admin-form">
      <div class="form-section-title"><i class="fas fa-user"></i> Dados Básicos</div>
      <div class="form-row">
        <div class="form-group">
          <label>Nome</label>
          <input type="text" name="name" value="<%= seller.name %>" required>
        </div>
        <div class="form-group">
          <label>Email (usado para login)</label>
          <input type="email" name="email" value="<%= seller.email %>" required>
        </div>
      </div>

      <div class="form-section-title"><i class="fas fa-phone"></i> Contato</div>
      <div class="form-row">
        <div class="form-group">
          <label>Telefone</label>
          <input type="text" name="phone" value="<%= seller.phone || '' %>">
        </div>
        <div class="form-group">
          <label>WhatsApp (com DDD)</label>
          <input type="text" name="whatsapp" value="<%= seller.whatsapp || '' %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Website</label>
          <input type="text" name="website" value="<%= seller.website || '' %>">
        </div>
        <div class="form-group">
          <label>Bio / Descrição</label>
          <textarea name="bio" rows="3"><%= seller.bio || '' %></textarea>
        </div>
      </div>

      <div class="form-section-title"><i class="fas fa-lock"></i> Senha</div>
      <div class="form-group">
        <label>Nova Senha (deixe em branco para manter a atual)</label>
        <input type="password" name="password" placeholder="Mínimo 6 caracteres">
      </div>

      <div class="form-section-title"><i class="fas fa-dollar-sign"></i> Financeiro</div>
      <div class="form-row">
        <div class="form-group">
          <label>% Comissão (deixe vazio para usar padrão da plataforma)</label>
          <input type="number" name="commission_pct" step="0.01" min="0" max="100" value="<%= seller.commission_pct !== null && seller.commission_pct !== undefined ? seller.commission_pct : '' %>">
        </div>
        <div class="form-group">
          <label>Chave PIX</label>
          <input type="text" name="pix_key" value="<%= seller.pix_key || '' %>">
        </div>
      </div>
      <div class="form-group">
        <label>Informações Bancárias (dados para saque)</label>
        <textarea name="bank_info" rows="3"><%= seller.bank_info || '' %></textarea>
      </div>

      <div class="form-section-title"><i class="fas fa-chart-bar"></i> Controle</div>
      <div class="form-row">
        <div class="form-group">
          <label>Vendas (manuais / absoluto)</label>
          <input type="number" name="sales_count" value="<%= seller.sales_count || 0 %>" min="0">
        </div>
        <div class="form-group">
          <label>Status</label>
          <select name="status">
            <option value="active" <%= seller.status === 'active' ? 'selected' : '' %>>Ativo</option>
            <option value="inactive" <%= seller.status === 'inactive' ? 'selected' : '' %>>Inativo</option>
          </select>
        </div>
      </div>

      <div class="form-actions">
        <a href="/admin/sellers/<%= seller.id %>" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Salvar Alterações</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/admin-footer') %>
