<%- include('../partials/admin-header') %>

<div class="page-header">
  <h1><i class="fas fa-<%= item ? 'edit' : 'plus-circle' %>"></i> <%= item ? 'Editar Serviço Digital' : 'Novo Serviço Digital' %></h1>
  <a href="/admin/digital" class="btn-secondary"><i class="fas fa-arrow-left"></i> Voltar</a>
</div>

<% if (error) { %><div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

<div class="form-card">
  <h3><i class="fas fa-key"></i> Dados do Serviço</h3>
  <form method="POST" action="/admin/digital/<%= item ? 'edit/' + item.id : 'new' %>" class="admin-form">
    <div class="form-group">
      <label>Nome *</label>
      <input type="text" name="name" value="<%= item ? item.name : '' %>" placeholder="Ex: Spotify Premium" maxlength="200" required>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Slug (URL amigável)</label>
        <input type="text" name="slug" value="<%= item ? item.slug : '' %>" placeholder="deixe em branco para gerar automaticamente">
      </div>
      <div class="form-group">
        <label>Categoria</label>
        <input type="text" name="category" value="<%= item ? item.category : 'outros' %>" placeholder="Ex: streaming" maxlength="100">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Preço (R$)</label>
        <input type="number" step="0.01" min="0" name="price" value="<%= item ? item.price : 0 %>">
      </div>
      <div class="form-group">
        <label>Badge (texto pequeno, ex: MAIS VENDIDO)</label>
        <input type="text" name="badge" value="<%= item ? item.badge : '' %>" maxlength="100" placeholder="Opcional">
      </div>
    </div>

    <div class="form-group">
      <label>Imagem (URL ou caminho, ex: /uploads/digital/spotify.png)</label>
      <input type="text" name="image" value="<%= item ? item.image : '' %>" placeholder="URL da imagem">
      <% if (item && item.image) { %><div class="form-hint" style="margin-top:6px;"><img src="<%= item.image %>" alt="" style="max-height:60px;"></div><% } %>
    </div>

    <div class="form-group">
      <label>Descrição</label>
      <textarea name="description" rows="4" placeholder="Descrição do serviço"><%= item ? item.description : '' %></textarea>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Status</label>
        <select name="status">
          <option value="active" <%= item && item.status === 'active' ? 'selected' : '' %>>Ativo</option>
          <option value="inactive" <%= item && item.status === 'inactive' ? 'selected' : '' %>>Inativo</option>
        </select>
      </div>
      <div class="form-group">
        <label class="checkbox" style="margin-top:24px;">
          <input type="checkbox" name="featured" value="1" <%= item && item.featured == 1 ? 'checked' : '' %>> Destacar no carrossel do topo (/logins)
        </label>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Salvar</button>
      <a href="/admin/digital" class="btn-secondary">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/admin-footer') %>
