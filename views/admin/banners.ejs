<%- include('../partials/admin-header') %>
<div class="admin-content">
  <div class="page-header">
    <h1><i class="fas fa-images"></i> Banners</h1>
    <a href="/admin/banners/novo" class="btn-primary"><i class="fas fa-plus"></i> Novo Banner</a>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width:60px;">Ordem</th>
          <th>Imagem</th>
          <th>Título</th>
          <th>Posição</th>
          <th>Agendamento</th>
          <th>Cliques</th>
          <th>Status</th>
          <th style="width:120px;">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (banners.length === 0) { %>
          <tr><td colspan="8" class="empty-row">Nenhum banner cadastrado</td></tr>
        <% } %>
        <% banners.forEach(function(b) { %>
          <tr class="<%= b.active ? '' : 'row-inactive' %>">
            <td style="text-align:center;"><strong><%= b.sort_order %></strong></td>
            <td>
              <img src="<%= b.image %>" style="width:100px;height:50px;object-fit:cover;border-radius:4px;display:block;">
              <% if (b.mobile_image) { %><span style="font-size:10px;color:#999;">📱 c/ mobile</span><% } %>
            </td>
            <td>
              <strong><%= b.title || '-' %></strong>
              <% if (b.subtitle) { %><br><span style="font-size:12px;color:#999;"><%= b.subtitle %></span><% } %>
              <% if (b.link) { %><br><span style="font-size:11px;color:#4fc3f7;"><%= b.link.length > 30 ? b.link.substring(0,30)+'...' : b.link %></span><% } %>
            </td>
            <td><span class="badge badge-<%= b.position === 'mini' ? 'secondary' : 'primary' %>"><%= b.position === 'mini' ? 'Mini' : 'Hero' %></span></td>
            <td style="font-size:12px;">
              <% if (b.start_date || b.end_date) { %>
                <% if (b.start_date) { %><div>Início: <%= b.start_date.replace('T',' ').substring(0,16) %></div><% } %>
                <% if (b.end_date) { %><div>Fim: <%= b.end_date.replace('T',' ').substring(0,16) %></div><% } %>
              <% } else { %>
                <span style="color:#999;">Sem agendamento</span>
              <% } %>
            </td>
            <td style="text-align:center;"><%= b.clicks || 0 %></td>
            <td>
              <% if (b.active) { %>
                <span class="status-badge active">Ativo</span>
              <% } else { %>
                <span class="status-badge inactive">Inativo</span>
              <% } %>
            </td>
            <td>
              <div style="display:flex;gap:4px;">
                <a href="/admin/banners/editar/<%= b.id %>" class="btn-icon btn-edit" title="Editar"><i class="fas fa-pen"></i></a>
                <form action="/admin/banners/deletar/<%= b.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Excluir este banner?')">
                  <button type="submit" class="btn-icon btn-delete" title="Excluir"><i class="fas fa-trash"></i></button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/admin-footer') %>