<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin-hacker.css">
  <link rel="stylesheet" href="/fonts/fontawesome.min.css">
</head>
<body class="admin-page" style="padding:32px;">

<div class="admin-layout" style="max-width:760px;margin:0 auto;">
  <div class="form-card" style="padding:28px;">
    <span class="sys-tag">[ SYS::MFA.SETUP ]</span>
    <h3 style="margin:0 0 4px;font-size:20px;color:var(--hack-text-hi);"><i class="fas fa-shield-halved" style="color:var(--hack-green);"></i> Configurar Autenticação de Dois Fatores (MFA)</h3>
    <p style="color:var(--hack-dim);font-size:13px;margin:0 0 20px;">Proteja o acesso ao painel com um código gerado no seu app autenticador.</p>

    <% if (error) { %><div class="alert alert-error" style="margin-bottom:16px;"><%= error %></div><% } %>

    <% if (qrCodeUrl) { %>
    <div class="admin-section">
      <div class="section-header"><h2><i class="fas fa-qrcode"></i> 1. Escaneie o QR Code</h2></div>
      <p style="color:var(--hack-dim);font-size:13px;">Use Google Authenticator, Authy, Microsoft Authenticator, etc.</p>
      <div style="background:var(--hack-bg-2);border:1px solid var(--hack-border);border-radius:10px;padding:20px;display:inline-block;margin:8px 0;">
        <img src="<%= qrCodeUrl %>" alt="QR Code MFA" style="width:200px;height:200px;display:block;image-rendering:pixelated;">
      </div>
    </div>

    <div class="admin-section">
      <div class="section-header"><h2><i class="fas fa-key"></i> 2. Chave secreta (backup manual)</h2></div>
      <div style="display:flex;gap:8px;align-items:center;">
        <input type="text" id="secretKey" value="<%= secret %>" readonly class="admin-input" style="flex:1;font-family:var(--hack-font);letter-spacing:1px;">
        <button class="btn-secondary" style="padding:8px 14px;border-radius:8px;cursor:pointer;font-size:13px;" onclick="copySecret()"><i class="fas fa-copy"></i> Copiar</button>
      </div>
    </div>

    <div class="admin-section">
      <div class="section-header"><h2><i class="fas fa-mobile-alt"></i> 3. Insira o código de 6 dígitos</h2></div>
      <form method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div style="display:flex;gap:8px;align-items:center;">
          <input type="text" name="totp" class="admin-input" placeholder="000000" maxlength="6" pattern="\d{6}" required autofocus style="letter-spacing:0.5rem;flex:1;text-align:center;font-size:18px;">
          <button type="submit" class="btn-primary" style="padding:10px 18px;border-radius:8px;cursor:pointer;font-size:13px;font-weight:700;"><i class="fas fa-shield-halved"></i> Ativar MFA</button>
        </div>
      </form>
    </div>

    <div class="admin-section" style="border:1px solid rgba(255,204,0,0.4);background:rgba(255,204,0,0.05);padding:16px;border-radius:10px;">
      <h3 style="margin:0 0 8px;color:var(--hack-amber);font-size:15px;"><i class="fas fa-exclamation-triangle"></i> Códigos de Recuperação</h3>
      <p style="color:var(--hack-text);font-size:13px;margin:0 0 12px;">Guarde em local seguro. Cada código só pode ser usado uma vez para recuperar acesso.</p>
      <div style="background:var(--hack-bg);border:1px solid var(--hack-border);border-radius:8px;padding:16px;font-family:var(--hack-font);font-size:13px;color:var(--hack-green);display:flex;flex-wrap:wrap;gap:6px;">
        <% recoveryCodes.forEach(function(code) { %>
          <span style="background:var(--hack-bg-2);border:1px solid var(--hack-border-hi);border-radius:4px;padding:4px 10px;" class="recovery-code"><%= code %></span>
        <% }) %>
      </div>
      <button class="btn-secondary" style="padding:8px 14px;border-radius:8px;cursor:pointer;font-size:12px;margin-top:12px;" onclick="copyRecoveryCodes()"><i class="fas fa-copy"></i> Copiar todos</button>
    </div>
    <% } %>

    <div style="margin-top:20px;">
      <a href="/admin/dashboard" class="btn-secondary" style="padding:8px 16px;border-radius:8px;font-size:13px;"><i class="fas fa-arrow-left"></i> Voltar ao painel</a>
    </div>
  </div>
</div>

<script>
  function copySecret() {
    const input = document.getElementById('secretKey');
    input.select();
    document.execCommand('copy');
    alert('Chave secreta copiada!');
  }
  function copyRecoveryCodes() {
    const codes = Array.from(document.querySelectorAll('.recovery-code')).map(el => el.textContent).join('\n');
    navigator.clipboard.writeText(codes).then(() => alert('Códigos de recuperação copiados!'));
  }
</script>
</body>
</html>
