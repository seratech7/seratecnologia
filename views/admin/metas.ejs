<%- include('../partials/admin-header') %>
<div class="admin-content">
  <div class="page-header">
    <div>
      <h1><i class="fas fa-bullseye"></i> Metas dos Vendedores</h1>
      <p>Crie e gerencie metas de vendas e faturamento para os vendedores</p>
    </div>
  </div>

  <% if (success) { %>
    <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
  <% } %>

  <div class="form-card">
    <h3><i class="fas fa-plus-circle" style="color:var(--primary);"></i> Nova Meta</h3>
    <form method="POST" action="/admin/metas/novo" class="admin-form">
      <div class="form-row form-row-3">
        <div class="form-group">
          <label><i class="fas fa-tag"></i> Título</label>
          <input type="text" name="title" class="admin-input" required placeholder="Ex: Meta de Julho">
        </div>
        <div class="form-group">
          <label><i class="fas fa-chart-bar"></i> Tipo</label>
          <select name="type" class="admin-select">
            <option value="sales_count">Qtd de Vendas</option>
            <option value="revenue">Faturamento (R$)</option>
          </select>
        </div>
        <div class="form-group">
          <label><i class="fas fa-bullseye"></i> Valor da Meta</label>
          <input type="number" name="target_value" class="admin-input" step="0.01" min="1" required>
        </div>
        <div class="form-group">
          <label><i class="fas fa-calendar-start"></i> Data Início</label>
          <input type="date" name="start_date" class="admin-input" required>
        </div>
        <div class="form-group">
          <label><i class="fas fa-calendar-end"></i> Data Fim</label>
          <input type="date" name="end_date" class="admin-input" required>
        </div>
        <div class="form-group">
          <label><i class="fas fa-gift"></i> Prêmio</label>
          <input type="text" name="prize_description" class="admin-input" placeholder="Ex: R$ 50 no Pix">
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn-primary"><i class="fas fa-plus"></i> Criar Meta</button>
      </div>
    </form>
  </div>

  <div class="admin-section">
    <div class="section-header">
      <h2><i class="fas fa-list"></i> Metas Cadastradas</h2>
    </div>
    <div class="table-container">
      <table class="admin-table">
        <thead>
          <tr><th>Título</th><th>Tipo</th><th>Meta</th><th>Prêmio</th><th>Período</th><th>Ativa</th><th>Ações</th></tr>
        </thead>
        <tbody>
          <% if (goals.length === 0) { %>
            <tr><td colspan="7" class="empty-row">Nenhuma meta cadastrada</td></tr>
          <% } %>
          <% goals.forEach(function(g) { %>
            <tr>
              <td><strong><%= g.title %></strong></td>
              <td><%= g.type === 'sales_count' ? '📦 Vendas' : '💰 Faturamento' %></td>
              <td class="price-cell"><%= g.type === 'sales_count' ? g.target_value + ' vendas' : 'R$ ' + parseFloat(g.target_value).toFixed(2) %></td>
              <td><%= g.prize_description || '-' %></td>
              <td><%= g.start_date.split('-').reverse().join('/') %> a <%= g.end_date.split('-').reverse().join('/') %></td>
              <td>
                <form method="POST" action="/admin/metas/toggle/<%= g.id %>" style="display:inline;">
                  <span class="status-badge <%= g.active ? 'active' : 'inactive' %>" style="cursor:pointer;" onclick="this.closest('form').submit()"><%= g.active ? 'Ativa' : 'Inativa' %></span>
                </form>
              </td>
              <td class="actions-cell">
                <a href="/admin/placar?goal_id=<%= g.id %>" class="btn-icon" title="Ver Placar"><i class="fas fa-ranking-star"></i></a>
                <button type="button" class="btn-icon" title="Editar" onclick="openEdit('<%= g.id %>', '<%= g.title.replace(/'/g, "\\'") %>', '<%= g.type %>', '<%= g.target_value %>', '<%= (g.prize_description || '').replace(/'/g, "\\'") %>', '<%= g.start_date %>', '<%= g.end_date %>')"><i class="fas fa-pencil-alt"></i></button>
                <form method="POST" action="/admin/metas/deletar/<%= g.id %>" style="display:inline;" onsubmit="return confirm('Excluir meta?')">
                  <button class="btn-icon btn-delete"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div id="editModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:9999;align-items:center;justify-content:center;">
  <div class="form-card" style="padding:24px;max-width:560px;width:90%;">
    <h3 style="margin:0 0 16px;"><i class="fas fa-pencil-alt"></i> Editar Meta</h3>
    <form method="POST" id="editForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-row form-row-3">
        <div class="form-group">
          <label>Título</label>
          <input type="text" name="title" id="e_title" class="admin-input" required>
        </div>
        <div class="form-group">
          <label>Tipo</label>
          <select name="type" id="e_type" class="admin-select">
            <option value="sales_count">Qtd de Vendas</option>
            <option value="revenue">Faturamento (R$)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Valor da Meta</label>
          <input type="number" name="target_value" id="e_target" class="admin-input" step="0.01" min="1" required>
        </div>
        <div class="form-group">
          <label>Data Início</label>
          <input type="date" name="start_date" id="e_start" class="admin-input" required>
        </div>
        <div class="form-group">
          <label>Data Fim</label>
          <input type="date" name="end_date" id="e_end" class="admin-input" required>
        </div>
        <div class="form-group">
          <label>Prêmio</label>
          <input type="text" name="prize_description" id="e_prize" class="admin-input" placeholder="Ex: R$ 50 no Pix">
        </div>
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px;">
        <button type="button" class="btn-secondary" style="padding:8px 16px;border-radius:8px;cursor:pointer;font-size:13px;" onclick="document.getElementById('editModal').style.display='none';">Cancelar</button>
        <button type="submit" class="btn-primary" style="padding:8px 16px;border-radius:8px;cursor:pointer;font-size:13px;">Salvar</button>
      </div>
    </form>
  </div>
</div>
<script>
function openEdit(id, title, type, target, prize, start, end) {
  document.getElementById('editForm').action = '/admin/metas/editar/' + id;
  document.getElementById('e_title').value = title;
  document.getElementById('e_type').value = type;
  document.getElementById('e_target').value = target;
  document.getElementById('e_prize').value = prize || '';
  document.getElementById('e_start').value = start;
  document.getElementById('e_end').value = end;
  document.getElementById('editModal').style.display = 'flex';
}
</script>
<%- include('../partials/admin-footer') %>