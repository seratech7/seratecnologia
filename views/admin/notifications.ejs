<%- include('../partials/admin-header') %>

<div class="dashboard-header">
  <h1><i class="fas fa-bell"></i> Notificações</h1>
  <p>Gerencie todas as notificações da plataforma</p>
</div>

<div style="margin-bottom:20px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between;">
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <a href="/admin/notifications" class="btn-small" style="<%= filter === 'all' ? 'background:var(--primary);color:#fff;' : '' %>">Todas</a>
    <a href="/admin/notifications?filter=unread" class="btn-small" style="<%= filter === 'unread' ? 'background:var(--primary);color:#fff;' : '' %>">Não lidas</a>
    <a href="/admin/notifications?filter=read" class="btn-small" style="<%= filter === 'read' ? 'background:var(--primary);color:#fff;' : '' %>">Lidas</a>
  </div>
  <div style="display:flex;gap:8px;">
    <form method="POST" action="/admin/notifications/marcar-todas">
      <button class="btn-small" style="background:var(--primary);color:#fff;border:none;cursor:pointer;">
        <i class="fas fa-check-double"></i> Marcar todas como lidas
      </button>
    </form>
    <button class="btn-small" style="background:var(--primary);color:#fff;" onclick="document.getElementById('newForm').style.display='block'">
      <i class="fas fa-plus"></i> Nova Notificação
    </button>
  </div>
</div>

<% if (error) { %>
<div class="alert alert-error" style="margin-bottom:16px;"><%= error %></div>
<% } %>

<div id="newForm" style="display:none;background:var(--hack-panel);border:1px solid var(--hack-border);border-radius:8px;padding:20px;margin-bottom:20px;">
  <h3 style="margin:0 0 12px;color:var(--hack-text-hi);">Nova Notificação</h3>
  <form method="POST" action="/admin/notifications/new" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
    <div style="grid-column:1/-1;">
      <label style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">Mensagem *</label>
      <input type="text" name="message" required class="admin-input" style="width:100%;">
    </div>
    <div>
      <label style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">Tipo</label>
      <select name="type" class="admin-select" style="width:100%;">
        <option value="info">info</option><option value="welcome">welcome</option><option value="alert">alert</option><option value="promo">promo</option>
      </select>
    </div>
    <div>
      <label style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">Ícone (FontAwesome)</label>
      <input type="text" name="icon" value="bell" class="admin-input" style="width:100%;">
    </div>
    <div>
      <label style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">Link</label>
      <input type="text" name="link" class="admin-input" style="width:100%;">
    </div>
    <div>
      <label style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">Enviar para</label>
      <select name="ip" id="sendTarget" class="admin-select" style="width:100%;" onchange="toggleIpInput()">
        <option value="">Todos os visitantes</option>
        <option value="specific">IP específico</option>
      </select>
    </div>
    <div id="specificIpGroup" style="display:none;">
      <label style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">Digite o IP</label>
      <input type="text" name="ip_custom" id="ipCustom" class="admin-input" style="width:100%;" placeholder="ex: 192.168.1.1">
    </div>
    <div style="grid-column:1/-1;display:flex;gap:8px;justify-content:flex-end;">
      <button type="button" class="btn-small" onclick="document.getElementById('newForm').style.display='none'">Cancelar</button>
      <button type="submit" class="btn-small" style="background:var(--primary);color:#fff;"><i class="fas fa-save"></i> Criar</button>
    </div>
  </form>
</div>

<% if (notifications.length === 0) { %>
<div style="text-align:center;padding:60px;color:var(--hack-dim);">
  <i class="fas fa-bell-slash" style="font-size:48px;opacity:0.3;margin-bottom:16px;"></i>
  <p>Nenhuma notificação encontrada</p>
</div>
<% } else { %>
<div style="overflow-x:auto;">
<table class="admin-table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Mensagem</th>
      <th>Tipo</th>
      <th>IP</th>
      <th>Lida</th>
      <th>Data</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    <% notifications.forEach(function(n) { %>
    <tr style="<%= !n.read ? 'background:rgba(0,229,255,0.05);' : '' %>">
      <td><%= n.id %></td>
      <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
        <i class="fas fa-<%= n.icon || 'bell' %>" style="margin-right:4px;color:var(--hack-dim);"></i>
        <%= n.message %>
      </td>
      <td><span style="background:rgba(0,229,255,0.10);color:var(--hack-cyan);padding:2px 8px;border-radius:4px;font-size:12px;"><%= n.type %></span></td>
      <td style="font-size:12px;"><% if (!n.ip) { %><span style="background:rgba(0,255,156,0.10);color:var(--hack-green);padding:2px 8px;border-radius:4px;font-weight:600;">Todos</span><% } else { %><span style="color:var(--hack-dim);"><%= n.ip %></span><% } %></td>
      <td><%= n.read ? 'Sim' : 'Não' %></td>
      <td style="font-size:12px;color:var(--hack-dim);white-space:nowrap;"><%= n.created_at %></td>
      <td style="white-space:nowrap;">
        <button class="btn-small btn-edit-notif" data-id="<%= n.id %>" data-msg="<%= (n.message||'').replace(/"/g,'&quot;').replace(/[\n\r]/g,' ') %>" data-type="<%= n.type %>" data-icon="<%= n.icon||'bell' %>" data-link="<%= (n.link||'').replace(/"/g,'&quot;') %>" data-ip="<%= (n.ip||'').replace(/"/g,'&quot;') %>" data-read="<%= n.read %>" style="margin-right:4px;">
          <i class="fas fa-edit"></i>
        </button>
        <form method="POST" action="/admin/notifications/delete/<%= n.id %>" style="display:inline;" onsubmit="return confirm('Excluir esta notificação?')">
          <button class="btn-small btn-delete" title="Excluir"><i class="fas fa-trash"></i></button>
        </form>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
</div>

<% if (totalPages > 1) { %>
<div style="display:flex;gap:8px;justify-content:center;margin-top:20px;">
  <% for(var p=1;p<=totalPages;p++){ %>
    <a href="/admin/notifications?filter=<%= filter %>&page=<%= p %>" class="btn-small" style="<%= p===page?'background:var(--primary);color:#fff;':'' %>min-width:36px;text-align:center;text-decoration:none;"><%= p %></a>
  <% } %>
</div>
<% } %>
<% } %>

<div id="editModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:9999;align-items:center;justify-content:center;">
  <div style="background:linear-gradient(160deg,var(--hack-panel),var(--hack-bg-2));border:1px solid var(--hack-border-hi);border-radius:12px;padding:24px;max-width:520px;width:90%;box-shadow:0 0 40px rgba(0,255,156,0.15);max-height:90vh;overflow-y:auto;">
    <h3 style="margin:0 0 16px;color:var(--hack-text-hi);">Editar Notificação</h3>
    <form method="POST" id="editForm">
      <div style="margin-bottom:12px;">
        <label style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">Mensagem</label>
        <input type="text" name="message" id="editMessage" required class="admin-input" style="width:100%;">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
    <div>
      <label style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">Tipo</label>
      <select name="type" id="editType" class="admin-select" style="width:100%;">
        <option value="info">info</option><option value="welcome">welcome</option><option value="alert">alert</option><option value="promo">promo</option>
      </select>
    </div>
    <div>
      <label style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">Ícone</label>
      <input type="text" name="icon" id="editIcon" class="admin-input" style="width:100%;">
    </div>
    <div>
      <label style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">Link</label>
      <input type="text" name="link" id="editLink" class="admin-input" style="width:100%;">
    </div>
    <div>
      <label style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">IP (vazio = todos)</label>
      <input type="text" name="ip" id="editIp" class="admin-input" style="width:100%;" placeholder="deixe vazio para todos">
    </div>
      </div>
      <div style="margin-bottom:16px;">
        <label style="display:inline-flex;align-items:center;gap:6px;font-size:14px;cursor:pointer;color:var(--hack-text);">
          <input type="checkbox" name="read" id="editRead" value="1"> Lida
        </label>
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button type="button" class="btn-small" onclick="closeModal()">Cancelar</button>
        <button type="submit" class="btn-small" style="background:linear-gradient(135deg,var(--hack-green-dim),var(--hack-green));color:#03120a;"><i class="fas fa-save"></i> Salvar</button>
      </div>
    </form>
  </div>
</div>

<script>
function toggleIpInput() {
  var sel = document.getElementById('sendTarget');
  var grp = document.getElementById('specificIpGroup');
  grp.style.display = sel.value === 'specific' ? 'block' : 'none';
}
document.querySelector('#newForm form').addEventListener('submit', function(e) {
  var sel = document.getElementById('sendTarget');
  var custom = document.getElementById('ipCustom');
  if (sel.value === 'specific' && custom.value) {
    var hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = 'ip';
    hidden.value = custom.value;
    sel.name = ''; sel.value = '';
    this.appendChild(hidden);
  }
});

function closeModal() {
  document.getElementById('editModal').style.display = 'none';
}

document.querySelectorAll('.btn-edit-notif').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.getElementById('editForm').action = '/admin/notifications/edit/' + this.dataset.id;
    document.getElementById('editMessage').value = this.dataset.msg;
    document.getElementById('editType').value = this.dataset.type;
    document.getElementById('editIcon').value = this.dataset.icon;
    document.getElementById('editLink').value = this.dataset.link;
    document.getElementById('editIp').value = this.dataset.ip;
    document.getElementById('editRead').checked = this.dataset.read === '1';
    document.getElementById('editModal').style.display = 'flex';
  });
});
document.getElementById('editModal').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});
</script>

<%- include('../partials/admin-footer') %>