<%- include('../partials/admin-header') %>

<div class="admin-content">
  <div class="page-header">
    <h1><i class="fas fa-box"></i> Produtos</h1>
    <a href="/admin/products/new" class="btn-primary"><i class="fas fa-plus"></i> Novo Produto</a>
  </div>

  <div class="filter-tabs">
    <a href="/admin/products" class="<%= filter === 'all' || !filter ? 'active' : '' %>">Todos</a>
    <a href="/admin/products?filter=featured" class="<%= filter === 'featured' ? 'active' : '' %>"><i class="fas fa-star"></i> Destaques</a>
    <a href="/admin/products?filter=flash" class="<%= filter === 'flash' ? 'active' : '' %>"><i class="fas fa-bolt"></i> Flash Sale</a>
    <a href="/admin/products?filter=pending" class="<%= filter === 'pending' ? 'active' : '' %>">Pendentes</a>
    <a href="/admin/products?filter=active" class="<%= filter === 'active' ? 'active' : '' %>">Ativos</a>
    <a href="/admin/products?filter=rejected" class="<%= filter === 'rejected' ? 'active' : '' %>">Rejeitados</a>
  </div>

  <div class="search-bar">
    <form action="/admin/products" method="GET">
      <input type="hidden" name="filter" value="<%= filter %>">
      <i class="fas fa-search"></i>
      <input type="text" name="search" placeholder="Buscar produtos..." value="<%= search %>">
      <button type="submit">Buscar</button>
      <% if (search) { %><a href="/admin/products?filter=<%= filter %>" class="clear-search"><i class="fas fa-times"></i></a><% } %>
    </form>
  </div>

  <form method="POST" action="/admin/products/bulk" id="bulkForm">
  <div class="bulk-bar" style="display:flex;gap:8px;align-items:center;margin-bottom:12px;padding:10px 16px;background:#f5f5f5;border-radius:8px;">
    <input type="checkbox" id="selectAll" onchange="document.querySelectorAll('.bulk-check').forEach(function(c){c.checked=this.checked})" style="margin:0;">
    <span style="font-size:13px;color:#666;">Selecionar todos</span>
    <select name="action" class="admin-select" style="width:auto;padding:4px 8px;font-size:13px;">
      <option value="">-- Ação em massa --</option>
      <option value="approve">Aprovar</option>
      <option value="feature">Destacar</option>
      <option value="unfeature">Remover Destaque</option>
      <option value="delete">Excluir</option>
    </select>
    <button type="submit" class="btn-primary" style="padding:4px 12px;font-size:13px;" onclick="return confirm('Aplicar ação em massa?')">Aplicar</button>
    <form action="/admin/products/reactivate-all" method="POST" style="display:inline;" onsubmit="return confirm('Reativar TODOS os produtos como ativos?')">
      <button type="submit" class="btn-small" style="background:#2e7d32;color:white;border:none;padding:4px 12px;border-radius:4px;cursor:pointer;font-size:13px;"><i class="fas fa-sync"></i> Reativar Todos</button>
    </form>
  </div>

  <div class="table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width:30px;"></th>
          <th data-sort>Código</th>
          <th data-sort>Produto</th>
          <th data-sort data-num="1">Preço</th>
          <th data-sort>Flash</th>
          <th data-sort data-num="1">Visualizações</th>
          <th data-sort data-num="1">Vendas</th>
          <th data-sort>Vendedor</th>
          <th data-sort>Categoria</th>
          <th data-sort>Status</th>
          <th data-sort>Data</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
          <% if (products.length === 0) { %>
            <tr><td colspan="12" class="empty-row">Nenhum produto encontrado</td></tr>
          <% } else { %>
            <% products.forEach(p => { %>
              <tr>
                <td><input type="checkbox" name="ids" value="<%= p.id %>" class="bulk-check"></td>
                <td style="font-family:monospace;font-size:13px;color:#666;white-space:nowrap;"><%= p.code || 'PROD-' + Math.random().toString(36).slice(2,10).toUpperCase() %></td>
                <td class="product-cell">
                  <div class="product-cell-info">
                    <% if (p.image) { %><img src="<%= p.image %>" alt="" class="thumb"><% } else { %><div class="thumb thumb-placeholder"><i class="fas fa-image"></i></div><% } %>
                    <div>
                      <span class="product-name-cell"><%= p.name %></span>
                      <% if (p.featured) { %><span class="featured-tag"><i class="fas fa-star"></i></span><% } %>
                    </div>
                  </div>
                </td>
                <td class="price-cell"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(p.price) %></td>
                <td>
                  <% if (p.flash_price && p.flash_ends_at && new Date(p.flash_ends_at) > new Date()) { %>
                    <span style="background:#ff5722;color:#fff;padding:2px 8px;border-radius:4px;font-size:12px;font-weight:700;white-space:nowrap;">
                      <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(p.flash_price) %>
                    </span>
                    <div style="font-size:10px;color:#999;"><%= new Date(p.flash_ends_at).toLocaleString('pt-BR') %></div>
                  <% } else { %>
                    <span style="color:#ccc;font-size:12px;">-</span>
                  <% } %>
                </td>
                <td style="text-align:center;"><span class="stat-badge views"><i class="fas fa-eye"></i> <%= p.views || 0 %></span></td>
                <td style="text-align:center;"><span class="stat-badge sales"><i class="fas fa-shopping-cart"></i> <%= p.sales_count || 0 %></span></td>
                <td><%= p.seller_name || 'Admin' %></td>
                <td><%= p.category_name || '-' %></td>
                <td>
                  <% if (p.status === 'active') { %><span class="status-badge active">Ativo</span>
                  <% } else if (p.status === 'pending') { %><span class="status-badge pending">Pendente</span>
                  <% } else if (p.status === 'rejected') { %><span class="status-badge" style="background:rgba(255,56,96,0.10);color:var(--hack-red);">Rejeitado</span>
                  <% } else { %><span class="status-badge inactive">Inativo</span><% } %>
                </td>
                <td><%= new Date(p.created_at).toLocaleDateString('pt-BR') %></td>
              <td class="actions-cell">
                <% if (p.status === 'pending') { %>
                  <form action="/admin/products/approve/<%= p.id %>" method="POST" class="inline-form">
                    <button type="submit" class="btn-icon" style="background:rgba(0,255,156,0.12);color:var(--hack-green);" title="Aprovar"><i class="fas fa-check"></i></button>
                  </form>
                  <button type="button" class="btn-icon" style="background:rgba(255,56,96,0.12);color:var(--hack-red);" title="Rejeitar" onclick="openRejectModal(<%= p.id %>, '<%= p.name.replace(/'/g, "\\'") %>')"><i class="fas fa-times"></i></button>
                <% } %>
                <form action="/admin/products/feature/<%= p.id %>" method="POST" class="inline-form">
                  <button type="submit" class="btn-icon" style="<%= p.featured ? 'background:rgba(255,204,0,0.12);color:var(--hack-amber);' : '' %>" title="<%= p.featured ? 'Remover destaque' : 'Destacar' %>"><i class="fas fa-star"></i></button>
                </form>
                <% if (p.status === 'active' && (!p.flash_price || new Date(p.flash_ends_at) < new Date())) { %>
                  <button type="button" class="btn-icon" style="background:rgba(255,152,0,0.12);color:var(--hack-amber);" title="Flash Sale" onclick="document.getElementById('flashForm_<%= p.id %>').style.display='block'"><i class="fas fa-bolt"></i></button>
                <% } %>
                <% if (p.flash_price && p.flash_ends_at && new Date(p.flash_ends_at) > new Date()) { %>
                  <form action="/admin/products/flash/remove/<%= p.id %>" method="POST" class="inline-form">
                    <button type="submit" class="btn-icon" style="background:rgba(255,56,96,0.12);color:var(--hack-red);" title="Remover Flash"><i class="fas fa-bolt"></i></button>
                  </form>
                <% } %>
                <a href="/admin/products/edit/<%= p.id %>" class="btn-icon" title="Editar"><i class="fas fa-edit"></i></a>
                <form action="/admin/products/delete/<%= p.id %>" method="POST" class="inline-form" onsubmit="return confirm('Excluir este produto?')">
                  <button type="submit" class="btn-icon btn-delete" title="Excluir"><i class="fas fa-trash"></i></button>
                </form>
                <form id="flashForm_<%= p.id %>" action="/admin/products/flash/<%= p.id %>" method="POST" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:linear-gradient(160deg,var(--hack-panel),var(--hack-bg-2));border:1px solid var(--hack-border-hi);padding:20px;border-radius:12px;box-shadow:0 0 40px rgba(0,255,156,0.15);z-index:9999;width:300px;" onclick="event.stopPropagation()">
                  <h4 style="margin:0 0 12px;color:var(--hack-amber);"><i class="fas fa-bolt"></i> Flash Sale</h4>
                  <div class="form-group"><label>Preço Flash (R$)</label><input type="number" name="flash_price" class="admin-input" step="0.01" min="0.01" required></div>
                  <div class="form-group"><label>Duração (horas)</label><input type="number" name="flash_hours" class="admin-input" value="24" min="1" max="168"></div>
                  <div style="display:flex;gap:8px;margin-top:12px;">
                    <button type="submit" class="btn-primary" style="padding:8px 16px;font-size:13px;">Ativar</button>
                    <button type="button" class="btn-primary" style="background:#999;padding:8px 16px;font-size:13px;" onclick="this.closest('form').style.display='none'">Cancelar</button>
                  </div>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
  </form>

  <% if (totalPages > 1) { %>
    <div class="pagination">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="/admin/products?page=<%= i %>&filter=<%= filter %>" class="page-link <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('../partials/admin-footer') %>

<!-- Rejection Modal -->
<div id="rejectModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:9999;align-items:center;justify-content:center;">
  <div style="background:linear-gradient(160deg,var(--hack-panel),var(--hack-bg-2));border:1px solid var(--hack-border-hi);border-radius:12px;padding:24px;max-width:450px;width:90%;box-shadow:0 0 40px rgba(0,255,156,0.15);">
    <h3 style="margin:0 0 4px;color:var(--hack-red);"><i class="fas fa-times-circle"></i> Rejeitar Produto</h3>
    <p style="font-size:14px;color:var(--hack-dim);margin:0 0 14px;" id="rejectProductName"></p>
    <form method="POST" id="rejectForm">
      <div class="form-group">
        <label for="rejection_reason" style="display:block;font-size:13px;font-weight:600;color:var(--hack-text);margin-bottom:4px;">Motivo da rejeição</label>
        <textarea id="rejection_reason" name="rejection_reason" rows="3" style="width:100%;padding:8px 10px;border:1px solid var(--hack-border);border-radius:6px;background:var(--hack-bg-2);color:var(--hack-text);font-family:inherit;font-size:13px;resize:vertical;" placeholder="Explique ao vendedor por que o produto foi rejeitado..."></textarea>
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px;">
        <button type="button" onclick="closeRejectModal()" class="btn-secondary" style="padding:8px 16px;border-radius:8px;cursor:pointer;">Cancelar</button>
        <button type="submit" class="btn-danger" style="padding:8px 16px;border-radius:8px;cursor:pointer;"><i class="fas fa-times"></i> Rejeitar</button>
      </div>
    </form>
  </div>
</div>
<script>
function openRejectModal(id, name) {
  document.getElementById('rejectProductName').textContent = name;
  document.getElementById('rejectForm').action = '/admin/products/reject/' + id;
  document.getElementById('rejectModal').style.display = 'flex';
}
function closeRejectModal() {
  document.getElementById('rejectModal').style.display = 'none';
}
document.getElementById('rejectModal').addEventListener('click', function(e) {
  if (e.target === this) closeRejectModal();
});
</script>
