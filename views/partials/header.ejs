      <% } else { %>
        <a href="/login"><i class="fas fa-user"></i> Entrar / Cadastrar</a>
        <a href="/seller/login"><i class="fas fa-store-alt"></i> Quero Vender</a>
      <% } %>
    </div>
  </div>
</nav>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var hamburger = document.getElementById('hamburgerBtn');
  var mobileMenu = document.getElementById('mobileMenu');
  var overlay = document.getElementById('mobileOverlay');
  var closeBtn = document.getElementById('mobileClose');
  var searchToggle = document.getElementById('searchToggle');
  var searchContainer = document.getElementById('searchContainer');
  var catToggle = document.getElementById('catToggle');
  var catSubmenu = document.getElementById('catSubmenu');

  if (hamburger && mobileMenu && overlay) {
    function openMenu() {
      hamburger.classList.add('active');
      mobileMenu.classList.add('active');
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
    function closeMenu() {
      hamburger.classList.remove('active');
      mobileMenu.classList.remove('active');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }
    hamburger.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);
  }

  if (searchToggle && searchContainer) {
    searchToggle.addEventListener('click', function() {
      searchContainer.classList.toggle('active');
      if (searchContainer.classList.contains('active')) {
        var input = searchContainer.querySelector('input');
        if (input) input.focus();
      }
    });
  }

  if (catToggle && catSubmenu) {
    catToggle.addEventListener('click', function(e) {
      e.preventDefault();
      catSubmenu.classList.toggle('active');
      catToggle.querySelector('.fa-chevron-down').classList.toggle('rotated');
    });
  }
});

function toggleHackerTheme() {
  var active = document.body.classList.toggle('hacker-theme');
  localStorage.setItem('hacker-theme', active ? '1' : '0');
  var btn = document.getElementById('themeToggle');
  if (btn) btn.classList.toggle('active', active);
}
</script>

<script src="/js/notifications.js"></script>

<div class="top-ad" id="topAd">
  <div class="top-ad-content">
    <img class="top-ad-img" id="adImg" src="" alt="" style="display:none;">
    <span class="top-ad-label">PUBLICIDADE</span>
    <span class="top-ad-text" id="adText"></span>
  </div>
  <button class="top-ad-close" id="adClose" aria-label="Fechar">&times;</button>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var adText = document.getElementById('adText');
  var adClose = document.getElementById('adClose');
  var topAd = document.getElementById('topAd');
  var adImg = document.getElementById('adImg');
  var mc = document.querySelector('.main-content');
  var adData = null;
  var adStartTime = 0;

  function showAd(ad) {
    if (!ad || !adText || !topAd) return;
    adData = ad;
    adStartTime = Date.now();
    adText.innerHTML = ad.text || ad.title || '';
    if (adImg) {
      if (ad.image) { adImg.src = ad.image; adImg.style.display = ''; topAd.classList.add('has-img'); }
      else { adImg.src = ''; adImg.style.display = 'none'; topAd.classList.remove('has-img'); }
    }
    topAd.style.display = '';
    if (mc) mc.style.paddingTop = (topAd.offsetHeight || 32) + 'px';
    adClose.disabled = true;
    adClose.style.opacity = '0.3';
    adClose.style.cursor = 'default';

    if (ad.link) {
      topAd.querySelector('.top-ad-content').style.cursor = 'pointer';
      topAd.querySelector('.top-ad-content').onclick = function(e) {
        if (e.target.tagName !== 'A' && ad.link && ad.link.match(/^https?:\/\//i)) {
          window.open(ad.link, '_blank');
        }
      };
    }

    var duration = (ad.display_duration || 15) * 1000;
    setTimeout(function() {
      adClose.disabled = false;
      adClose.style.opacity = '1';
      adClose.style.cursor = 'pointer';
    }, duration);
  }

  function hideAd(permanent) {
    if (topAd) topAd.style.display = 'none';
    if (mc) mc.style.paddingTop = '0';
    if (permanent && adData) {
      var expires = Date.now() + ((adData.cooldown || 86400) * 1000);
      localStorage.setItem('adClosed', expires.toString());
      localStorage.setItem('adId', adData.id.toString());
    }
  }

  var closedTime = localStorage.getItem('adClosed');
  var closedAdId = localStorage.getItem('adId');

  if (closedTime && parseInt(closedTime) > Date.now()) {
    if (topAd) topAd.style.display = 'none';
  } else {
    localStorage.removeItem('adClosed');
    localStorage.removeItem('adId');
    fetch('/api/ads').then(function(r) { return r.json(); }).then(function(ad) {
      if (ad && ad.id && closedAdId && parseInt(ad.id) === parseInt(closedAdId) && closedTime && parseInt(closedTime) > Date.now()) {
        if (topAd) topAd.style.display = 'none';
        return;
      }
      showAd(ad);
    }).catch(function() {
      if (topAd) topAd.style.display = 'none';
    });
  }

  if (adClose && topAd) {
    adClose.addEventListener('click', function() {
      if (adClose.disabled) return;
      hideAd(true);
    });
  }
});
</script>

