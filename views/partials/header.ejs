<style>
:root { --wa-bar: 36px; }
.wa-topbar { position: fixed; top: 0; left: 0; right: 0; z-index: 1001; background:#ffd400; color:#1a1400; height: var(--wa-bar); display:flex; align-items:center; justify-content:center; overflow:hidden; }
.wa-topbar-link { display:flex; align-items:center; justify-content:center; gap:8px; height:100%; width:100%; padding:0 12px; font-size:13px; font-weight:700; text-decoration:none; color:#1a1400; text-align:center; white-space:nowrap; }
.wa-topbar-link i { font-size:17px; flex:none; }
.sig-ico { width:16px; height:16px; flex:none; fill:currentColor; vertical-align:middle; }
.wa-topbar-link:hover { background:rgba(0,0,0,.07); }
.main-header { top: var(--wa-bar); }
.top-ad { top: calc(var(--header-height) + var(--wa-bar)); }
.main-content { margin-top: calc(var(--header-height) + var(--wa-bar)); min-height: calc(100vh - var(--header-height) - var(--wa-bar)); }
@media (max-width:600px){
  :root { --wa-bar: 52px; }
  .wa-topbar-link { font-size:11px; white-space:normal; }
}
body.hacker-theme .wa-topbar { background:#ffd400; color:#1a1400; }
body.hacker-theme .wa-topbar-link,
body.hacker-theme .wa-topbar-link:hover { color:#1a1400; }
body.hacker-theme .wa-topbar-link:hover { background:rgba(0,0,0,.07); }
</style>

<header class="main-header">
  <div class="header-container">
    <div class="header-left">
      <button class="hamburger" id="hamburgerBtn" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
      <a href="/" class="logo">
        <% if (typeof siteConfig !== 'undefined' && siteConfig.site_logo_url) { %>
          <img src="<%= siteConfig.site_logo_url %>" alt="<%= siteConfig.site_name || 'Logo' %>" style="max-height:40px;max-width:180px;object-fit:contain;">
        <% } else { %>
          <img src="/img/logo.svg" alt="<%= typeof siteConfig !== 'undefined' && siteConfig.site_name ? siteConfig.site_name : 'SeraTecnologia' %>" style="max-height:40px;max-width:190px;object-fit:contain;">
        <% } %>
      </a>
    </div>
    <div class="header-center" id="searchContainer">
      <form action="/marketplace" method="GET" class="search-form">
        <i class="fas fa-search"></i>
        <input type="text" name="search" placeholder="Buscar HD, SSD, notebook..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        <button type="submit">Buscar</button>
      </form>
    </div>
    <div class="header-right">
      <button class="theme-toggle-btn" id="themeToggle" onclick="toggleHackerTheme()" title="Alternar tema claro/escuro" aria-label="Alternar tema claro/escuro">
        <i class="fas fa-terminal"></i>
      </button>
      <a href="/noticias" class="btn-admin-header" style="margin-right:4px;">
        <i class="fas fa-newspaper"></i>
        <span>Notícias</span>
      </a>
      <a href="/marketplace" class="btn-admin-header" style="margin-right:4px;">
        <i class="fas fa-shopping-cart"></i>
        <span>Marketplace</span>
      </a>
      <a href="/logins" class="btn-admin-header" style="margin-right:4px;">
        <i class="fas fa-key"></i>
        <span>Logins</span>
      </a>
      <a href="/rastreio" class="btn-admin-header" style="margin-right:4px;">
        <i class="fas fa-truck"></i>
        <span>Rastrear</span>
      </a>
      <div class="notif-center">
        <button class="notif-bell-btn" data-endpoint="/api/notifications/recent" data-all-link="/notificacoes" aria-label="Notificações">
          <i class="fas fa-bell"></i>
          <span class="notif-badge" hidden>0</span>
        </button>
        <div class="notif-panel">
          <div class="notif-panel-head">
            <strong><i class="fas fa-bell"></i> Notificações <span class="notif-count-pill">0</span></strong>
            <button class="notif-mark-all">Marcar todas como lidas</button>
          </div>
          <div class="notif-list"></div>
          <div class="notif-panel-foot"><a href="/notificacoes">Ver todas</a></div>
        </div>
      </div>
      <button class="search-toggle-mobile" id="searchToggle" aria-label="Buscar">
        <i class="fas fa-search"></i>
      </button>
      <% if (admin) { %>
        <a href="/admin/dashboard" class="btn-admin-header">
          <i class="fas fa-cog"></i>
          <span>Admin</span>
        </a>
      <% } else if (seller) { %>
        <a href="/seller/dashboard" class="btn-admin-header">
          <i class="fas fa-store-alt"></i>
          <span>Vendedor</span>
        </a>
      <% } else if (customer) { %>
        <a href="/conta" class="btn-admin-header">
          <i class="fas fa-user"></i>
          <span>Minha Conta</span>
        </a>
      <% } else { %>
        <a href="/login" class="btn-admin-header">
          <i class="fas fa-user"></i>
          <span>Entrar</span>
        </a>
        <a href="/seller/login" class="btn-admin-header">
          <i class="fas fa-store-alt"></i>
          <span>Vender</span>
        </a>
      <% } %>
    </div>
  </div>
</header>

<div class="mobile-overlay" id="mobileOverlay"></div>
<nav class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu-header">
    <a href="/" class="mobile-logo"><img src="/img/logo-icon.svg" alt="SeraTecnologia" style="height:26px;width:26px;vertical-align:middle;"> SeraTecnologia</a>
    <button class="mobile-close" id="mobileClose">&times;</button>
  </div>
  <div class="mobile-menu-body">
    <form action="/marketplace" method="GET" class="mobile-search-form">
      <input type="text" name="search" placeholder="Buscar produtos..." value="<%= typeof search !== 'undefined' ? search : '' %>">
      <button type="submit"><i class="fas fa-search"></i></button>
    </form>
    <div class="mobile-nav-links">
      <a href="/noticias"><i class="fas fa-newspaper"></i> Notícias & Hacking</a>
      <a href="/marketplace"><i class="fas fa-shopping-cart"></i> Marketplace</a>
      <a href="/logins"><i class="fas fa-key"></i> Logins & Contas</a>
      <a href="/rastreio"><i class="fas fa-truck"></i> Rastrear Pedido</a>
      <a href="#" onclick="toggleHackerTheme();return false;"><i class="fas fa-terminal"></i> Tema Hacker</a>
      <a href="#" class="mobile-sub-toggle" id="catToggle"><i class="fas fa-th-large"></i> Categorias <i class="fas fa-chevron-down"></i></a>
      <div class="mobile-submenu" id="catSubmenu">
        <a href="/marketplace">Todas</a>
        <a href="/marketplace?category=ssds">⚡ SSDs</a>
        <a href="/marketplace?category=hds-armazenamento">💾 HDs</a>
        <a href="/marketplace?category=memoria-ram">🧠 Memória RAM</a>
        <a href="/marketplace?category=processadores">🔲 Processadores</a>
        <a href="/marketplace?category=placas-video">🎮 Placas de Vídeo</a>
        <a href="/marketplace?category=placas-mae">🔧 Placas-mãe</a>
      </div>
      <% if (admin) { %>
        <a href="/admin/dashboard"><i class="fas fa-cog"></i> Painel Admin</a>
      <% } else if (seller) { %>
        <a href="/seller/dashboard"><i class="fas fa-store-alt"></i> Painel Vendedor</a>
      <% } else if (customer) { %>
        <a href="/conta"><i class="fas fa-user"></i> Minha Conta</a>
