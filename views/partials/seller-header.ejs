<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | MarketPlace</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/fonts/fontawesome.min.css">
  <link rel="stylesheet" href="/css/notifications.css">
</head>
<body class="admin-page">

<div class="admin-layout">
  <div class="admin-sidebar-overlay" onclick="toggleAdminSidebar()"></div>
  <aside class="admin-sidebar seller-sidebar">
    <div class="sidebar-brand">
      <a href="/seller/dashboard">
        <i class="fas fa-microchip"></i>
        <span>SeraTecnologia</span>
      </a>
      <span class="sidebar-subtitle">Painel do Vendedor</span>
    </div>

    <nav class="sidebar-nav">
      <a href="/seller/dashboard" class="<%= currentPath === '/seller/dashboard' ? 'active' : '' %>">
        <i class="fas fa-tachometer-alt"></i> Dashboard
      </a>
      <a href="/seller/products" class="<%= currentPath.startsWith('/seller/products') ? 'active' : '' %>">
        <i class="fas fa-box"></i> Meus Produtos
        <% if (typeof pendingProductsCount !== 'undefined' && pendingProductsCount > 0) { %><span class="badge-msg" style="background:#ff9800;"><%= pendingProductsCount %></span><% } %>
      </a>
      <a href="/seller/products/new" class="<%= currentPath === '/seller/products/new' ? 'active' : '' %>">
        <i class="fas fa-plus-circle"></i> Novo Produto
      </a>
      <a href="/seller/sales" class="<%= currentPath === '/seller/sales' ? 'active' : '' %>">
        <i class="fas fa-shopping-bag"></i> Vendas
      </a>
      <a href="/seller/wallet" class="<%= currentPath === '/seller/wallet' ? 'active' : '' %>">
        <i class="fas fa-wallet"></i> Carteira
      </a>
      <a href="/seller/coupons" class="<%= currentPath === '/seller/coupons' ? 'active' : '' %>">
        <i class="fas fa-tag"></i> Cupons
      </a>
      <a href="/seller/questions" class="<%= currentPath === '/seller/questions' ? 'active' : '' %>">
        <i class="fas fa-question-circle"></i> Perguntas
        <% if (typeof pendingQuestionsCount !== 'undefined' && pendingQuestionsCount > 0) { %><span class="badge-msg"><%= pendingQuestionsCount %></span><% } %>
      </a>
      <a href="/seller/placar" class="<%= currentPath === '/seller/placar' ? 'active' : '' %>">
        <i class="fas fa-ranking-star"></i> Placar
      </a>
      <a href="/seller/exportar-vendas" class="<%= currentPath === '/seller/exportar-vendas' ? 'active' : '' %>">
        <i class="fas fa-file-csv"></i> Exportar Vendas
      </a>
      <a href="/seller/configuracoes" class="<%= currentPath === '/seller/configuracoes' ? 'active' : '' %>">
        <i class="fas fa-cog"></i> Configurações
      </a>
      <a href="/seller/profile" class="<%= currentPath === '/seller/profile' ? 'active' : '' %>">
        <i class="fas fa-user-cog"></i> Meu Perfil
      </a>
    </nav>

    <div class="sidebar-footer">
      <a href="/" target="_blank" class="sidebar-link">
        <i class="fas fa-external-link-alt"></i> Ver Site
      </a>
      <a href="/seller/logout" class="sidebar-link logout">
        <i class="fas fa-sign-out-alt"></i> Sair
      </a>
    </div>
  </aside>

  <div class="admin-main">
    <div style="display:flex;align-items:center;gap:8px;">
      <button class="sidebar-toggle" onclick="toggleAdminSidebar()" title="Menu">
        <i class="fas fa-bars"></i>
      </button>
      <div class="notif-center">
        <button class="notif-bell-btn" data-endpoint="/api/notifications/recent" data-all-link="/seller/notifications" aria-label="Notificações">
          <i class="fas fa-bell"></i>
          <span class="notif-badge" hidden>0</span>
        </button>
        <div class="notif-panel">
          <div class="notif-panel-head">
            <strong><i class="fas fa-bell"></i> Notificações <span class="notif-count-pill">0</span></strong>
            <button class="notif-mark-all">Marcar todas como lidas</button>
          </div>
          <div class="notif-list"></div>
          <div class="notif-panel-foot"><a href="/seller/notifications">Ver todas</a></div>
        </div>
      </div>
    </div>
    <script src="/js/notifications.js"></script>
