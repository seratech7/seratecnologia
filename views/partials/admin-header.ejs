<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | MarketPlace</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/fonts/fontawesome.min.css">
  <link rel="stylesheet" href="/css/admin-hacker.css">
<style>
.sub-link { padding-left:52px !important; font-size:13px !important; opacity:.75; }
.sub-link i { width:16px !important; margin-right:8px !important; font-size:13px !important; }
.sub-link:hover { opacity:1; color:white !important; }
.sub-link.active { opacity:1; color:var(--primary) !important; border-left-color:var(--primary) !important; }
</style>
</head>
<body class="admin-page">

<div class="admin-layout">
  <div class="admin-sidebar-overlay" onclick="toggleAdminSidebar()"></div>
  <aside class="admin-sidebar">
    <div class="sidebar-brand">
      <a href="/admin/dashboard">
        <i class="fas fa-microchip"></i>
        <span>SeraTecnologia</span>
      </a>
      <span class="sidebar-subtitle">Painel Admin</span>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section-label">Principal</div>
      <a href="/admin/dashboard" class="<%= currentPath === '/admin/dashboard' ? 'active' : '' %>">
        <i class="fas fa-tachometer-alt"></i> <span>Dashboard</span>
      </a>

      <div class="nav-section-label">Conteúdo</div>
      <a href="/admin/products" class="<%= currentPath.startsWith('/admin/products') ? 'active' : '' %>">
        <i class="fas fa-box"></i> <span>Produtos</span>
        <% if (typeof adminPendingProducts !== 'undefined' && adminPendingProducts > 0) { %><span class="badge-msg" style="background:#ff9800;"><%= adminPendingProducts %></span><% } %>
      </a>
      <a href="/admin/categories" class="<%= currentPath === '/admin/categories' ? 'active' : '' %>">
        <i class="fas fa-tags"></i> <span>Categorias</span>
      </a>
      <a href="/admin/banners" class="<%= currentPath === '/admin/banners' ? 'active' : '' %>">
        <i class="fas fa-images"></i> <span>Banners</span>
      </a>
      <a href="/admin/paginas" class="<%= currentPath.startsWith('/admin/paginas') ? 'active' : '' %>">
        <i class="fas fa-file-alt"></i> <span>Páginas</span>
      </a>
      <a href="/admin/ads" class="<%= currentPath.startsWith('/admin/ads') ? 'active' : '' %>">
        <i class="fas fa-ad"></i> <span>Anúncios</span>
      </a>

      <div class="nav-section-label">Vendas</div>
      <a href="/admin/sales" class="<%= currentPath.startsWith('/admin/sales') ? 'active' : '' %>">
        <i class="fas fa-shopping-bag"></i> <span>Vendas</span>
        <% if (typeof adminPendingSales !== 'undefined' && adminPendingSales > 0) { %><span class="badge-msg" style="background:#f44336;"><%= adminPendingSales %></span><% } %>
      </a>
      <a href="/admin/financeiro" class="<%= currentPath.startsWith('/admin/financeiro') ? 'active' : '' %>">
        <i class="fas fa-coins"></i> <span>Financeiro</span>
        <% if (typeof adminPendingPayouts !== 'undefined' && adminPendingPayouts > 0) { %><span class="badge-msg" style="background:#e65100;"><%= adminPendingPayouts %></span><% } %>
      </a>
      <a href="/admin/cupons" class="<%= currentPath === '/admin/cupons' ? 'active' : '' %>">
        <i class="fas fa-ticket-alt"></i> <span>Cupons</span>
      </a>
      <a href="/admin/ofertas" class="<%= currentPath.startsWith('/admin/ofertas') ? 'active' : '' %>">
        <i class="fas fa-bolt"></i> <span>Ofertas</span>
      </a>
      <a href="/admin/analytics" class="<%= currentPath.startsWith('/admin/analytics') ? 'active' : '' %>">
        <i class="fas fa-chart-line"></i> <span>Analytics</span>
      </a>

      <div class="nav-section-label">Marketing</div>
      <a href="/admin/marketing" class="<%= (currentPath || '').startsWith('/admin/marketing') ? 'active' : '' %>">
        <i class="fas fa-bullhorn"></i> <span>Marketing Central</span>
      </a>

      <a href="/admin/marketing/autopromo" class="sub-link <%= (currentPath || '') === '/admin/marketing/autopromo' ? 'active' : '' %>"><i class="fas fa-bolt"></i> <span>Auto-Promo</span></a>
      <a href="/admin/marketing/campaigns" class="sub-link <%= (currentPath || '') === '/admin/marketing/campaigns' ? 'active' : '' %>"><i class="fas fa-rocket"></i> <span>Campanhas</span></a>
      <a href="/admin/marketing/qrcode" class="sub-link <%= (currentPath || '') === '/admin/marketing/qrcode' ? 'active' : '' %>"><i class="fas fa-qrcode"></i> <span>QR Code</span></a>
      <a href="/admin/marketing/reports" class="sub-link <%= (currentPath || '') === '/admin/marketing/reports' ? 'active' : '' %>"><i class="fas fa-chart-bar"></i> <span>Relatórios</span></a>
      <a href="/admin/blast" class="<%= currentPath === '/admin/blast' ? 'active' : '' %>">
        <i class="fas fa-bullhorn"></i> <span>Notificar Todos</span>
      </a>

      <div class="nav-section-label">Usuários</div>
      <a href="/admin/sellers" class="<%= currentPath === '/admin/sellers' ? 'active' : '' %>">
        <i class="fas fa-store-alt"></i> <span>Vendedores</span>
      </a>
      <a href="/admin/admins" class="<%= currentPath === '/admin/admins' ? 'active' : '' %>">
        <i class="fas fa-users-cog"></i> <span>Admins</span>
      </a>
      <a href="/admin/reviews" class="<%= currentPath.startsWith('/admin/reviews') ? 'active' : '' %>">
        <i class="fas fa-star"></i> <span>Avaliações</span>
      </a>
      <a href="/admin/notifications" class="<%= currentPath.startsWith('/admin/notifications') ? 'active' : '' %>">
        <i class="fas fa-bell"></i> <span>Notificações</span>
      </a>

      <div class="nav-section-label">Sistema</div>
      <a href="/admin/config" class="<%= currentPath === '/admin/config' ? 'active' : '' %>">
        <i class="fas fa-cog"></i> <span>Configurações</span>
      </a>
      <a href="/admin/metas" class="<%= currentPath === '/admin/metas' ? 'active' : '' %>">
        <i class="fas fa-bullseye"></i> <span>Metas</span>
      </a>
      <a href="/admin/placar" class="<%= currentPath === '/admin/placar' ? 'active' : '' %>">
        <i class="fas fa-ranking-star"></i> <span>Placar</span>
      </a>
      <a href="/admin/toggles" class="<%= currentPath === '/admin/toggles' ? 'active' : '' %>">
        <i class="fas fa-toggle-on"></i> <span>Toggles</span>
      </a>
      <a href="/admin/super" class="<%= currentPath === '/admin/super' ? 'active' : '' %>">
        <i class="fas fa-crown"></i> <span>Super Panel</span>
      </a>
      <a href="/admin/logs" class="<%= currentPath === '/admin/logs' ? 'active' : '' %>">
        <i class="fas fa-history"></i> <span>Logs</span>
      </a>
      <a href="/admin/ips-bloqueados" class="<%= currentPath === '/admin/ips-bloqueados' ? 'active' : '' %>">
        <i class="fas fa-ban"></i> <span>IPs Bloqueados</span>
      </a>
      <a href="/admin/senha" class="<%= currentPath === '/admin/senha' ? 'active' : '' %>">
        <i class="fas fa-key"></i> <span>Alterar Senha</span>
      </a>
      <a href="/admin/limpar" class="<%= currentPath === '/admin/limpar' ? 'active' : '' %>">
        <i class="fas fa-broom"></i> <span>Limpar Dados</span>
      </a>
      <a href="/admin/diagnostico" class="<%= currentPath.indexOf('/admin/diagnostico') === 0 ? 'active' : '' %>">
        <i class="fas fa-stethoscope"></i> <span>Diagnóstico</span>
      </a>
      <a href="/admin/ai-audit" class="<%= currentPath.indexOf('/admin/ai-audit') === 0 ? 'active' : '' %>" style="background:linear-gradient(90deg,rgba(155,89,182,0.25),rgba(108,52,131,0.1));border:1px solid rgba(215,161,249,0.4);border-radius:8px;margin:2px 8px;">
        <i class="fas fa-robot" style="color:#d7a1f9;"></i> <span>Auditoria IA</span>
        <span style="margin-left:auto;background:#9b59b6;color:#fff;font-size:9px;padding:1px 6px;border-radius:8px;font-weight:700;">IA</span>
      </a>
      <a href="/admin/seguranca" class="<%= currentPath === '/admin/seguranca' ? 'active' : '' %>">
        <i class="fas fa-shield-alt"></i> <span>Segurança</span>
      </a>
      <a href="/admin/database" class="<%= currentPath === '/admin/database' ? 'active' : '' %>">
        <i class="fas fa-database"></i> <span>Banco de Dados</span>
      </a>
      <a href="/admin/backup" class="<%= currentPath === '/admin/backup' ? 'active' : '' %>">
        <i class="fas fa-file-archive"></i> <span>Backup</span>
      </a>

      <% if (!admin && seller) { %>
      <div class="nav-section-label">Vendedor</div>
      <a href="/seller/sales" class="<%= currentPath === '/seller/sales' ? 'active' : '' %>">
        <i class="fas fa-shopping-bag"></i> <span>Vendas</span>
      </a>
      <a href="/seller/coupons" class="<%= currentPath === '/seller/coupons' ? 'active' : '' %>">
        <i class="fas fa-ticket-alt"></i> <span>Cupons</span>
      </a>
      <a href="/seller/wallet" class="<%= currentPath === '/seller/wallet' ? 'active' : '' %>">
        <i class="fas fa-wallet"></i> <span>Carteira</span>
      </a>
      <% } %>
    </nav>

    <div class="sidebar-footer">
      <a href="/" target="_blank" class="sidebar-link">
        <i class="fas fa-external-link-alt"></i> Ver Site
      </a>
      <a href="/admin/logout" class="sidebar-link logout">
        <i class="fas fa-sign-out-alt"></i> Sair
      </a>
      <div style="font-size:10px;color:rgba(255,255,255,0.3);padding:4px 0 0;line-height:1.7;">
        <span class="kbd-hint">/</span> buscar &middot; <span class="kbd-hint">g</span>+<span class="kbd-hint">d</span> dashboard
      </div>
    </div>
  </aside>

  <div class="admin-main">
    <div class="cmd-statusbar">
      <span class="cmd-led"></span>
      <span class="cmd-item"><span class="cmd-label">SYS.ONLINE</span></span>
      <span class="cmd-sep">|</span>
      <span class="cmd-item"><i class="fas fa-user-shield"></i> <span id="cmdAdmin">admin</span></span>
      <span class="cmd-sep">|</span>
      <span class="cmd-item"><i class="fas fa-clock"></i> <span id="cmdClock">--:--:--</span></span>
      <span class="cmd-sep">|</span>
      <span class="cmd-item"><i class="fas fa-database"></i> <span id="cmdSess"><%= session && session.adminId ? 'SES#' + String(session.adminId).padStart(4,'0') : '—' %></span></span>
      <span class="cmd-sep" style="flex:1;"></span>
      <span class="cmd-item" style="color:var(--hack-cyan);"><%= (currentPath || '/admin/dashboard').replace('/admin/','').toUpperCase() %></span>
    </div>
    <script>
    (function() {
      var c = document.getElementById('cmdClock');
      if (c) {
        function tick() {
          var d = new Date();
          c.textContent = String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0') + ':' + String(d.getSeconds()).padStart(2,'0');
        }
        tick();
        setInterval(tick, 1000);
      }
    })();
    </script>
    <div style="display:flex;align-items:center;gap:8px;">
    <button class="sidebar-toggle" title="Menu" aria-label="Menu">
      <i class="fas fa-bars"></i>
    </button>
      <div class="notif-bell" style="position:relative;margin-left:auto;">
        <a href="/admin/notifications" style="color:#666;font-size:18px;position:relative;display:inline-block;padding:6px;">
          <i class="fas fa-bell"></i>
          <span id="adminNotifBadge" style="display:none;position:absolute;top:0;right:0;background:#e53935;color:#fff;font-size:10px;font-weight:700;min-width:16px;height:16px;border-radius:8px;text-align:center;line-height:16px;padding:0 4px;border:2px solid #fff;"></span>
        </a>
      </div>
    </div>
    <script>
    (function() {
      function fetchNotifCount() {
        var x = new XMLHttpRequest();
        x.onload = function() {
          if (x.status === 200) {
            try {
              var d = JSON.parse(x.responseText);
              var badge = document.getElementById('adminNotifBadge');
              if (d.count > 0) { badge.style.display = 'inline'; badge.textContent = d.count > 99 ? '99+' : d.count; }
              else { badge.style.display = 'none'; }
            } catch(e) {}
          }
        };
        x.open('GET', '/admin/notifications/count', true);
        x.send();
      }
      fetchNotifCount();
      setInterval(fetchNotifCount, 15000);
    })();
    </script>
