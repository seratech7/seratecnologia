<%- include('partials/header') %>

<div class="marketplace-container" style="padding:32px 16px;max-width:820px;margin:0 auto;">
  <article style="background:var(--card-bg);border:1px solid var(--hack-border);border-radius:14px;overflow:hidden;">
    <% if (article.image) { %><img src="<%= article.image %>" alt="<%= article.title %>" style="width:100%;max-height:360px;object-fit:cover;"><% } %>
    <div style="padding:24px;">
      <span class="status-badge active" style="font-size:12px;"><%= article.category %></span>
      <h1 style="font-size:28px;margin:12px 0 8px;line-height:1.25;"><%= article.title %></h1>
      <p style="color:var(--hack-dim);font-size:13px;margin:0 0 16px;">
        <i class="far fa-eye"></i> <%= article.views || 0 %> visualizações · <%= new Date(article.created_at).toLocaleDateString('pt-BR') %>
        <% if (article.author) { %> · por <%= article.author %><% } %>
      </p>
      <div style="font-size:15px;line-height:1.7;color:var(--text);">
        <%- article.content %>
      </div>
    </div>
  </article>

  <% if (related && related.length > 0) { %>
  <section style="margin-top:36px;">
    <h2 style="font-size:20px;margin-bottom:16px;"><i class="fas fa-thumbs-up"></i> Leia também</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;">
      <% related.forEach(function(n) { %>
        <a href="/noticia/<%= n.slug %>" style="text-decoration:none;color:inherit;background:var(--card-bg);border:1px solid var(--hack-border);border-radius:10px;padding:14px;">
          <h4 style="margin:0 0 6px;font-size:15px;line-height:1.3;"><%= n.title %></h4>
          <span style="font-size:12px;color:var(--hack-dim);"><%= n.category %></span>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>
</div>

<%- include('partials/footer') %>
