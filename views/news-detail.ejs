<%- include('partials/header') %>

<style>
.news-detail-page {
  --nbg: #f5f7fb;
  --ntext: #0d1b2a;
  --ndim: #6b7280;
  --ncard: #ffffff;
  --nborder: #e6e9ef;
  --nshadow: 0 6px 24px rgba(13, 27, 42, 0.08);
  background: var(--nbg);
  min-height: calc(100vh - var(--header-height));
  padding-bottom: 48px;
}
body.hacker-theme .news-detail-page {
  --nbg: #05070d;
  --ntext: #c8d6e5;
  --ndim: #5a6c85;
  --ncard: #0c1322;
  --nborder: #1c2a3f;
  --nshadow: 0 6px 24px rgba(0, 0, 0, 0.4);
}

.nd-wrap { max-width: 860px; margin: 0 auto; padding: 28px 16px; }

.nd-back {
  display: inline-flex; align-items: center; gap: 8px;
  color: var(--ndim); font-size: 14px; font-weight: 600; margin-bottom: 18px;
  transition: color .15s;
}
.nd-back:hover { color: var(--primary); }

.nd-article {
  background: var(--ncard); border: 1px solid var(--nborder);
  border-radius: 16px; overflow: hidden; box-shadow: var(--nshadow);
}
.nd-cover {
  position: relative; width: 100%; height: 340px; overflow: hidden;
  background: linear-gradient(135deg, #1e3a8a, #0ea5e9);
}
.nd-cover img { width: 100%; height: 100%; object-fit: cover; }
.nd-cover .nd-cat {
  position: absolute; top: 16px; left: 16px;
  background: rgba(0,102,255,0.92); color: #fff;
  font-size: 11px; font-weight: 700; letter-spacing: .5px;
  padding: 6px 13px; border-radius: 20px; text-transform: uppercase;
}
.nd-cover .nd-cat.empty-icon { background: rgba(255,255,255,0.18); backdrop-filter: blur(4px); }

.nd-content { padding: 28px 30px 34px; }
.nd-cat-pill {
  display: inline-block; background: var(--nchip, #eef2ff); color: var(--primary);
  font-size: 12px; font-weight: 700; letter-spacing: .5px;
  padding: 5px 13px; border-radius: 20px; text-transform: uppercase; margin-bottom: 14px;
}
.nd-title { font-size: 30px; line-height: 1.25; margin: 0 0 14px; font-weight: 800; color: var(--ntext); }
.nd-meta {
  display: flex; flex-wrap: wrap; align-items: center; gap: 16px;
  font-size: 13px; color: var(--ndim); padding-bottom: 18px; margin-bottom: 22px;
  border-bottom: 1px solid var(--nborder);
}
.nd-meta span { display: inline-flex; align-items: center; gap: 6px; }
.nd-meta .nd-author { font-weight: 600; color: var(--ntext); }

.nd-prose { font-size: 16px; line-height: 1.75; color: var(--ntext); white-space: pre-line; }
.nd-prose p { margin: 0 0 1em; }
.nd-prose h2, .nd-prose h3 { margin: 1.2em 0 .5em; line-height: 1.3; }
.nd-prose a { color: var(--primary); }
.nd-prose img { border-radius: 10px; margin: 1em 0; }
.nd-prose code {
  background: var(--nbg); padding: 2px 6px; border-radius: 5px;
  font-family: monospace; font-size: 14px;
}
.nd-prose blockquote {
  border-left: 3px solid var(--primary); padding: 4px 16px; margin: 1em 0;
  color: var(--ndim); font-style: italic;
}

.nd-related { margin-top: 40px; }
.nd-related h2 {
  font-size: 14px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
  color: var(--ndim); margin: 0 0 16px; display: flex; align-items: center; gap: 8px;
}
.nd-related h2::before { content: ""; width: 4px; height: 16px; border-radius: 3px; background: var(--primary); }
.nd-rel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
.nd-rel-card {
  display: flex; flex-direction: column; text-decoration: none; color: var(--ntext);
  background: var(--ncard); border: 1px solid var(--nborder); border-radius: 12px;
  overflow: hidden; box-shadow: var(--nshadow); transition: transform .18s, border-color .18s;
}
.nd-rel-card:hover { transform: translateY(-3px); border-color: var(--primary); }
.nd-rel-thumb { height: 120px; background: linear-gradient(135deg, #1e3a8a, #0ea5e9); position: relative; overflow: hidden; }
.nd-rel-thumb img { width: 100%; height: 100%; object-fit: cover; }
.nd-rel-thumb .nd-cat { position: absolute; top: 10px; left: 10px; background: rgba(0,102,255,0.92); color: #fff; font-size: 10px; font-weight: 700; padding: 4px 9px; border-radius: 16px; text-transform: uppercase; }
.nd-rel-body { padding: 13px 14px; }
.nd-rel-body h4 { margin: 0 0 6px; font-size: 14.5px; line-height: 1.35; font-weight: 700; }
.nd-rel-body span { font-size: 12px; color: var(--ndim); }

.nd-reactions {
  display: flex; flex-wrap: wrap; gap: 10px; align-items: center;
  margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--nborder);
}
.nd-reactions-label { font-size: 13px; color: var(--ndim); margin-right: 4px; font-weight: 600; }
.nd-react {
  display: inline-flex; align-items: center; gap: 7px;
  border: 1px solid var(--nborder); background: var(--ncard); color: var(--ntext);
  padding: 8px 14px; border-radius: 24px; cursor: pointer; font-size: 14px;
  transition: all .15s; user-select: none;
}
.nd-react:hover { border-color: var(--primary); transform: translateY(-2px); }
.nd-react .nd-emoji { font-size: 17px; line-height: 1; }
.nd-react .nd-count { font-weight: 700; font-size: 13px; min-width: 10px; }
.nd-react.active {
  background: var(--primary); color: #fff; border-color: var(--primary);
  box-shadow: 0 4px 12px rgba(0,102,255,0.35);
}
.nd-react.active .nd-count { color: #fff; }
.nd-views-badge {
  margin-left: auto; display: inline-flex; align-items: center; gap: 6px;
  font-size: 13px; color: var(--ndim); background: var(--nchip, #eef2ff);
  padding: 8px 14px; border-radius: 24px;
}
</style>

<div class="news-detail-page">
  <div class="nd-wrap">
    <a class="nd-back" href="/noticias"><i class="fas fa-arrow-left"></i> Voltar às notícias</a>

    <article class="nd-article">
      <div class="nd-cover">
        <% var dimg = article.image || ('https://picsum.photos/seed/' + encodeURIComponent(article.slug) + '/1000/600'); %>
        <img src="<%= dimg %>" alt="<%= article.title %>" loading="lazy" onerror="this.style.display='none';">
        <span class="nd-cat"><%= article.category %></span>
      </div>
      <div class="nd-content">
        <span class="nd-cat-pill"><%= article.category %></span>
        <h1 class="nd-title"><%= article.title %></h1>
        <div class="nd-meta">
          <span><i class="far fa-calendar"></i> <%= new Date(article.created_at).toLocaleDateString('pt-BR') %></span>
          <span><i class="far fa-eye"></i> <%= article.views || 0 %> visualizações</span>
          <% if (article.author) { %><span class="nd-author"><i class="far fa-user"></i> <%= article.author %></span><% } %>
        </div>
        <div class="nd-prose"><%- article.content %></div>

        <div class="nd-reactions" id="nd-reactions">
          <span class="nd-reactions-label">Esta notícia foi útil?</span>
          <button class="nd-react" data-type="like"><span class="nd-emoji">👍</span><span class="nd-count">0</span></button>
          <button class="nd-react" data-type="love"><span class="nd-emoji">❤️</span><span class="nd-count">0</span></button>
          <button class="nd-react" data-type="haha"><span class="nd-emoji">😂</span><span class="nd-count">0</span></button>
          <button class="nd-react" data-type="wow"><span class="nd-emoji">😮</span><span class="nd-count">0</span></button>
          <button class="nd-react" data-type="sad"><span class="nd-emoji">😢</span><span class="nd-count">0</span></button>
          <button class="nd-react" data-type="angry"><span class="nd-emoji">😡</span><span class="nd-count">0</span></button>
          <span class="nd-views-badge"><i class="far fa-eye"></i> <%= article.views || 0 %> visualizações</span>
        </div>
      </div>
    </article>

    <% if (related && related.length > 0) { %>
    <section class="nd-related">
      <h2><i class="fas fa-thumbs-up"></i> Leia também</h2>
      <div class="nd-rel-grid">
        <% related.forEach(function(n) { %>
          <a href="/noticia/<%= n.slug %>" class="nd-rel-card">
            <div class="nd-rel-thumb">
              <% if (n.image) { %><img src="<%= n.image %>" alt="<%= n.title %>"><% } %>
              <span class="nd-cat"><%= n.category %></span>
            </div>
            <div class="nd-rel-body">
              <h4><%= n.title %></h4>
              <span><%= new Date(n.created_at).toLocaleDateString('pt-BR') %></span>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>
  </div>
</div>

<script>
(function () {
  var box = document.getElementById('nd-reactions');
  if (!box) return;
  var initial = <%- JSON.stringify(reactions || {}) %>;
  var userReact = <%- (userReaction ? JSON.stringify(userReaction) : 'null') %>;
  var btns = box.querySelectorAll('.nd-react');
  function paint(counts, active) {
    btns.forEach(function (b) {
      var t = b.getAttribute('data-type');
      var c = (counts && counts[t]) ? counts[t] : 0;
      b.querySelector('.nd-count').textContent = c;
      if (active && t === active) b.classList.add('active');
      else b.classList.remove('active');
    });
  }
  paint(initial, userReact);
  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      var type = b.getAttribute('data-type');
      var isActive = b.classList.contains('active');
      var action = isActive ? 'remove' : 'add';
      var url = window.location.pathname.replace(/\/$/, '') + '/react';
      var body = 'type=' + encodeURIComponent(type) + '&action=' + action;
      var csrfMeta = document.querySelector('meta[name="csrf-token"]');
      var headers = { 'Content-Type': 'application/x-www-form-urlencoded' };
      if (csrfMeta) headers['x-csrf-token'] = csrfMeta.content;
      fetch(url, {
        method: 'POST',
        headers: headers,
        body: body
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data && data.reactions) paint(data.reactions, isActive ? null : type);
      })
      .catch(function () {});
    });
  });
})();
</script>

<%- include('partials/footer') %>
