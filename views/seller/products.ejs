<%- include('../partials/seller-header') %>
<div class="admin-content">
  <div class="page-header">
    <h1><i class="fas fa-box"></i> Meus Produtos</h1>
    <a href="/seller/products/new" class="btn-primary"><i class="fas fa-plus"></i> Novo Produto</a>
  </div>
  <div style="margin-bottom:10px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
    <a href="/seller/products" class="btn-secondary" style="font-size:13px;padding:6px 12px;<%= filter === 'all' || !filter ? 'background:var(--primary);color:#fff;' : '' %>">Todos</a>
    <a href="/seller/products?filter=active" class="btn-secondary" style="font-size:13px;padding:6px 12px;<%= filter === 'active' ? 'background:var(--primary);color:#fff;' : '' %>">Ativos</a>
    <a href="/seller/products?filter=pending" class="btn-secondary" style="font-size:13px;padding:6px 12px;<%= filter === 'pending' ? 'background:var(--primary);color:#fff;' : '' %>">Pendentes</a>
    <a href="/seller/products?filter=rejected" class="btn-secondary" style="font-size:13px;padding:6px 12px;<%= filter === 'rejected' ? 'background:var(--primary);color:#fff;' : '' %>">Rejeitados</a>
    <a href="/seller/products?filter=lowstock" class="btn-secondary" style="font-size:13px;padding:6px 12px;color:#e65100;<%= filter === 'lowstock' ? 'background:#e65100;color:#fff;' : '' %>"><i class="fas fa-exclamation-triangle"></i> Estoque Baixo</a>
    <form method="GET" action="/seller/products" style="display:flex;gap:4px;margin-left:auto;">
      <input type="hidden" name="filter" value="<%= filter %>">
      <input type="text" name="search" placeholder="Buscar produto..." value="<%= search || '' %>" style="padding:5px 10px;border:1px solid #ddd;border-radius:4px;font-size:13px;width:180px;">
      <button type="submit" class="btn-primary" style="padding:5px 12px;font-size:13px;"><i class="fas fa-search"></i></button>
      <% if (search) { %><a href="/seller/products?filter=<%= filter %>" class="btn-secondary" style="padding:5px 10px;font-size:13px;"><i class="fas fa-times"></i></a><% } %>
    </form>
  </div>
  <div class="table-container">
    <table class="admin-table">
      <thead><tr><th>Produto</th><th>Preço</th><th>Estoque</th><th>Categoria</th><th>Status</th><th>Data</th><th>Ações</th></tr></thead>
      <tbody>
        <% if (products.length === 0) { %><tr><td colspan="7" class="empty-row">Nenhum produto encontrado</td></tr><% } %>
        <% products.forEach(p => { %>
          <tr>
            <td class="product-cell">
              <div class="product-cell-info">
                <% if (p.image) { %><img src="<%= p.image %>" alt="" class="thumb"><% } else { %><div class="thumb thumb-placeholder"><i class="fas fa-image"></i></div><% } %>
                <span class="product-name-cell"><%= p.name %></span>
              </div>
            </td>
            <td class="price-cell"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(p.price) %></td>
            <td style="text-align:center;"><span style="background:<%= (p.quantity||0) > 5 ? '#e8f5e9' : (p.quantity||0) > 0 ? '#fff3e0' : '#fdecea' %>;color:<%= (p.quantity||0) > 5 ? '#2e7d32' : (p.quantity||0) > 0 ? '#e65100' : '#c62828' %>;padding:2px 10px;border-radius:12px;font-size:13px;font-weight:600;"><%= p.quantity || 0 %></span></td>
            <td><%= p.category_name || '-' %></td>
            <td>
              <% if (p.status === 'active') { %><span class="status-badge active">Aprovado</span>
              <% } else if (p.status === 'pending') { %><span class="status-badge" style="background:#fff3cd;color:#856404;">Pendente</span>
              <% } else if (p.status === 'rejected') { %><span class="status-badge" style="background:#fdecea;color:#e74c3c;">Rejeitado</span>
              <% } else { %><span class="status-badge inactive">Inativo</span><% } %>
              <% if (p.status === 'rejected' && p.rejection_reason) { %><div style="font-size:11px;color:#c62828;margin-top:2px;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= p.rejection_reason %>"><i class="fas fa-comment"></i> <%= p.rejection_reason %></div><% } %>
            </td>
            <td><%= new Date(p.created_at).toLocaleDateString('pt-BR') %></td>
            <td class="actions-cell">
              <a href="/seller/products/edit/<%= p.id %>" class="btn-icon" title="Editar"><i class="fas fa-edit"></i></a>
              <% if (p.status === 'active') { %><a href="/product/<%= p.code || p.id %>" target="_blank" class="btn-icon" style="color:#2196f3;" title="Ver na loja"><i class="fas fa-external-link-alt"></i></a><% } %>
              <form action="/seller/products/clone/<%= p.id %>" method="POST" class="inline-form">
                <button type="submit" class="btn-icon" style="color:#7c4dff;" title="Clonar"><i class="fas fa-copy"></i></button>
              </form>
              <% if (p.status === 'rejected') { %>
                <form action="/seller/products/review-request/<%= p.id %>" method="POST" class="inline-form">
                  <button type="submit" class="btn-icon" style="color:#e65100;" title="Solicitar revisão"><i class="fas fa-sync"></i></button>
                </form>
              <% } %>
              <form action="/seller/products/delete/<%= p.id %>" method="POST" class="inline-form" onsubmit="return confirm('Excluir?')">
                <button type="submit" class="btn-icon btn-delete" title="Excluir"><i class="fas fa-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/seller-footer') %>
