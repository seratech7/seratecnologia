<%- include('../partials/seller-header') %>
<div class="admin-content">
  <div class="page-header">
    <h1><i class="fas fa-bell"></i> Notificações</h1>
    <% if (notifications && notifications.length > 0) { %>
      <form method="POST" action="/seller/notifications/read-all" style="display:inline;">
        <button class="btn-primary" style="font-size:13px;padding:6px 14px;"><i class="fas fa-check-double"></i> Marcar todas como lidas</button>
      </form>
    <% } %>
  </div>
  <div style="max-width:700px;">
    <% if (!notifications || notifications.length === 0) { %>
      <div style="text-align:center;padding:60px 20px;color:#999;">
        <i class="fas fa-bell-slash" style="font-size:48px;opacity:0.3;display:block;margin-bottom:12px;"></i>
        <p>Nenhuma notificação</p>
      </div>
    <% } else { %>
      <% notifications.forEach(function(n) { %>
        <div style="background:<%= n.read ? '#fff' : '#f0f7ff' %>;border:1px solid <%= n.read ? '#eee' : '#bbdefb' %>;border-radius:8px;padding:12px 16px;margin-bottom:8px;display:flex;align-items:center;gap:12px;">
          <div style="width:36px;height:36px;border-radius:50%;background:<%= n.type === 'danger' ? '#fdecea' : n.type === 'success' ? '#e8f5e9' : '#e3f2fd' %>;display:flex;align-items:center;justify-content:center;color:<%= n.type === 'danger' ? '#c62828' : n.type === 'success' ? '#2e7d32' : '#1565c0' %>;flex-shrink:0;">
            <i class="fas fa-<%= n.icon || 'bell' %>"></i>
          </div>
          <div style="flex:1;min-width:0;">
            <div style="font-size:14px;color:#333;"><%= n.message %></div>
            <div style="font-size:11px;color:#999;margin-top:2px;"><%= new Date(n.created_at).toLocaleString('pt-BR') %></div>
          </div>
          <div style="display:flex;gap:4px;flex-shrink:0;">
            <% if (n.link) { %><a href="<%= n.link %>" class="btn-icon" style="color:#1976d2;" title="Abrir"><i class="fas fa-external-link-alt"></i></a><% } %>
            <% if (!n.read) { %><form method="POST" action="/seller/notifications/read/<%= n.id %>" style="display:inline;"><button type="submit" class="btn-icon" style="color:#4caf50;" title="Marcar lida"><i class="fas fa-check"></i></button></form><% } %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
<%- include('../partials/seller-footer') %>
