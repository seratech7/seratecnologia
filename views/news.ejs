<%- include('partials/header') %>

<% function catClass(c){ return 'cat-' + String(c||'').replace(/[^a-z0-9]/gi,''); }
   function isNewNews(d){ try { return (Date.now() - new Date(d).getTime()) < 172800000; } catch(e){ return false; } }
   function readTimeNews(c){ var w=(c||'').split(/\s+/).filter(Boolean).length; return Math.max(1, Math.round(w/200)); }
   function sizeFor(i){ var m=i%5; return m===0?'size-lg':(m===3?'size-tall':''); }
   function colorFor(cat){
     var map={Hacking:'#ff4d4f',Games:'#7c3aed',Tecnologia:'#00b894','Seguranca':'#ff7849','Segurança':'#ff7849','Ciencia':'#0984e3','Ciência':'#0984e3',Hardware:'#e17055',Software:'#6c5ce7'};
     if(map[cat]) return map[cat];
     var h=0,s=String(cat||'Geral'); for(var i=0;i<s.length;i++) h=(h*31+s.charCodeAt(i))>>>0;
     var pal=['#ff4d4f','#7c3aed','#00b894','#0984e3','#e17055','#fdcb6e','#00cec9','#e84393'];
     return pal[h%pal.length];
   }
   function imgFor(n, s){
     if (n.image && n.image.indexOf('/') === 0) return n.image;
     var dims = s === 'size-lg' ? [800, 500] : (s === 'size-tall' ? [600, 800] : [600, 400]);
     return '/img/news-thumb?cat=' + encodeURIComponent(n.category || 'Geral') + '&w=' + dims[0] + '&h=' + dims[1];
   }
   function ytId(v){ if(!v) return ''; var m=String(v).match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/); return m?m[1]:''; }
   var gridNews = news.filter(function(n){ return !(n.featured && !selectedCategory); });
   var galleryVideos = (typeof videos !== 'undefined' && videos) ? videos.filter(function(v){ return v && v.video; }) : [];
   var trendingList = (typeof trending !== 'undefined' && trending) ? trending : [];
%>

<style>
.news-page {
  --nbg: #f5f7fb; --ntext: #0d1b2a; --ndim: #6b7280; --ncard: #ffffff;
  --nborder: #e6e9ef; --nchip: #eef2ff; --nchip-text: #2a3b55; --nshadow: 0 6px 24px rgba(13,27,42,0.08);
  --naccent: #0066ff;
  background: var(--nbg); min-height: calc(100vh - var(--header-height)); padding-bottom: 56px;
}
body.hacker-theme .news-page {
  --nbg: #05070d; --ntext: #c8d6e5; --ndim: #5a6c85; --ncard: #0c1322;
  --nborder: #1c2a3f; --nchip: #101a2e; --nchip-text: #9fb3d1; --nshadow: 0 6px 24px rgba(0,0,0,0.4);
  --naccent: #00e676;
}
.news-card, .news-chip { --cc: var(--naccent); }

/* Cores por categoria (definidas inline via colorFor no template, com fallback) */

.news-hero {
  background: linear-gradient(135deg, #0066ff 0%, #0047b3 55%, #0a1628 100%);
  color: #fff; padding: 48px 24px 36px; position: relative; overflow: hidden;
}
body.hacker-theme .news-hero { background: linear-gradient(135deg, #062a1f 0%, #04141f 55%, #020308 100%); border-bottom: 1px solid #1c2a3f; }
.news-hero::before {
  content:""; position:absolute; inset:0;
  background-image: linear-gradient(rgba(255,255,255,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.07) 1px, transparent 1px);
  background-size: 42px 42px; opacity:.6;
}
.news-hero::after { content:""; position:absolute; right:-60px; top:-60px; width:260px; height:260px; background: radial-gradient(circle, rgba(255,255,255,0.16), transparent 70%); border-radius:50%; }
.news-hero-inner { max-width:1400px; margin:0 auto; position:relative; z-index:1; }
.news-kicker { display:inline-block; font-size:12px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; background:rgba(255,255,255,0.15); padding:5px 12px; border-radius:20px; margin-bottom:12px; }
.news-hero h1 { font-size:40px; line-height:1.1; margin:0 0 8px; font-weight:800; display:flex; align-items:center; gap:12px; }
.news-hero p { margin:0 0 20px; opacity:.88; font-size:15px; max-width:620px; line-height:1.55; }
.news-search { display:flex; align-items:center; gap:8px; background:rgba(255,255,255,0.96); border-radius:12px; padding:6px 6px 6px 14px; max-width:480px; box-shadow:0 8px 24px rgba(0,0,0,0.18); }
.news-search i { color:#415a77; }
.news-search input { flex:1; border:0; outline:0; background:transparent; font-size:14px; color:#0d1b2a; padding:8px 4px; }
.news-search input::placeholder { color:#778da9; }
.news-search button { border:0; background:var(--primary); color:#fff; padding:10px 18px; border-radius:9px; font-weight:600; cursor:pointer; transition:background .15s; }
.news-search button:hover { background:var(--primary-dark); }

.news-filters {
  position:sticky; top:var(--header-height); z-index:50; display:flex; gap:10px; flex-wrap:wrap; align-items:center;
  max-width:1400px; margin:0 auto; padding:16px 24px;
  background: color-mix(in srgb, var(--nbg) 88%, transparent); backdrop-filter: blur(8px); border-bottom:1px solid var(--nborder);
}
.news-chip {
  display:inline-flex; align-items:center; gap:7px; border:1px solid var(--nborder); background:var(--nchip);
  color:var(--nchip-text); padding:9px 16px; border-radius:30px; font-size:13.5px; font-weight:600; cursor:pointer; transition:all .15s; text-decoration:none;
}
.news-chip i { color: var(--cc, var(--naccent)); }
.news-chip .chip-count { background: var(--cc, var(--naccent)); color:#fff; border-radius:20px; padding:1px 8px; font-size:11px; font-weight:700; }
.news-chip:hover { border-color:var(--cc, var(--naccent)); color:var(--cc, var(--naccent)); }
.news-chip.active { background:var(--cc, var(--naccent)); color:#fff; border-color:var(--cc, var(--naccent)); box-shadow:0 4px 12px color-mix(in srgb, var(--cc, var(--naccent)) 35%, transparent); }
.news-chip.active i, .news-chip.active .chip-count { color:#fff; }
.news-filter-hint { margin-left:auto; font-size:12.5px; color:var(--ndim); }

.news-section-title { font-size:14px; font-weight:800; letter-spacing:1px; text-transform:uppercase; color:var(--ndim); margin:30px 0 16px; display:flex; align-items:center; gap:8px; }
.news-section-title::before { content:""; width:4px; height:16px; border-radius:3px; background:var(--naccent); }

.news-layout { display:grid; grid-template-columns: 300px 1fr; gap: 28px; max-width:1400px; margin:0 auto; padding: 26px 24px 0; align-items:start; }
.news-sidebar { position:sticky; top: calc(var(--header-height) + 72px); }
.news-main { min-width:0; }

.news-side-panel { background:var(--ncard); border:1px solid var(--nborder); border-radius:16px; padding:16px; box-shadow:var(--nshadow); }
.news-side-title { font-size:13px; font-weight:800; letter-spacing:.6px; text-transform:uppercase; color:var(--ntext); margin:0 0 14px; display:flex; align-items:center; gap:8px; }
.news-side-title i { color:#ff7849; }
.news-trending { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:6px; }
.news-trend-row { display:flex; gap:12px; align-items:center; text-decoration:none; padding:8px; border-radius:12px; transition:background .15s; }
.news-trend-row:hover { background: color-mix(in srgb, var(--cc, var(--naccent)) 12%, transparent); }
.news-rank { flex:0 0 26px; height:26px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px; background: color-mix(in srgb, var(--naccent) 16%, transparent); color:var(--naccent); }
.news-trend-thumb { flex:0 0 56px; height:56px; border-radius:10px; overflow:hidden; background:linear-gradient(135deg,#1e3a8a,#0ea5e9); }
.news-trend-thumb img { width:100%; height:100%; object-fit:cover; }
.news-trend-info { display:flex; flex-direction:column; gap:3px; min-width:0; }
.news-trend-cat { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:var(--cc, var(--naccent)); }
.news-trend-title { font-size:13px; font-weight:700; color:var(--ntext); line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.news-trend-views { font-size:11px; color:var(--ndim); display:flex; align-items:center; gap:4px; }

.news-featured-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); grid-auto-flow:dense; gap:18px; }
.news-featured-grid .news-card.size-lg { grid-column:span 2; }

.news-grid {
  display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); grid-auto-flow:dense; gap:18px;
}
.news-card {
  display:flex; flex-direction:column; text-decoration:none; color:var(--ntext); background:var(--ncard);
  border:1px solid var(--nborder); border-radius:14px; overflow:hidden; box-shadow:var(--nshadow);
  transition:transform .18s, box-shadow .18s, border-color .18s; animation:fadeUp .4s ease both;
}
@keyframes fadeUp { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:none; } }
.news-card:hover { transform:translateY(-4px); box-shadow:0 12px 32px rgba(13,27,42,0.14); border-color:var(--cc); }
.news-card.size-lg { grid-column:span 2; }
.news-card.size-tall { grid-row:span 2; }
.news-thumb { position:relative; width:100%; height:180px; overflow:hidden; background:linear-gradient(135deg, #1e3a8a, #0ea5e9); }
.news-card.size-lg .news-thumb { height:300px; }
.news-card.size-tall .news-thumb { height:300px; }
.news-thumb img { width:100%; height:100%; object-fit:cover; transition:transform .3s; }
.news-card:hover .news-thumb img { transform:scale(1.05); }
.news-cat {
  position:absolute; top:12px; left:12px; background:var(--cc); color:#fff;
  font-size:11px; font-weight:700; letter-spacing:.5px; padding:5px 11px; border-radius:20px; text-transform:uppercase;
}
.news-badges { position:absolute; bottom:12px; left:12px; display:flex; gap:6px; flex-wrap:wrap; }
.news-badge { font-size:10px; font-weight:800; letter-spacing:.5px; padding:3px 8px; border-radius:20px; text-transform:uppercase; }
.news-badge.novo { background:#ff4d4f; color:#fff; animation:pulseNovo 1.6s ease-in-out infinite; }
@keyframes pulseNovo { 0%,100% { box-shadow:0 0 0 0 rgba(255,77,79,.5); } 50% { box-shadow:0 0 0 6px rgba(255,77,79,0); } }
.news-badge.time { background:rgba(0,0,0,0.55); color:#fff; backdrop-filter:blur(2px); }
.news-feat-badge { position:absolute; top:12px; right:12px; background:linear-gradient(135deg,#f59e0b,#d97706); color:#fff; font-size:10px; font-weight:800; letter-spacing:.5px; padding:4px 9px; border-radius:20px; text-transform:uppercase; display:inline-flex; align-items:center; gap:4px; box-shadow:0 2px 8px rgba(0,0,0,.3); z-index:3; }
.news-body2 { padding:15px 16px 16px; display:flex; flex-direction:column; flex:1; }
.news-title { font-size:16px; line-height:1.35; margin:0 0 8px; font-weight:700; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.news-card.size-lg .news-title { font-size:22px; }
.news-excerpt { color:var(--ndim); font-size:13.5px; margin:0 0 14px; line-height:1.5; flex:1; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
.news-meta { display:flex; align-items:center; justify-content:space-between; font-size:12px; color:var(--ndim); border-top:1px solid var(--nborder); padding-top:12px; }
.news-meta .news-views { display:inline-flex; align-items:center; gap:5px; }

.news-skeleton { display:none; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); gap:18px; margin-top:18px; }
.news-skeleton .sk { background:var(--ncard); border:1px solid var(--nborder); border-radius:14px; overflow:hidden; }
.news-skeleton .sk-thumb { height:180px; }
.news-skeleton .sk-line { height:12px; margin:12px 14px; border-radius:6px; }
.news-skeleton .sk, .news-skeleton .sk-thumb, .news-skeleton .sk-line {
  background:linear-gradient(90deg, #e9edf3 25%, #f4f6fa 37%, #e9edf3 63%);
  background-size:400% 100%; animation:shimmer 1.3s infinite;
}
body.hacker-theme .news-skeleton .sk, body.hacker-theme .news-skeleton .sk-thumb, body.hacker-theme .news-skeleton .sk-line {
  background:linear-gradient(90deg, #101a2e 25%, #16223a 37%, #101a2e 63%); background-size:400% 100%;
}
@keyframes shimmer { 0% { background-position:100% 0; } 100% { background-position:-100% 0; } }

.news-loadmore { display:block; margin:26px auto; padding:12px 30px; border:1px solid var(--naccent); background:transparent; color:var(--naccent); border-radius:30px; font-weight:700; cursor:pointer; transition:all .15s; }
.news-loadmore:hover { background:var(--naccent); color:#fff; }
.news-loadmore:disabled { opacity:.6; cursor:default; }
#news-sentinel { height:1px; }

/* === Melhorias visuais e de usabilidade === */
.news-hero-top { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; flex-wrap:wrap; }
.news-hero-stats { display:flex; gap:12px; }
.news-stat { background:rgba(255,255,255,0.13); border:1px solid rgba(255,255,255,0.2); border-radius:14px; padding:10px 16px; text-align:center; min-width:82px; backdrop-filter:blur(4px); }
.news-stat-num { display:block; font-size:22px; font-weight:800; line-height:1; }
.news-stat-lbl { display:block; font-size:10.5px; text-transform:uppercase; letter-spacing:.6px; opacity:.85; margin-top:5px; }
body.hacker-theme .news-stat { background:rgba(0,230,118,0.08); border-color:rgba(0,230,118,0.25); }

.news-controls { display:flex; gap:10px; margin-top:18px; flex-wrap:wrap; align-items:center; }
.news-viewtoggle { display:inline-flex; background:rgba(255,255,255,0.14); border-radius:10px; padding:4px; gap:4px; }
.news-viewtoggle button { border:0; background:transparent; color:#fff; width:38px; height:34px; border-radius:8px; cursor:pointer; font-size:14px; opacity:.8; transition:all .15s; }
.news-viewtoggle button.active { background:#fff; color:var(--naccent); opacity:1; box-shadow:0 4px 12px rgba(0,0,0,.2); }
body.hacker-theme .news-viewtoggle button.active { background:#00e676; color:#04140d; }
.news-sort { display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,0.14); border-radius:10px; padding:0 12px 0 14px; color:#fff; font-size:13px; font-weight:600; }
.news-sort select { border:0; background:transparent; color:#fff; font-weight:700; font-size:13px; padding:9px 4px; outline:0; cursor:pointer; }
.news-sort select option { color:#0d1b2a; }

/* Lista (modo lista) */
.news-grid.list-view { grid-template-columns:1fr; }
.news-grid.list-view .news-card { flex-direction:row; align-items:stretch; }
.news-grid.list-view .news-card.size-lg, .news-grid.list-view .news-card.size-tall { grid-column:auto; grid-row:auto; }
.news-grid.list-view .news-thumb { width:280px; flex:0 0 280px; height:auto; min-height:172px; }
.news-grid.list-view .news-card.size-lg .news-thumb, .news-grid.list-view .news-card.size-tall .news-thumb { height:auto; }
.news-grid.list-view .news-body2 { padding:18px 22px; }
.news-grid.list-view .news-title { font-size:19px; -webkit-line-clamp:1; }
.news-grid.list-view .news-excerpt { -webkit-line-clamp:2; }
@media (max-width:640px){
  .news-grid.list-view .news-card { flex-direction:column; }
  .news-grid.list-view .news-thumb { width:100%; flex:none; height:180px; }
}

/* Autor nos cards */
.news-author { display:flex; align-items:center; gap:8px; }
.news-author-ava { width:26px; height:26px; border-radius:50%; background:var(--cc, var(--naccent)); color:#fff; font-size:11px; font-weight:800; display:flex; align-items:center; justify-content:center; text-transform:uppercase; flex:0 0 auto; }
.news-author-name { font-size:12px; color:var(--ndim); font-weight:600; }

/* Newsletter (sidebar) */
.news-newsletter { margin-top:22px; background:linear-gradient(135deg, var(--naccent), #0047b3); color:#fff; border-radius:16px; padding:20px; box-shadow:var(--nshadow); position:relative; overflow:hidden; }
body.hacker-theme .news-newsletter { background:linear-gradient(135deg, #064e3b, #022c22); }
.news-newsletter::after { content:""; position:absolute; right:-30px; bottom:-30px; width:130px; height:130px; background:radial-gradient(circle, rgba(255,255,255,.22), transparent 70%); border-radius:50%; }
.news-newsletter h4 { margin:0 0 6px; font-size:16px; display:flex; align-items:center; gap:8px; position:relative; z-index:1; }
.news-newsletter p { margin:0 0 14px; font-size:12.5px; opacity:.92; line-height:1.5; position:relative; z-index:1; }
.news-news-form { display:flex; gap:8px; position:relative; z-index:1; }
.news-news-form input { flex:1; min-width:0; border:0; border-radius:9px; padding:10px 12px; font-size:13px; outline:0; color:#0d1b2a; }
.news-news-form button { border:0; background:#0d1b2a; color:#fff; border-radius:9px; padding:10px 16px; font-weight:700; cursor:pointer; font-size:13px; white-space:nowrap; }
body.hacker-theme .news-news-form button { background:#00e676; color:#04140d; }
.news-news-ok { font-size:12.5px; background:rgba(255,255,255,.18); border-radius:9px; padding:10px 12px; display:none; position:relative; z-index:1; }

/* Voltar ao topo */
.news-totop { position:fixed; right:20px; bottom:20px; width:46px; height:46px; border-radius:50%; background:var(--naccent); color:#fff; border:0; cursor:pointer; font-size:18px; box-shadow:0 8px 24px rgba(0,102,255,.4); opacity:0; transform:translateY(12px); pointer-events:none; transition:all .2s; z-index:200; }
.news-totop.show { opacity:1; transform:none; pointer-events:auto; }
.news-totop:hover { transform:translateY(-3px); }
body.hacker-theme .news-totop { background:#00e676; color:#04140d; box-shadow:0 8px 24px rgba(0,230,118,.4); }

.news-empty { display:flex; flex-direction:column; align-items:center; }
.news-empty .news-empty-actions { margin-top:14px; display:flex; gap:10px; flex-wrap:wrap; justify-content:center; }
.news-empty .news-empty-actions a { background:var(--naccent); color:#fff; text-decoration:none; padding:9px 18px; border-radius:24px; font-size:13px; font-weight:700; }

.news-empty { text-align:center; padding:60px 20px; color:var(--ndim); background:var(--ncard); border:1px dashed var(--nborder); border-radius:14px; max-width:1400px; margin:0 auto 24px; }
.news-empty i { font-size:32px; display:block; margin-bottom:10px; opacity:.5; }

.news-videos { }
.news-video-grid { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:16px; }
@media (max-width:760px) {
  .news-video-grid { grid-auto-flow:column; grid-auto-columns:78%; grid-template-columns:none; overflow-x:auto; padding-bottom:6px; scroll-snap-type:x mandatory; }
  .news-video-grid > .news-video-card { scroll-snap-align:start; }
}
.news-video-card { background:var(--ncard); border:1px solid var(--nborder); border-radius:14px; overflow:hidden; box-shadow:var(--nshadow); transition:transform .18s, border-color .18s; }
.news-video-tag { position:absolute; top:10px; left:10px; z-index:2; background:rgba(220,38,38,0.95); color:#fff; font-size:10px; font-weight:800; letter-spacing:.4px; padding:4px 8px; border-radius:6px; text-transform:uppercase; }
.news-video-card:hover { transform:translateY(-4px); border-color:var(--cc, var(--naccent)); }
.news-video-thumb { position:relative; display:block; aspect-ratio:16/9; overflow:hidden; background:#000; cursor:pointer; }
.news-video-thumb img { width:100%; height:100%; object-fit:cover; }
.news-play { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; }
.news-play::before { content:""; position:absolute; width:64px; height:64px; border-radius:50%; background:rgba(255,0,0,0.88); transition:transform .15s; }
.news-video-thumb:hover .news-play::before { transform:scale(1.1); }
.news-play i { position:relative; color:#fff; font-size:22px; margin-left:3px; }
.news-video-body { padding:13px 15px 16px; display:flex; flex-direction:column; gap:8px; }
.news-video-title { color:var(--ntext); font-weight:700; font-size:14.5px; line-height:1.35; text-decoration:none; }
.news-video-title:hover { color:var(--naccent); }

.news-play-badge { position:absolute; top:12px; right:12px; width:34px; height:34px; border-radius:50%; background:rgba(255,0,0,0.9); color:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer; z-index:2; box-shadow:0 2px 8px rgba(0,0,0,.35); }
.news-play-badge i { font-size:13px; margin-left:2px; }

.news-modal { position:fixed; inset:0; background:rgba(0,0,0,0.85); display:none; align-items:center; justify-content:center; z-index:9999; padding:20px; }
.news-modal.open { display:flex; }
.news-modal-box { width:min(900px, 100%); background:var(--ncard); border-radius:14px; overflow:hidden; position:relative; box-shadow:0 20px 60px rgba(0,0,0,.5); }
.news-modal-close { position:absolute; top:10px; right:10px; z-index:3; width:38px; height:38px; border-radius:50%; border:0; background:rgba(0,0,0,.6); color:#fff; cursor:pointer; font-size:16px; }
.news-modal-frame { position:relative; width:100%; padding-top:56.25%; background:#000; }
.news-modal-frame iframe { position:absolute; inset:0; width:100%; height:100%; border:0; }
.news-modal-box h3 { margin:0; padding:16px 18px; font-size:16px; color:var(--ntext); }

@media (max-width: 980px) {
  .news-layout { grid-template-columns: 1fr; padding: 20px 16px 0; gap: 20px; }
  .news-sidebar { position:static; order:2; }
  .news-main { order:1; }
}
@media (max-width:600px) {
  .news-card.size-lg, .news-card.size-tall { grid-column:span 1; grid-row:span 1; }
  .news-card.size-lg .news-thumb, .news-card.size-tall .news-thumb { height:180px; }
  .news-hero { padding: 34px 16px 28px; }
  .news-hero h1 { font-size:30px; }
  .news-filters { padding: 14px 16px; }
}
</style>

<div class="news-page">
  <header class="news-hero">
    <div class="news-hero-inner">
      <div class="news-hero-top">
        <div>
          <span class="news-kicker"><i class="fas fa-microchip"></i> Games &amp; Hacking</span>
          <h1><i class="fas fa-newspaper"></i> Notícias</h1>
          <p>As últimas novidades, análises e alertas de segurança. Alterne os temas ou role para ver tudo.</p>
        </div>
        <div class="news-hero-stats">
          <div class="news-stat"><span class="news-stat-num"><%= total %></span><span class="news-stat-lbl">Notícias</span></div>
          <div class="news-stat"><span class="news-stat-num"><%= categories.length %></span><span class="news-stat-lbl">Categorias</span></div>
          <div class="news-stat"><span class="news-stat-num"><%= galleryVideos.length %></span><span class="news-stat-lbl">Vídeos</span></div>
        </div>
      </div>
      <form action="/noticias" method="GET" class="news-search">
        <i class="fas fa-search"></i>
        <input type="text" name="search" placeholder="Buscar notícias..." value="<%= search %>">
        <button type="submit">Buscar</button>
      </form>
      <div class="news-controls">
        <div class="news-viewtoggle" id="news-viewtoggle">
          <button type="button" data-view="grid" class="active" title="Grade"><i class="fas fa-th-large"></i></button>
          <button type="button" data-view="list" title="Lista"><i class="fas fa-list"></i></button>
        </div>
        <label class="news-sort">
          <i class="fas fa-sort-amount-down"></i>
          <select id="news-sort">
            <option value="recent">Mais recentes</option>
            <option value="popular">Mais lidas</option>
          </select>
        </label>
      </div>
    </div>
  </header>

  <% if (categories.length > 0) { %>
  <nav class="news-filters">
    <a href="/noticias" class="news-chip cat-Todas tema-btn <%= !selectedCategory ? 'active' : '' %>" data-tema=""><i class="fas fa-th-large"></i> Todas</a>
    <a href="/noticias?video=1" class="news-chip cat-Videos tema-btn" data-video="1"><i class="fab fa-youtube"></i> Vídeos</a>
    <% categories.forEach(function(c) { %>
      <a href="/noticias?category=<%= encodeURIComponent(c.category) %>" class="news-chip cat-<%= catClass(c.category) %> tema-btn <%= selectedCategory === c.category ? 'active' : '' %>" data-tema="<%= c.category %>" style="--cc:<%= colorFor(c.category) %>">
        <i class="<%= c.category === 'Hacking' ? 'fas fa-skull-crossbones' : (c.category === 'Games' ? 'fas fa-gamepad' : 'fas fa-tag') %>"></i>
        <%= c.category %> <span class="chip-count"><%= (categoryCounts && categoryCounts[c.category]) || 0 %></span>
      </a>
    <% }) %>
    <span class="news-filter-hint"><i class="fas fa-sliders-h"></i> Selecione uma categoria para filtrar</span>
  </nav>
  <% } %>

  <div class="news-layout">
    <aside class="news-sidebar">
      <% if (trendingList.length > 0) { %>
      <div class="news-side-panel">
        <h3 class="news-side-title"><i class="fas fa-fire"></i> Mais Lidas</h3>
        <ol class="news-trending">
          <% trendingList.forEach(function(t, ti) { %>
            <li>
              <a href="/noticia/<%= t.slug %>" class="news-trend-row" style="--cc:<%= colorFor(t.category) %>">
                <span class="news-rank"><%= ti + 1 %></span>
                <span class="news-trend-thumb"><img src="<%= imgFor(t, '') %>" alt="" loading="lazy"></span>
                <span class="news-trend-info">
                  <span class="news-trend-cat"><%= t.category %></span>
                  <span class="news-trend-title"><%= t.title %></span>
                  <span class="news-trend-views"><i class="far fa-eye"></i> <%= t.views || 0 %> views</span>
                </span>
              </a>
            </li>
          <% }) %>
        </ol>
      </div>
      <% } %>

      <div class="news-newsletter">
        <h4><i class="fas fa-envelope-open-text"></i> Receba no e-mail</h4>
        <p>Novidades de Games &amp; Hacking toda semana. Sem spam.</p>
        <form class="news-news-form" id="news-news-form" onsubmit="return false;">
          <input type="email" id="news-news-email" placeholder="seu@email.com" required>
          <button type="submit"><i class="fas fa-paper-plane"></i> Assinar</button>
        </form>
        <div class="news-news-ok" id="news-news-ok"><i class="fas fa-check"></i> Inscrito! Em breve você recebe novidades.</div>
      </div>
    </aside>

    <main class="news-main">
      <% if (galleryVideos && galleryVideos.length > 0) { %>
      <section class="news-videos" id="news-videos">
        <h2 class="news-section-title"><i class="fab fa-youtube"></i> Galeria de Vídeos</h2>
        <div class="news-video-grid">
          <% galleryVideos.forEach(function(v) { var vid = ytId(v.video); %>
            <div class="news-video-card" data-vid="<%= vid %>" data-video="<%= v.video %>" data-title="<%= v.title %>" style="--cc:<%= colorFor(v.category) %>">
              <a href="/noticia/<%= v.slug %>" class="news-video-thumb">
                <img src="<%= v.image && v.image.indexOf('/') === 0 ? v.image : ('/img/news-thumb?cat=' + encodeURIComponent(v.category || 'Geral') + '&w=600&h=338') %>" alt="<%= v.title %>" loading="lazy" onerror="this.src='/img/news-thumb?cat=<%= encodeURIComponent(v.category || 'Geral') %>&w=600&h=338';">
                <span class="news-video-tag"><i class="fas fa-video"></i> Vídeo</span>
                <span class="news-play"><i class="fas fa-play"></i></span>
              </a>
              <div class="news-video-body">
                <span class="news-cat" style="--cc:<%= colorFor(v.category) %>"><%= v.category %></span>
                <a href="/noticia/<%= v.slug %>" class="news-video-title"><%= v.title %></a>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
      <% } %>

      <% if (featured && featured.length > 0) { %>
      <section class="news-featured">
        <h2 class="news-section-title">Destaques</h2>
        <div class="news-featured-grid">
          <% featured.forEach(function(n, fi) { %>
            <% var fsize = fi === 0 ? 'size-lg' : ''; %>
            <a href="/noticia/<%= n.slug %>" class="news-card <%= fsize %> <%= catClass(n.category) %>" data-tema="<%= n.category %>" style="--cc:<%= colorFor(n.category) %>">
              <div class="news-thumb">
                <img src="<%= imgFor(n, fsize) %>" alt="<%= n.title %>" loading="lazy" onerror="this.src='/img/news-thumb?cat=<%= encodeURIComponent(n.category || 'Geral') %>&w=600&h=400';">
                <span class="news-cat"><%= n.category %></span>
                <span class="news-feat-badge"><i class="fas fa-star"></i> Destaque</span>
              </div>
              <div class="news-body2">
                <h3 class="news-title"><%= n.title %></h3>
                <p class="news-excerpt"><%= (n.excerpt || '').slice(0,160) %></p>
                <div class="news-author">
                  <span class="news-author-ava"><%= (n.author || 'R').charAt(0) %></span>
                  <span class="news-author-name"><%= n.author || 'Redação' %></span>
                </div>
                <div class="news-meta">
                  <span><i class="far fa-calendar"></i> <%= new Date(n.created_at).toLocaleDateString('pt-BR') %></span>
                  <span class="news-views"><i class="far fa-eye"></i> <%= n.views || 0 %></span>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      </section>
      <% } %>

      <% if (news.length === 0) { %>
        <div class="news-empty"><i class="far fa-folder-open"></i><div>Nenhuma notícia encontrada.</div>
          <div class="news-empty-actions">
            <a href="/noticias"><i class="fas fa-th-large"></i> Ver todas</a>
            <a href="/noticias?video=1"><i class="fab fa-youtube"></i> Ver vídeos</a>
          </div>
        </div>
      <% } else { %>
      <div class="news-grid" id="news-grid">
        <% gridNews.forEach(function(n, idx) { %>
          <% var sc = sizeFor(idx); var nw = isNewNews(n.created_at); var rt = readTimeNews(n.content); %>
          <a href="/noticia/<%= n.slug %>" class="news-card <%= sc %> <%= catClass(n.category) %>" data-tema="<%= n.category %>" style="--cc:<%= colorFor(n.category) %>">
            <div class="news-thumb">
              <img src="<%= imgFor(n, sc) %>" alt="<%= n.title %>" loading="lazy" onerror="this.src='/img/news-thumb?cat=<%= encodeURIComponent(n.category || 'Geral') %>&w=600&h=400';">
              <span class="news-cat"><%= n.category %></span>
              <span class="news-badges">
                <% if (nw) { %><span class="news-badge novo">NOVO</span><% } %>
                <span class="news-badge time"><i class="far fa-clock"></i> <%= rt %> min</span>
              </span>
              <% if (n.video) { %><span class="news-play-badge" data-vid="<%= ytId(n.video) %>"><i class="fas fa-play"></i></span><% } %>
            </div>
              <div class="news-body2">
                <h3 class="news-title"><%= n.title %></h3>
                <p class="news-excerpt"><%= (n.excerpt || '').slice(0,140) %></p>
                <div class="news-author">
                  <span class="news-author-ava"><%= (n.author || 'R').charAt(0) %></span>
                  <span class="news-author-name"><%= n.author || 'Redação' %></span>
                </div>
                <div class="news-meta">
                <span><i class="far fa-calendar"></i> <%= new Date(n.created_at).toLocaleDateString('pt-BR') %></span>
                <span class="news-views"><i class="far fa-eye"></i> <%= n.views || 0 %></span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
      <div class="news-skeleton" id="news-skeleton">
        <div class="sk"><div class="sk-thumb"></div><div class="sk-line"></div><div class="sk-line" style="width:60%"></div></div>
        <div class="sk"><div class="sk-thumb"></div><div class="sk-line"></div><div class="sk-line" style="width:60%"></div></div>
        <div class="sk"><div class="sk-thumb"></div><div class="sk-line"></div><div class="sk-line" style="width:60%"></div></div>
      </div>
      <div id="news-sentinel"></div>
      <button class="news-loadmore" id="news-loadmore" style="display:none;">Carregar mais</button>
      <% } %>
    </main>
  </div>

  <div id="news-empty" class="news-empty" style="display:none;"><i class="far fa-folder-open"></i><div>Nenhuma notícia neste tema.</div>
    <div class="news-empty-actions">
      <a href="/noticias"><i class="fas fa-th-large"></i> Ver todas</a>
    </div>
  </div>
</div>

<button class="news-totop" id="news-totop" title="Voltar ao topo"><i class="fas fa-arrow-up"></i></button>

<div class="news-modal" id="news-modal">
  <div class="news-modal-box">
    <button class="news-modal-close" id="news-modal-close"><i class="fas fa-times"></i></button>
    <div class="news-modal-frame" id="news-modal-frame"><iframe id="news-modal-iframe" src="" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
    <h3 id="news-modal-title"></h3>
  </div>
</div>

<script>
(function () {
  var grid = document.getElementById('news-grid');
  var loadMoreBtn = document.getElementById('news-loadmore');
  var sentinel = document.getElementById('news-sentinel');
  var skeleton = document.getElementById('news-skeleton');
  var empty = document.getElementById('news-empty');
  var featuredSection = document.querySelector('.news-featured');
  var modal = document.getElementById('news-modal');
  var modalIframe = document.getElementById('news-modal-iframe');
  var modalTitle = document.getElementById('news-modal-title');
  var state = {
    category: '<%= selectedCategory %>',
    search: '<%= search %>',
    video: false,
    sort: '<%= sort %>',
    offset: <%- news.length %>,
    limit: <%- initialLimit %>,
    loading: false,
    hasMore: <%- hasMore ? 'true' : 'false' %>
  };
  try { var savedView = localStorage.getItem('news_view'); } catch (e) { var savedView = null; }
  if (savedView === 'list' && grid) grid.classList.add('list-view');

  function openVideo(raw, title) {
    if (!modal || !raw) return;
    var yt = ytId(raw);
    var frame = document.getElementById('news-modal-frame');
    var existing = frame.querySelector('video');
    if (existing) existing.remove();
    modalIframe.style.display = '';
    if (yt) {
      modalIframe.src = 'https://www.youtube-nocookie.com/embed/' + yt + '?autoplay=1&rel=0';
    } else {
      modalIframe.style.display = 'none';
      var v = document.createElement('video');
      v.src = raw; v.controls = true; v.autoplay = true;
      v.style.cssText = 'width:100%;height:100%;background:#000;';
      frame.appendChild(v);
    }
    if (modalTitle) modalTitle.textContent = title || '';
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeVideo() {
    if (!modal) return;
    modal.classList.remove('open');
    modalIframe.src = '';
    modalIframe.style.display = '';
    var frame = document.getElementById('news-modal-frame');
    var v = frame.querySelector('video');
    if (v) v.remove();
    document.body.style.overflow = '';
  }
  if (modal) {
    modal.addEventListener('click', function (e) { if (e.target === modal) closeVideo(); });
    var mc = document.getElementById('news-modal-close');
    if (mc) mc.addEventListener('click', closeVideo);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeVideo(); });
  }
  document.addEventListener('click', function (e) {
    var pb = e.target.closest ? e.target.closest('.news-play-badge, .news-video-thumb .news-play') : null;
    if (pb) {
      e.preventDefault();
      var card = pb.closest('[data-video]') || pb.closest('[data-vid]');
      var raw = card ? (card.getAttribute('data-video') || card.getAttribute('data-vid') || '') : (pb.getAttribute('data-video') || pb.getAttribute('data-vid') || '');
      var title = card ? (card.getAttribute('data-title') || '') : '';
      openVideo(raw, title);
    }
  });

  function catClass(c) { return 'cat-' + String(c || '').replace(/[^a-z0-9]/gi, ''); }
  function isNewNews(d) { try { return (Date.now() - new Date(d).getTime()) < 172800000; } catch (e) { return false; } }
  function readTimeNews(c) { var w = (c || '').split(/\s+/).filter(Boolean).length; return Math.max(1, Math.round(w / 200)); }
  function sizeFor(i) { var m = i % 5; return m === 0 ? 'size-lg' : (m === 3 ? 'size-tall' : ''); }
  function colorFor(cat){
    var map={Hacking:'#ff4d4f',Games:'#7c3aed',Tecnologia:'#00b894','Seguranca':'#ff7849','Segurança':'#ff7849','Ciencia':'#0984e3','Ciência':'#0984e3',Hardware:'#e17055',Software:'#6c5ce7'};
    if(map[cat]) return map[cat];
    var h=0,s=String(cat||'Geral'); for(var i=0;i<s.length;i++) h=(h*31+s.charCodeAt(i))>>>0;
    var pal=['#ff4d4f','#7c3aed','#00b894','#0984e3','#e17055','#fdcb6e','#00cec9','#e84393'];
    return pal[h%pal.length];
  }
  function imgFor(n, s) {
    if (n.image && n.image.indexOf('/') === 0) return n.image;
    var dims = s === 'size-lg' ? [800, 500] : (s === 'size-tall' ? [600, 800] : [600, 400]);
    return '/img/news-thumb?cat=' + encodeURIComponent(n.category || 'Geral') + '&w=' + dims[0] + '&h=' + dims[1];
  }
  function ytId(v) { if (!v) return ''; var m = String(v).match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/); return m ? m[1] : ''; }
  function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

  function buildCard(n, idx) {
    var size = sizeFor(idx);
    var cat = catClass(n.category);
    var cc = colorFor(n.category);
    var badges = '';
    if (isNewNews(n.created_at)) badges += '<span class="news-badge novo">NOVO</span>';
    badges += '<span class="news-badge time"><i class="far fa-clock"></i> ' + readTimeNews(n.content) + ' min</span>';
    return '<a href="/noticia/' + esc(n.slug) + '" class="news-card ' + size + ' ' + cat + '" data-tema="' + esc(n.category) + '" style="--cc:' + cc + '">' +
      '<div class="news-thumb">' +
        '<img src="' + imgFor(n, size) + '" alt="' + esc(n.title) + '" loading="lazy" onerror="this.src=\'/img/news-thumb?cat=' + encodeURIComponent(n.category || 'Geral') + '&w=600&h=400\';">' +
        '<span class="news-cat">' + esc(n.category) + '</span>' +
        '<span class="news-badges">' + badges + '</span>' +
        (n.video ? '<span class="news-play-badge" data-vid="' + ytId(n.video) + '" data-video="' + esc(n.video) + '"><i class="fas fa-play"></i></span>' : '') +
      '</div>' +
      '<div class="news-body2">' +
        '<h3 class="news-title">' + esc(n.title) + '</h3>' +
        '<p class="news-excerpt">' + esc((n.excerpt || '').slice(0, 140)) + '</p>' +
        '<div class="news-author"><span class="news-author-ava">' + esc((n.author || 'R').charAt(0)) + '</span><span class="news-author-name">' + esc(n.author || 'Redação') + '</span></div>' +
        '<div class="news-meta"><span><i class="far fa-calendar"></i> ' + new Date(n.created_at).toLocaleDateString('pt-BR') + '</span><span class="news-views"><i class="far fa-eye"></i> ' + (n.views || 0) + '</span></div>' +
      '</div>' +
    '</a>';
  }

  function appendItems(items, start) {
    var html = '';
    for (var i = 0; i < items.length; i++) html += buildCard(items[i], start + i);
    grid.insertAdjacentHTML('beforeend', html);
  }

  function setBusy(b) {
    state.loading = b;
    if (loadMoreBtn) loadMoreBtn.disabled = b;
    if (skeleton) skeleton.style.display = b ? 'grid' : 'none';
  }

  function loadMore() {
    if (state.loading || !state.hasMore) return;
    setBusy(true);
    var url = '/noticias/api?' + (state.video ? 'video=1&' : '') + 'category=' + encodeURIComponent(state.category) + '&search=' + encodeURIComponent(state.search) + '&sort=' + encodeURIComponent(state.sort) + '&offset=' + state.offset + '&limit=' + state.limit;
    fetch(url).then(function (r) { return r.json(); }).then(function (data) {
      appendItems(data.items || [], state.offset);
      state.offset = data.nextOffset || (state.offset + (data.items ? data.items.length : 0));
      state.hasMore = !!data.hasMore;
      if (loadMoreBtn) loadMoreBtn.style.display = state.hasMore ? '' : 'none';
      setBusy(false);
    }).catch(function () { setBusy(false); });
  }

  var chips = document.querySelectorAll('.news-chip');
  chips.forEach(function (b) {
    b.addEventListener('click', function (e) {
      e.preventDefault();
      chips.forEach(function (x) { x.classList.remove('active'); });
      b.classList.add('active');
      var isVideo = b.getAttribute('data-video') === '1';
      var cat = isVideo ? '' : (b.getAttribute('data-tema') || '');
      state.category = cat; state.video = isVideo; state.offset = 0; state.hasMore = true; state.loading = false;
      if (featuredSection) featuredSection.style.display = (cat || isVideo) ? 'none' : '';
      var gallerySection = document.getElementById('news-videos');
      if (gallerySection) gallerySection.style.display = (isVideo || cat) ? 'none' : '';
      grid.innerHTML = '';
      if (empty) empty.style.display = 'none';
      setBusy(true);
      var url = '/noticias/api?' + (isVideo ? 'video=1&' : '') + 'category=' + encodeURIComponent(cat) + '&search=' + encodeURIComponent(state.search) + '&sort=' + encodeURIComponent(state.sort) + '&offset=0&limit=' + state.limit;
      fetch(url).then(function (r) { return r.json(); }).then(function (data) {
        appendItems(data.items || [], 0);
        state.offset = data.nextOffset || (data.items ? data.items.length : 0);
        state.hasMore = !!data.hasMore;
        if (loadMoreBtn) loadMoreBtn.style.display = state.hasMore ? '' : 'none';
        if ((data.items || []).length === 0 && empty) empty.style.display = '';
        setBusy(false);
      }).catch(function () { setBusy(false); });
    });
  });

  if ('IntersectionObserver' in window && sentinel) {
    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) loadMore();
    }, { rootMargin: '500px' });
    io.observe(sentinel);
  }
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', loadMore);
    loadMoreBtn.style.display = state.hasMore ? '' : 'none';
  }

  // === Alternar visualização grade/lista ===
  var viewToggle = document.getElementById('news-viewtoggle');
  if (viewToggle) {
    var vtBtns = viewToggle.querySelectorAll('button');
    vtBtns.forEach(function (b) {
      if (b.getAttribute('data-view') === state.view) {
        vtBtns.forEach(function (x) { x.classList.remove('active'); });
        b.classList.add('active');
      }
      b.addEventListener('click', function () {
        var v = b.getAttribute('data-view');
        vtBtns.forEach(function (x) { x.classList.remove('active'); });
        b.classList.add('active');
        if (grid) grid.classList.toggle('list-view', v === 'list');
        try { localStorage.setItem('news_view', v); } catch (e) {}
      });
    });
  }

  // === Ordenação ===
  var sortSel = document.getElementById('news-sort');
  if (sortSel) {
    sortSel.value = state.sort;
    sortSel.addEventListener('change', function () {
      state.sort = sortSel.value;
      state.offset = 0; state.hasMore = true; state.loading = false;
      if (featuredSection) featuredSection.style.display = (state.category || state.video) ? 'none' : '';
      var gallerySection = document.getElementById('news-videos');
      if (gallerySection) gallerySection.style.display = (state.video || state.category) ? 'none' : '';
      grid.innerHTML = '';
      if (empty) empty.style.display = 'none';
      setBusy(true);
      var url = '/noticias/api?' + (state.video ? 'video=1&' : '') + 'category=' + encodeURIComponent(state.category) + '&search=' + encodeURIComponent(state.search) + '&sort=' + encodeURIComponent(state.sort) + '&offset=0&limit=' + state.limit;
      fetch(url).then(function (r) { return r.json(); }).then(function (data) {
        appendItems(data.items || [], 0);
        state.offset = data.nextOffset || (data.items ? data.items.length : 0);
        state.hasMore = !!data.hasMore;
        if (loadMoreBtn) loadMoreBtn.style.display = state.hasMore ? '' : 'none';
        if ((data.items || []).length === 0 && empty) empty.style.display = '';
        setBusy(false);
      }).catch(function () { setBusy(false); });
    });
  }

  // === Voltar ao topo ===
  var toTop = document.getElementById('news-totop');
  if (toTop) {
    window.addEventListener('scroll', function () {
      if (window.scrollY > 500) toTop.classList.add('show');
      else toTop.classList.remove('show');
    }, { passive: true });
    toTop.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
  }

  // === Newsletter (simulado no cliente) ===
  var nf = document.getElementById('news-news-form');
  if (nf) {
    nf.addEventListener('submit', function () {
      var email = document.getElementById('news-news-email');
      if (!email || !email.value) return;
      nf.style.display = 'none';
      var ok = document.getElementById('news-news-ok');
      if (ok) ok.style.display = 'block';
    });
  }
})();
</script>

