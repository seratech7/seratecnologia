<%- include('partials/header') %>

<div class="marketplace-container" style="padding:24px 16px;max-width:1100px;margin:0 auto;">
  <div class="admin-header-bar" style="margin-bottom:20px;">
    <h1 style="font-size:26px;display:flex;align-items:center;gap:10px;">
      <i class="fas fa-newspaper" style="color:var(--primary);"></i> Notícias & Hacking
    </h1>
  </div>

  <form action="/noticias" method="GET" class="search-form" style="margin-bottom:20px;max-width:480px;">
    <i class="fas fa-search"></i>
    <input type="text" name="search" placeholder="Buscar notícias..." value="<%= search %>">
    <button type="submit">Buscar</button>
  </form>

  <% if (categories.length > 0) { %>
  <div class="news-cats" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px;">
    <a href="/noticias" class="btn-small <%= !selectedCategory ? 'active' : '' %>">Todas</a>
    <% categories.forEach(function(c) { %>
      <a href="/noticias?category=<%= encodeURIComponent(c.category) %>" class="btn-small <%= selectedCategory === c.category ? 'active' : '' %>"><%= c.category %></a>
    <% }) %>
  </div>
  <% } %>

  <% if (featured.length > 0) { %>
  <section style="margin-bottom:32px;">
    <h2 style="font-size:18px;margin-bottom:14px;color:var(--hack-dim);">Destaques</h2>
    <div class="news-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px;">
      <% featured.forEach(function(n) { %>
        <a href="/noticia/<%= n.slug %>" class="news-card featured" style="text-decoration:none;color:inherit;background:var(--card-bg);border:1px solid var(--hack-border);border-radius:12px;overflow:hidden;">
          <% if (n.image) { %><img src="<%= n.image %>" alt="<%= n.title %>" style="width:100%;height:160px;object-fit:cover;"><% } %>
          <div style="padding:14px;">
            <span class="status-badge active" style="font-size:11px;"><%= n.category %></span>
            <h3 style="margin:8px 0;font-size:17px;line-height:1.3;"><%= n.title %></h3>
            <p style="color:var(--hack-dim);font-size:13px;margin:0;"><%= (n.excerpt || '').slice(0,120) %>...</p>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (news.length === 0) { %>
    <div class="empty-row" style="text-align:center;padding:40px;color:var(--hack-dim);">Nenhuma notícia encontrada.</div>
  <% } else { %>
  <div class="news-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px;">
    <% news.forEach(function(n) { %>
      <a href="/noticia/<%= n.slug %>" class="news-card" style="text-decoration:none;color:inherit;background:var(--card-bg);border:1px solid var(--hack-border);border-radius:12px;overflow:hidden;transition:transform .15s;">
        <% if (n.image) { %><img src="<%= n.image %>" alt="<%= n.title %>" style="width:100%;height:150px;object-fit:cover;"><% } %>
        <div style="padding:14px;">
          <span class="status-badge" style="font-size:11px;background:var(--hack-bg-2);color:var(--hack-dim);"><%= n.category %></span>
          <h3 style="margin:8px 0;font-size:16px;line-height:1.3;"><%= n.title %></h3>
          <p style="color:var(--hack-dim);font-size:13px;margin:0 0 8px;"><%= (n.excerpt || '').slice(0,100) %>...</p>
          <span style="font-size:12px;color:var(--hack-dim);"><i class="far fa-eye"></i> <%= n.views || 0 %> · <%= new Date(n.created_at).toLocaleDateString('pt-BR') %></span>
        </div>
      </a>
    <% }) %>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
