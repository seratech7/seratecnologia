<%- include('partials/header') %>

<div class="marketplace-container" style="padding:32px 16px;max-width:760px;margin:0 auto;">
  <a href="/logins" style="color:var(--primary);font-size:14px;text-decoration:none;"><i class="fas fa-arrow-left"></i> Voltar aos logins</a>

  <div style="background:var(--card-bg);border:1px solid var(--hack-border);border-radius:14px;overflow:hidden;margin-top:16px;">
    <% if (product.image) { %><img src="<%= product.image %>" alt="<%= product.name %>" style="width:100%;max-height:320px;object-fit:cover;"><% } %>
    <div style="padding:24px;">
      <% if (product.badge) { %><span class="status-badge active" style="font-size:12px;"><%= product.badge %></span><% } %>
      <h1 style="font-size:26px;margin:10px 0;"><%= product.name %></h1>
      <p style="color:var(--text);font-size:15px;line-height:1.6;"><%= product.description || '' %></p>

      <div style="display:flex;justify-content:space-between;align-items:center;margin:18px 0;border-top:1px solid var(--hack-border);padding-top:18px;">
        <div>
          <span style="font-size:13px;color:var(--hack-dim);display:block;">Preço</span>
          <strong style="font-size:28px;color:var(--primary);">R$ <%= Number(product.price).toFixed(2) %></strong>
        </div>
        <span style="font-size:14px;color:<%= inStock ? '#4caf50' : '#c62828' %>;font-weight:600;">
          <%= inStock ? '✓ Em estoque' : '✗ Esgotado' %>
        </span>
      </div>

      <% if (error) { %><div class="alert alert-error" style="margin-bottom:16px;"><%= error %></div><% } %>

      <% if (inStock && product.status !== 'sold_out') { %>
      <form id="buyForm" method="POST" action="/logins/<%= product.slug %>/comprar" style="display:flex;flex-direction:column;gap:12px;">
        <div class="form-group">
          <label style="font-size:13px;color:var(--hack-dim);">Seu nome</label>
          <input type="text" name="buyer_name" class="admin-input" required placeholder="Nome completo">
        </div>
        <div class="form-group">
          <label style="font-size:13px;color:var(--hack-dim);">E-mail para receber os dados</label>
          <input type="email" name="buyer_email" class="admin-input" required placeholder="voce@email.com">
        </div>
        <div class="form-group">
          <label style="font-size:13px;color:var(--hack-dim);">WhatsApp (opcional)</label>
          <input type="text" name="buyer_phone" class="admin-input" placeholder="(11) 99999-9999">
        </div>

        <div class="form-group">
          <label style="font-size:13px;color:var(--hack-dim);">Receber dados por</label>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:6px;">
            <label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;background:var(--hack-bg-2);border:1px solid var(--hack-border);padding:8px 12px;border-radius:9px;"><input type="radio" name="delivery_channel" value="email" checked onchange="dfgUpdContact()"> <i class="fas fa-envelope"></i> E-mail</label>
            <label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;background:var(--hack-bg-2);border:1px solid var(--hack-border);padding:8px 12px;border-radius:9px;"><input type="radio" name="delivery_channel" value="whatsapp" onchange="dfgUpdContact()"> <i class="fab fa-whatsapp"></i> WhatsApp</label>
            <label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;background:var(--hack-bg-2);border:1px solid var(--hack-border);padding:8px 12px;border-radius:9px;"><input type="radio" name="delivery_channel" value="telegram" onchange="dfgUpdContact()"> <i class="fab fa-telegram"></i> Telegram</label>
            <label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;background:var(--hack-bg-2);border:1px solid var(--hack-border);padding:8px 12px;border-radius:9px;"><input type="radio" name="delivery_channel" value="signal" onchange="dfgUpdContact()"> <i class="fas fa-phone-volume"></i> Signal</label>
          </div>
        </div>

        <div class="form-group" id="deliveryContactWrap" style="display:none;">
          <label style="font-size:13px;color:var(--hack-dim);" id="deliveryContactLabel">Contato para recebimento</label>
          <input type="text" name="delivery_contact" id="deliveryContactInput" class="admin-input" placeholder="">
        </div>

        <div class="form-group">
          <label style="font-size:13px;color:var(--hack-dim);">Observação (opcional)</label>
          <textarea name="observation" class="admin-input" rows="3" placeholder="Alguma observação? (opcional)" style="resize:vertical;font-family:inherit;"></textarea>
        </div>

        <script>
          function dfgUpdContact(){
            var ch = document.querySelector('input[name=delivery_channel]:checked');
            var wrap = document.getElementById('deliveryContactWrap');
            var label = document.getElementById('deliveryContactLabel');
            var input = document.getElementById('deliveryContactInput');
            if(!ch){ return; }
            if(ch.value === 'email'){ wrap.style.display='none'; }
            else if(ch.value === 'whatsapp'){ wrap.style.display='block'; label.textContent='WhatsApp para receber (número)'; input.placeholder='(11) 99999-9999'; }
            else if(ch.value === 'telegram'){ wrap.style.display='block'; label.textContent='Seu usuário Telegram (ex: @usuario)'; input.placeholder='@usuario'; }
            else if(ch.value === 'signal'){ wrap.style.display='block'; label.textContent='Seu número Signal'; input.placeholder='(11) 99999-9999'; }
          }
          dfgUpdContact();
        </script>

        <button type="submit" class="btn-primary" id="buyBtn" style="margin-top:8px;padding:14px;font-size:16px;">
          <i class="fas fa-bolt"></i> Comprar e pagar
        </button>
        <p style="font-size:12px;color:var(--hack-dim);text-align:center;margin:4px 0 0;">Ao clicar, abre o Mercado Pago para pagamento seguro. Após a confirmação, os dados são liberados.</p>
      </form>

      <!-- Modal de pagamento Mercado Pago (mesma página) -->
      <div id="mpModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;align-items:center;justify-content:center;padding:16px;">
        <div style="background:#fff;color:#1a1a1a;border-radius:16px;max-width:480px;width:100%;max-height:92vh;overflow:auto;padding:22px;position:relative;">
          <button id="mpClose" style="position:absolute;top:10px;right:14px;background:none;border:none;font-size:24px;line-height:1;cursor:pointer;color:#666;">&times;</button>
          <h3 style="margin:0 0 4px;font-size:18px;">Finalizar pagamento</h3>
          <p id="mpStatus" style="font-size:13px;color:#666;margin:0 0 16px;">Carregando o Mercado Pago...</p>
          <div id="mp-checkout"></div>
        </div>
      </div>

      <script>
      (function(){
        var form = document.getElementById('buyForm');
        if(!form) return;
        var btn = document.getElementById('buyBtn');
        var modal = document.getElementById('mpModal');
        var closeBtn = document.getElementById('mpClose');
        var statusEl = document.getElementById('mpStatus');
        var container = document.getElementById('mp-checkout');
        var pollTimer = null, code = null;

        function setStatus(t, isErr){ statusEl.textContent = t; statusEl.style.color = isErr ? '#c62828' : '#666'; }
        var csrfMeta = document.querySelector('meta[name="csrf-token"]');
        var csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : '';
        function loadMpSdk(cb){
          if(window.MercadoPago) return cb();
          var s = document.createElement('script'); s.src = 'https://sdk.mercadopago.com/js/v2';
          s.onload = cb; s.onerror = function(){ setStatus('Não foi possível carregar o Mercado Pago.', true); };
          document.head.appendChild(s);
        }
        function openCheckout(prefId, publicKey){
          loadMpSdk(function(){
            try {
              var mp = new MercadoPago(publicKey, { locale: 'pt-BR' });
              container.innerHTML = '';
              mp.checkout({ preference: { id: prefId }, render: { container: '#mp-checkout', label: 'Pagar com Mercado Pago' } });
              setTimeout(function(){ var b = container.querySelector('button'); if(b) b.click(); }, 900);
            } catch(e){ setStatus('Erro ao abrir o pagamento: ' + e.message, true); }
          });
        }
        function startPolling(){
          if(pollTimer) return;
          pollTimer = setInterval(function(){
            fetch('/logins/api/digital/venda/' + code + '/status').then(function(r){return r.json();}).then(function(d){
              if(!d.ok) return;
              if(d.payment_status === 'approved' || d.status === 'confirmed'){
                clearInterval(pollTimer); pollTimer = null;
                setStatus('Pagamento aprovado! Liberando dados...', false);
                setTimeout(function(){ window.location.href = '/entrega/' + code; }, 1300);
              } else if(d.payment_status === 'rejected' || d.payment_status === 'cancelled' || d.status === 'cancelled'){
                clearInterval(pollTimer); pollTimer = null;
                setStatus('Pagamento não concluído (' + d.payment_status + '). Tente novamente.', true);
              }
            }).catch(function(){});
          }, 4000);
        }
        form.addEventListener('submit', function(e){
          e.preventDefault();
          btn.disabled = true; btn.style.opacity = .7; setStatus('Processando...', false);
          var fd = new FormData(form);
          var body = new URLSearchParams();
          fd.forEach(function(v,k){ body.append(k, v); });
          fetch(form.getAttribute('action'), { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':csrfToken}, body: body.toString() })
            .then(function(r){ return r.json(); }).then(function(d){
              if(!d.ok){ btn.disabled = false; btn.style.opacity = 1; setStatus(d.error || 'Erro ao iniciar pagamento.', true); return; }
              code = d.deliveryCode;
              modal.style.display = 'flex';
              openCheckout(d.preferenceId, d.publicKey);
              startPolling();
            }).catch(function(){ btn.disabled = false; btn.style.opacity = 1; setStatus('Erro de conexão.', true); });
        });
        function closeModal(){ modal.style.display = 'none'; if(pollTimer){ clearInterval(pollTimer); pollTimer = null; } }
        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', function(e){ if(e.target === modal) closeModal(); });
      })();
      </script>
      <% } else { %>
        <div class="empty-row" style="text-align:center;padding:24px;">
          <% if (product.status === 'sold_out') { %>
            <i class="fas fa-ban" style="font-size:34px;color:#f0a500;margin-bottom:10px;"></i>
            <p style="font-size:16px;font-weight:600;margin:0 0 6px;color:#f0a500;">Esgotado</p>
            <p style="color:var(--hack-dim);margin:0;">Este anúncio está esgotado no momento. Assim que houver reposição, voltará a ficar disponível.</p>
          <% } else { %>
            <i class="fas fa-box-open" style="font-size:34px;color:var(--hack-dim);margin-bottom:10px;"></i>
            <p style="color:var(--hack-dim);margin:0;">Produto indisponível no momento.</p>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
