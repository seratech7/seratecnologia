<%- include('partials/header') %>

<% if (banners && banners.length > 0) { %>
<section class="banner-carousel">
  <div class="banner-track">
    <% banners.forEach(function(b, i) { %>
      <div class="banner-slide" data-duration="<%= b.display_duration || 10 %>">
        <a href="<%= b.link || '#' %>" target="<%= b.link ? '_blank' : '_self' %>">
          <img src="<%= b.image %>" alt="<%= b.title %>" loading="lazy">
          <% if (b.title || b.subtitle) { %>
          <div class="banner-overlay">
            <% if (b.title) { %><h2><%= b.title %></h2><% } %>
            <% if (b.subtitle) { %><p><%= b.subtitle %></p><% } %>
          </div>
          <% } %>
        </a>
      </div>
    <% }) %>
  </div>
  <% if (banners.length > 1) { %>
  <button class="banner-arrow banner-arrow-left" data-dir="-1">&#10094;</button>
  <button class="banner-arrow banner-arrow-right" data-dir="1">&#10095;</button>
  <div class="banner-dots">
    <% banners.forEach(function(b, i) { %>
      <span class="banner-dot <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>"></span>
    <% }) %>
  </div>
  <% } %>
</section>
<% } %>

<%
function q(urlParams) {
  var p = [];
  if (search) p.push('search=' + encodeURIComponent(search));
  if (selectedCategory) p.push('category=' + encodeURIComponent(selectedCategory));
  if (selectedCondition) p.push('condition=' + encodeURIComponent(selectedCondition));
  if (selectedLocation) p.push('location=' + encodeURIComponent(selectedLocation));
  if (priceMin) p.push('price_min=' + encodeURIComponent(priceMin));
  if (priceMax) p.push('price_max=' + encodeURIComponent(priceMax));
  if (selectedSort) p.push('sort=' + encodeURIComponent(selectedSort));
  return p.length ? '?' + p.join('&') : '/';
}
%>

<div class="marketplace-container">
  <button class="filter-toggle" id="filterToggle">
    <i class="fas fa-filter"></i>
    <span>Filtros</span>
    <% var activeFilters = (selectedCategory ? 1 : 0) + (selectedCondition ? 1 : 0) + (selectedLocation ? 1 : 0) + (priceMin || priceMax ? 1 : 0) + (selectedSort ? 1 : 0); %>
    <% if (activeFilters > 0) { %><span class="filter-badge"><%= activeFilters %></span><% } %>
  </button>

  <div class="filter-overlay" id="filterOverlay"></div>

  <div class="filter-sheet" id="filterSheet">
    <div class="filter-sheet-header">
      <span class="filter-sheet-title"><i class="fas fa-filter"></i> Filtros</span>
      <button class="filter-sheet-close" id="filterSheetClose">&times;</button>
    </div>
    <div class="filter-sheet-body" id="filterSheetBody">
      <form method="GET" action="/" class="filter-form" id="filterFormMobile">
        <% if (search) { %><input type="hidden" name="search" value="<%= search %>"><% } %>

        <div class="filter-section">
          <h4>Categorias</h4>
          <div class="filter-options-grid">
            <label class="filter-chip <%= !selectedCategory ? 'active' : '' %>">
              <input type="radio" name="category" value="" <%= !selectedCategory ? 'checked' : '' %>>
              <i class="fas fa-th-large"></i> Todas
            </label>
            <% categories.forEach(cat => { %>
              <label class="filter-chip <%= selectedCategory === cat.slug ? 'active' : '' %>">
                <input type="radio" name="category" value="<%= cat.slug %>" <%= selectedCategory === cat.slug ? 'checked' : '' %>>
                <%= cat.icon || '📦' %> <%= cat.name %>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="filter-section">
          <h4>Condição</h4>
          <div class="filter-options-grid">
            <label class="filter-chip <%= !selectedCondition ? 'active' : '' %>">
              <input type="radio" name="condition" value="" <%= !selectedCondition ? 'checked' : '' %>>
              Todas
            </label>
            <label class="filter-chip <%= selectedCondition === 'new' ? 'active' : '' %>">
              <input type="radio" name="condition" value="new" <%= selectedCondition === 'new' ? 'checked' : '' %>>
              <span class="cond-dot new"></span> Novo
            </label>
            <label class="filter-chip <%= selectedCondition === 'open-box' ? 'active' : '' %>">
              <input type="radio" name="condition" value="open-box" <%= selectedCondition === 'open-box' ? 'checked' : '' %>>
              <span class="cond-dot open-box"></span> Aberto
            </label>
            <label class="filter-chip <%= selectedCondition === 'semi-new' ? 'active' : '' %>">
              <input type="radio" name="condition" value="semi-new" <%= selectedCondition === 'semi-new' ? 'checked' : '' %>>
              <span class="cond-dot semi-new"></span> Semi-novo
            </label>
            <label class="filter-chip <%= selectedCondition === 'used' ? 'active' : '' %>">
              <input type="radio" name="condition" value="used" <%= selectedCondition === 'used' ? 'checked' : '' %>>
              <span class="cond-dot used"></span> Usado
            </label>
            <label class="filter-chip <%= selectedCondition === 'refurbished' ? 'active' : '' %>">
              <input type="radio" name="condition" value="refurbished" <%= selectedCondition === 'refurbished' ? 'checked' : '' %>>
              <span class="cond-dot refurbished"></span> Recondicionado
            </label>
          </div>
        </div>

        <div class="filter-section">
          <h4>Localização</h4>
          <div class="filter-options-grid">
            <label class="filter-chip <%= !selectedLocation ? 'active' : '' %>">
              <input type="radio" name="location" value="" <%= !selectedLocation ? 'checked' : '' %>>
              <i class="fas fa-globe"></i> Todas
            </label>
            <% locations.forEach(function(loc) { %>
              <label class="filter-chip <%= selectedLocation === loc.location ? 'active' : '' %>">
                <input type="radio" name="location" value="<%= loc.location %>" <%= selectedLocation === loc.location ? 'checked' : '' %>>
                <i class="fas fa-map-marker-alt"></i> <%= loc.location %>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="filter-section">
          <h4>Faixa de Preço</h4>
          <div class="price-range-horizontal">
            <input type="number" name="price_min" placeholder="R$ min" value="<%= priceMin %>" class="price-field" min="0" step="0.01">
            <span class="price-sep">—</span>
            <input type="number" name="price_max" placeholder="R$ max" value="<%= priceMax %>" class="price-field" min="0" step="0.01">
          </div>
        </div>

        <div class="filter-section">
          <h4>Ordenar</h4>
          <select name="sort" class="sort-select">
            <option value="" <%= !selectedSort ? 'selected' : '' %>>Mais recentes</option>
            <option value="price_asc" <%= selectedSort === 'price_asc' ? 'selected' : '' %>>Menor preço</option>
            <option value="price_desc" <%= selectedSort === 'price_desc' ? 'selected' : '' %>>Maior preço</option>
            <option value="oldest" <%= selectedSort === 'oldest' ? 'selected' : '' %>>Mais antigos</option>
          </select>
        </div>

        <div class="filter-sheet-actions">
          <a href="/" class="btn-clear-filters"><i class="fas fa-times-circle"></i> Limpar tudo</a>
          <button type="submit" class="btn-apply-filters"><i class="fas fa-check"></i> Aplicar</button>
        </div>
      </form>
    </div>
  </div>

  <aside class="sidebar-filters" id="sidebarFilters">
    <form method="GET" action="/" class="filter-form" id="filterFormDesktop">
      <% if (search) { %><input type="hidden" name="search" value="<%= search %>"><% } %>

      <div class="filter-section">
        <h3><i class="fas fa-filter"></i> Filtros</h3>
        <a href="/" class="clear-filters"><i class="fas fa-times-circle"></i> Limpar</a>
      </div>

      <div class="filter-section">
        <h4>Categorias</h4>
        <ul class="category-list">
          <li>
            <label class="filter-label <%= !selectedCategory ? 'active' : '' %>">
              <input type="radio" name="category" value="" <%= !selectedCategory ? 'checked' : '' %>>
              <i class="fas fa-th-large"></i> Todas
            </label>
          </li>
          <% categories.forEach(cat => { %>
            <li>
              <label class="filter-label <%= selectedCategory === cat.slug ? 'active' : '' %>">
                <input type="radio" name="category" value="<%= cat.slug %>" <%= selectedCategory === cat.slug ? 'checked' : '' %>>
                <%= cat.icon || '📦' %> <%= cat.name %>
              </label>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="filter-section">
        <h4>Condição</h4>
        <ul class="condition-list">
          <li>
            <label class="filter-label <%= !selectedCondition ? 'active' : '' %>">
              <input type="radio" name="condition" value="" <%= !selectedCondition ? 'checked' : '' %>>
              Todas
            </label>
          </li>
          <li>
            <label class="filter-label <%= selectedCondition === 'new' ? 'active' : '' %>">
              <input type="radio" name="condition" value="new" <%= selectedCondition === 'new' ? 'checked' : '' %>>
              <span class="cond-dot new"></span> Novo
            </label>
          </li>
          <li>
            <label class="filter-label <%= selectedCondition === 'open-box' ? 'active' : '' %>">
              <input type="radio" name="condition" value="open-box" <%= selectedCondition === 'open-box' ? 'checked' : '' %>>
              <span class="cond-dot open-box"></span> Aberto
            </label>
          </li>
          <li>
            <label class="filter-label <%= selectedCondition === 'semi-new' ? 'active' : '' %>">
              <input type="radio" name="condition" value="semi-new" <%= selectedCondition === 'semi-new' ? 'checked' : '' %>>
              <span class="cond-dot semi-new"></span> Semi-novo
            </label>
          </li>
          <li>
            <label class="filter-label <%= selectedCondition === 'used' ? 'active' : '' %>">
              <input type="radio" name="condition" value="used" <%= selectedCondition === 'used' ? 'checked' : '' %>>
              <span class="cond-dot used"></span> Usado
            </label>
          </li>
          <li>
            <label class="filter-label <%= selectedCondition === 'refurbished' ? 'active' : '' %>">
              <input type="radio" name="condition" value="refurbished" <%= selectedCondition === 'refurbished' ? 'checked' : '' %>>
              <span class="cond-dot refurbished"></span> Recondicionado
            </label>
          </li>
        </ul>
      </div>

      <div class="filter-section">
        <h4>Localização</h4>
        <ul class="category-list">
          <li>
            <label class="filter-label <%= !selectedLocation ? 'active' : '' %>">
              <input type="radio" name="location" value="" <%= !selectedLocation ? 'checked' : '' %>>
              <i class="fas fa-globe"></i> Todas
            </label>
          </li>
          <% locations.forEach(function(loc) { %>
            <li>
              <label class="filter-label <%= selectedLocation === loc.location ? 'active' : '' %>">
                <input type="radio" name="location" value="<%= loc.location %>" <%= selectedLocation === loc.location ? 'checked' : '' %>>
                <i class="fas fa-map-marker-alt"></i> <%= loc.location %>
              </label>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="filter-section">
        <h4>Faixa de Preço</h4>
        <div class="price-range">
          <div class="price-inputs">
            <input type="number" name="price_min" placeholder="R$ min" value="<%= priceMin %>" class="price-field" min="0" step="0.01">
            <span class="price-sep">—</span>
            <input type="number" name="price_max" placeholder="R$ max" value="<%= priceMax %>" class="price-field" min="0" step="0.01">
          </div>
          <button type="submit" class="btn-price-apply">Aplicar</button>
        </div>
      </div>

      <div class="filter-section">
        <h4>Ordenar</h4>
        <select name="sort" class="sort-select" onchange="this.form.submit()">
          <option value="" <%= !selectedSort ? 'selected' : '' %>>Mais recentes</option>
          <option value="flash" <%= selectedSort === 'flash' ? 'selected' : '' %>>⚡ Ofertas</option>
          <option value="price_asc" <%= selectedSort === 'price_asc' ? 'selected' : '' %>>Menor preço</option>
          <option value="price_desc" <%= selectedSort === 'price_desc' ? 'selected' : '' %>>Maior preço</option>
          <option value="oldest" <%= selectedSort === 'oldest' ? 'selected' : '' %>>Mais antigos</option>
        </select>
      </div>
    </form>
  </aside>

  <% if (flashProducts && flashProducts.length > 0) { %>
  <section class="flash-section flash-featured">
    <div class="flash-header">
      <div class="flash-header-left">
        <i class="fas fa-bolt"></i>
        <h2><%= flashProducts[0].category_icon || '⚡' %> <%= flashProducts[0].category_name || 'Ofertas Relâmpago' %></h2>
        <span class="flash-badge-header"><i class="fas fa-clock"></i> TEMPO LIMITADO</span>
      </div>
      <div class="flash-timer" id="flashTimer">
        <i class="fas fa-clock"></i>
        <span id="flashCountdown"></span>
      </div>
      <a href="/?sort=flash&category=<%= flashProducts[0].category_slug || (flashProducts[0].category_name ? flashProducts[0].category_name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'') : '') %>" class="flash-ver-todas">Ver todas <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="flash-grid flash-grid-featured">
      <% flashProducts.forEach(function(p) { %>
        <a href="/produto/<%= p.id %>" class="flash-card flash-card-featured">
          <div class="flash-card-image">
            <img src="<%= p.image || '' %>" alt="<%= p.name %>" loading="lazy">
            <span class="flash-card-badge"><i class="fas fa-bolt"></i> -<%= Math.round((1 - p.flash_price / p.price) * 100) %>%</span>
          </div>
          <div class="flash-card-info">
            <h3><%= p.name %></h3>
            <div class="flash-card-pricing">
              <span class="flash-card-price"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(p.flash_price) %></span>
              <span class="flash-card-original"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(p.price) %></span>
            </div>
            <div class="flash-card-timer" data-ends="<%= new Date(p.flash_ends_at).getTime() %>">
              <i class="fas fa-hourglass-half"></i>
              <span class="flash-remaining"></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <section class="products-section">
    <div class="products-header">
      <h2>
        <% if (search) { %>
          Resultados para "<%= search %>"
        <% } else if (selectedCategory) { %>
          <% const cat = categories.find(c => c.slug === selectedCategory) %>
          <%= cat ? cat.icon + ' ' + cat.name : 'Produtos' %>
        <% } else { %>
          <i class="fas fa-microchip"></i> Tecnologia em Destaque
        <% } %>
      </h2>
      <div class="products-header-info">
        <span class="products-count"><%= products.length %> produto(s)</span>
          <select class="sort-select-mobile" onchange="var p=new URLSearchParams(location.search);p.set('sort',this.value);location='?'+p.toString()">
            <option value="" <%= !selectedSort ? 'selected' : '' %>>Recentes</option>
            <option value="flash" <%= selectedSort === 'flash' ? 'selected' : '' %>><i class="fas fa-bolt"></i> Ofertas</option>
            <option value="price_asc" <%= selectedSort === 'price_asc' ? 'selected' : '' %>>Menor preço</option>
            <option value="price_desc" <%= selectedSort === 'price_desc' ? 'selected' : '' %>>Maior preço</option>
          </select>
      </div>
    </div>

    <% if (products.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-box-open"></i>
        <h3>Nenhum produto encontrado</h3>
        <p>Tente buscar por outros termos ou navegue pelas categorias.</p>
        <% if (typeof homepageError !== 'undefined' && homepageError) { %>
          <p style="color:#e74c3c;font-size:12px;margin-top:8px;background:#fdecea;padding:8px 12px;border-radius:6px;">
            <strong>Erro interno:</strong> <%= homepageError %>
          </p>
        <% } %>
        <a href="/" class="btn-empty-reset"><i class="fas fa-times-circle"></i> Limpar filtros</a>
      </div>
    <% } else { %>
      <div class="products-grid">
        <% products.forEach(product => { %>
          <a href="/produto/<%= product.id %>" class="product-card">
            <div class="product-image">
              <% if (product.image) { %>
                <img src="<%= product.image %>" alt="<%= product.name %>">
              <% } else { %>
                <div class="no-image">
                  <i class="fas fa-image"></i>
                </div>
              <% } %>
              <% if (product.featured) { %>
                <span class="featured-badge"><i class="fas fa-star"></i> Destaque</span>
              <% } %>
              <% if (product.flash_price && product.flash_ends_at && new Date(product.flash_ends_at) > new Date()) { %>
                <span class="flash-badge"><i class="fas fa-bolt"></i> Flash</span>
              <% } %>
              <% var condClass = product.condition || 'new'; %>
              <% if (condClass === 'new') { %>
                <span class="condition-badge new">Novo</span>
              <% } else if (condClass === 'open-box') { %>
                <span class="condition-badge" style="background:#ff9800;">Aberto</span>
              <% } else if (condClass === 'semi-new') { %>
                <span class="condition-badge" style="background:#7c4dff;">Semi-novo</span>
              <% } else if (condClass === 'refurbished') { %>
                <span class="condition-badge" style="background:#009688;">Recondicionado</span>
              <% } else { %>
                <span class="condition-badge used">Usado</span>
              <% } %>
            </div>
            <div class="product-info">
              <h3 class="product-name"><%= product.name %></h3>
              <p class="product-price">
                <% if (product.flash_price && product.flash_ends_at && new Date(product.flash_ends_at) > new Date()) { %>
                  <span class="flash-price"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(product.flash_price) %></span>
                  <span class="original-price"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(product.price) %></span>
                <% } else { %>
                  <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(product.price) %>
                <% } %>
              </p>
              <div class="product-meta">
                <span class="product-location">
                  <i class="fas fa-map-marker-alt"></i> <%= product.location || 'Brasil' %>
                </span>
                <span class="product-code"><%= product.code || 'PROD-' + String(product.id).padStart(5, '0') %></span>
              </div>
              <div class="product-stats" style="display:flex;gap:12px;font-size:12px;color:#999;margin-top:6px;">
                <span><i class="fas fa-eye"></i> <%= product.views || 0 %></span>
                <span><i class="fas fa-shopping-cart"></i> <%= product.sales_count || 0 %></span>
                <% if (product.seller_whatsapp) { %>
                  <% var waNum = product.seller_whatsapp.replace(/\D/g, ''); %>
                  <a href="https://wa.me/55<%= waNum %>?text=<%= encodeURIComponent('Olá! Tenho interesse em: ' + product.name) %>" target="_blank" style="color:#25D366;margin-left:auto;" title="Falar com vendedor">
                    <i class="fab fa-whatsapp"></i>
                  </a>
                <% } %>
              </div>
              <button type="button"
                class="product-buy-btn"
                data-code="<%= product.code || 'PROD-' + String(product.id).padStart(5, '0') %>"
                data-name="<%= product.name.replace(/"/g, '&quot;') %>"
                data-price="<%= product.flash_price && product.flash_ends_at && new Date(product.flash_ends_at) > new Date() ? product.flash_price : product.price %>"
                data-image="<%= product.image || '' %>"
                data-location="<%= product.location || 'Brasil' %>"
                data-quantity="<%= product.quantity || 0 %>"
                data-whatsapp="<%= product.seller_whatsapp || '' %>"
                onclick="event.preventDefault();event.stopPropagation();abrirCompraRapida(this)">
                <i class="fas fa-shopping-cart"></i> Comprar Agora
              </button>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

<!-- MODAL DE COMPRA RÁPIDA -->
<div class="quickbuy-overlay" id="quickbuyOverlay" style="display:none;">
  <div class="quickbuy-modal" role="dialog" aria-modal="true">
    <button type="button" class="quickbuy-close" onclick="fecharCompraRapida()" aria-label="Fechar">&times;</button>
    <div class="quickbuy-body" id="quickbuyBody">
      <div id="quickbuyProduto">
        <div class="quickbuy-product" style="display:flex;gap:16px;align-items:center;margin-bottom:16px;">
          <div class="quickbuy-thumb" id="qbImagem" style="width:90px;height:90px;border-radius:8px;background:#f5f5f5;flex-shrink:0;display:flex;align-items:center;justify-content:center;overflow:hidden;font-size:30px;color:#ccc;">
            <i class="fas fa-image"></i>
          </div>
          <div style="flex:1;min-width:0;">
            <div style="font-family:monospace;font-size:12px;color:#1565c0;font-weight:700;" id="qbCodigo"></div>
            <h3 style="margin:4px 0 6px;font-size:17px;line-height:1.3;" id="qbNome"></h3>
            <div style="font-size:24px;font-weight:800;color:#1565c0;" id="qbPreco"></div>
            <div style="font-size:12px;color:#888;margin-top:4px;" id="qbEstoque"></div>
          </div>
        </div>

        <div style="background:#fff;border-radius:10px;padding:16px;margin-bottom:16px;border:1px solid #eee;">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <i class="fas fa-ticket-alt" style="color:#9c27b0;"></i>
            <span style="font-size:13px;font-weight:600;color:#555;">Cupom de desconto</span>
            <input type="text" id="qbCupom" placeholder="DIGITE O CÓDIGO" style="flex:1;min-width:120px;padding:8px 10px;border:2px solid #ddd;border-radius:6px;font-size:13px;font-family:monospace;text-transform:uppercase;letter-spacing:1px;">
            <button type="button" onclick="aplicarCupomRapido()" style="padding:8px 14px;background:#9c27b0;color:#fff;border:none;border-radius:6px;font-weight:600;cursor:pointer;font-size:13px;"><i class="fas fa-check"></i> Aplicar</button>
          </div>
        </div>

        <h4 style="margin:0 0 12px;font-size:15px;"><i class="fas fa-user"></i> Dados do Comprador</h4>
        <form id="qbForm" onsubmit="return gerarPagamentoRapido(event)">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div style="grid-column:1/-1;">
              <label style="display:block;font-size:13px;font-weight:600;color:#444;margin-bottom:4px;">Nome Completo *</label>
              <input type="text" name="nome" id="qbNomeComprador" required style="width:100%;padding:11px;border:2px solid #ddd;border-radius:8px;font-size:14px;">
            </div>
            <div>
              <label style="display:block;font-size:13px;font-weight:600;color:#444;margin-bottom:4px;">CPF/CNPJ *</label>
              <input type="text" name="documento" required style="width:100%;padding:11px;border:2px solid #ddd;border-radius:8px;font-size:14px;">
            </div>
            <div>
              <label style="display:block;font-size:13px;font-weight:600;color:#444;margin-bottom:4px;">Telefone/WhatsApp *</label>
              <input type="tel" name="telefone" required style="width:100%;padding:11px;border:2px solid #ddd;border-radius:8px;font-size:14px;">
            </div>
            <div style="grid-column:1/-1;">
              <label style="display:block;font-size:13px;font-weight:600;color:#444;margin-bottom:4px;">E-mail *</label>
              <input type="email" name="email" required style="width:100%;padding:11px;border:2px solid #ddd;border-radius:8px;font-size:14px;">
            </div>
            <div style="grid-column:1/-1;">
              <label style="display:block;font-size:13px;font-weight:600;color:#444;margin-bottom:4px;">Endereço Completo *</label>
              <input type="text" name="endereco" required placeholder="Rua, número, bairro, cidade, estado, CEP" style="width:100%;padding:11px;border:2px solid #ddd;border-radius:8px;font-size:14px;">
            </div>
          </div>

          <div id="qbErro" style="display:none;background:#fdecea;color:#c62828;padding:12px 16px;border-radius:8px;margin-top:12px;font-size:13px;"></div>

          <div style="margin-top:16px;">
            <button type="submit" id="qbBtnPix" style="width:100%;padding:13px;background:#00c853;color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;transition:background .2s;">
              <i class="fas fa-qrcode"></i> Gerar QR Code PIX
            </button>
          </div>
        </form>
      </div>

      <div id="quickbuyPix" style="display:none;text-align:center;">
        <h3 style="margin:0 0 6px;"><i class="fas fa-qrcode"></i> Pagamento via PIX</h3>
        <p style="color:#666;margin:0 0 6px;font-size:13px;">Escaneie o QR Code abaixo para pagar</p>
        <p style="font-size:13px;color:#888;margin:0 0 16px;">Pagamento para <strong id="qbPixSeller"></strong></p>
        <div style="display:inline-block;background:#fff;padding:12px;border-radius:12px;border:2px solid #e0e0e0;">
          <img id="qbQrImage" src="" alt="QR Code PIX" style="width:210px;height:210px;display:block;">
        </div>
        <div style="margin-top:12px;">
          <button onclick="copiarPixRapido()" style="padding:9px 18px;background:#fff;color:#1565c0;border:2px solid #1565c0;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;">
            <i class="fas fa-copy"></i> Copiar chave PIX
          </button>
        </div>
        <div id="qbChaveDisplay" style="margin-top:6px;font-family:monospace;font-size:12px;color:#999;word-break:break-all;"></div>
        <div id="qbResumo" style="margin-top:14px;text-align:left;background:#f9f9f9;border-radius:8px;padding:14px;font-size:13px;line-height:1.8;"></div>
        <div id="qbResultado"></div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var toggle = document.getElementById('filterToggle');
  var sheet = document.getElementById('filterSheet');
  var overlay = document.getElementById('filterOverlay');
  var closeBtn = document.getElementById('filterSheetClose');

  function openSheet() {
    sheet.classList.add('active');
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeSheet() {
    sheet.classList.remove('active');
    overlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  if (toggle) {
    toggle.addEventListener('click', function() {
      if (window.innerWidth <= 768) openSheet();
    });
  }
  if (closeBtn) closeBtn.addEventListener('click', closeSheet);
  if (overlay) overlay.addEventListener('click', closeSheet);

  // Desktop: auto-submit nos radios
  var desktopForm = document.getElementById('filterFormDesktop');
  if (desktopForm && window.innerWidth > 768) {
    desktopForm.querySelectorAll('input[type="radio"]').forEach(function(r) {
      r.addEventListener('change', function() { desktopForm.submit(); });
    });
  }

  // Fecha sheet ao submeter
  var mobileForm = document.getElementById('filterFormMobile');
  if (mobileForm) {
    mobileForm.addEventListener('submit', function() {
      setTimeout(closeSheet, 150);
    });
  }

  // Banner carousel
  var carousel = document.querySelector('.banner-carousel');
  var track = carousel ? carousel.querySelector('.banner-track') : null;
  var slides = carousel ? carousel.querySelectorAll('.banner-slide') : [];
  var dots = carousel ? carousel.querySelectorAll('.banner-dot') : [];
  var arrows = carousel ? carousel.querySelectorAll('.banner-arrow') : [];
  if (track && dots.length > 0) {
    var current = 0;
    var total = dots.length;
    var autoTimer = null;
    function getDuration(index) {
      var slide = slides[index];
      return (slide ? parseInt(slide.dataset.duration) : 10) * 1000;
    }
    function goTo(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      current = index;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach(function(d, i) {
        d.classList.toggle('active', i === current);
      });
      resetAuto();
    }
    function resetAuto() {
      if (autoTimer) clearTimeout(autoTimer);
      autoTimer = setTimeout(function() { goTo(current + 1); }, getDuration(current));
    }
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() { goTo(parseInt(this.dataset.index)); });
    });
    arrows.forEach(function(arrow) {
      arrow.addEventListener('click', function() { goTo(current + parseInt(this.dataset.dir)); });
    });
    resetAuto();
  }

  // Flash sale countdown timers
  var flashTimers = document.querySelectorAll('.flash-card-timer');
  var globalTimer = document.getElementById('flashCountdown');
  var earliestEnd = Infinity;

  function updateFlashTimers() {
    var now = Date.now();
    flashTimers.forEach(function(el) {
      var end = parseInt(el.dataset.ends);
      var diff = Math.max(0, end - now);
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      el.querySelector('.flash-remaining').textContent =
        String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
      if (diff <= 0) el.closest('.flash-card').style.display = 'none';
    });
    if (globalTimer && flashTimers.length) {
      var earliest = Infinity;
      flashTimers.forEach(function(el) { var e = parseInt(el.dataset.ends); if (e < earliest) earliest = e; });
      var diff = Math.max(0, earliest - now);
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      globalTimer.textContent = 'Encerra em ' + String(h).padStart(2,'0') + 'h ' + String(m).padStart(2,'0') + 'm ' + String(s).padStart(2,'0') + 's';
    }
  }
  if (flashTimers.length) { updateFlashTimers(); setInterval(updateFlashTimers, 1000); }
});

/* ===== COMPRA RÁPIDA (modal) ===== */
var qbProduto = null;
var qbUltimoPayload = '';
var qbTotal = 0;

function csrfToken() { var m = document.querySelector('meta[name="csrf-token"]'); return m ? m.content : ''; }

function abrirCompraRapida(btn) {
  var price = parseFloat(btn.dataset.price) || 0;
  var qty = parseInt(btn.dataset.quantity) || 0;
  qbProduto = {
    code: btn.dataset.code,
    name: btn.dataset.name,
    price: price,
    image: btn.dataset.image,
    location: btn.dataset.location,
    quantity: qty,
    whatsapp: btn.dataset.whatsapp
  };
  qbTotal = price;

  var img = document.getElementById('qbImagem');
  if (qbProduto.image) {
    img.innerHTML = '<img src="' + qbProduto.image + '" alt="' + qbProduto.name + '" style="width:100%;height:100%;object-fit:cover;">';
  } else {
    img.innerHTML = '<i class="fas fa-image"></i>';
  }
  document.getElementById('qbCodigo').textContent = qbProduto.code;
  document.getElementById('qbNome').textContent = qbProduto.name;
  document.getElementById('qbPreco').textContent = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(price);
  var stock = document.getElementById('qbEstoque');
  if (qty <= 0) {
    stock.innerHTML = '<span style="color:#c62828;"><i class="fas fa-cubes"></i> Produto esgotado</span>';
  } else if (qty <= 5) {
    stock.innerHTML = '<span style="color:#e65100;"><i class="fas fa-cubes"></i> Só ' + qty + ' em estoque!</span>';
  } else {
    stock.innerHTML = '<span style="color:#2e7d32;"><i class="fas fa-cubes"></i> Em estoque</span>';
  }

  document.getElementById('qbCupom').value = '';
  document.getElementById('qbForm').reset();
  document.getElementById('qbErro').style.display = 'none';
  document.getElementById('quickbuyPix').style.display = 'none';
  document.getElementById('quickbuyProduto').style.display = 'block';
  document.getElementById('qbResultado').innerHTML = '';

  document.getElementById('quickbuyOverlay').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function fecharCompraRapida() {
  document.getElementById('quickbuyOverlay').style.display = 'none';
  document.body.style.overflow = '';
}

document.getElementById('quickbuyOverlay').addEventListener('click', function(e) {
  if (e.target === this) fecharCompraRapida();
});
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') fecharCompraRapida();
});

function aplicarCupomRapido() {
  var cupomInput = document.getElementById('qbCupom');
  var cupom = (cupomInput ? cupomInput.value : '').trim();
  if (!qbProduto || !cupom) return;
  fetch('/api/cupom/' + encodeURIComponent(cupom) + '?codigo=' + encodeURIComponent(qbProduto.code), {
    headers: { 'X-CSRF-Token': csrfToken() }
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.error) {
      alert(data.error);
      return;
    }
    qbTotal = data.price;
    document.getElementById('qbPreco').textContent = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(data.price);
    document.getElementById('qbPreco').style.color = '#2e7d32';
  }).catch(function() { alert('Erro ao aplicar cupom'); });
}

function gerarPagamentoRapido(e) {
  e.preventDefault();
  if (!qbProduto) return;
  var btn = document.getElementById('qbBtnPix');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gerando...';
  document.getElementById('qbErro').style.display = 'none';

  var form = document.getElementById('qbForm');
  var dados = {
    codigo: qbProduto.code,
    nome: form.nome.value,
    documento: form.documento.value,
    telefone: form.telefone.value,
    email: form.email.value,
    endereco: form.endereco.value,
    cupom: (document.getElementById('qbCupom').value || '').trim()
  };

  fetch('/api/gerar-pix', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken() },
    body: JSON.stringify({ codigo: dados.codigo, nome: dados.nome })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.error) {
      document.getElementById('qbErro').textContent = data.error;
      document.getElementById('qbErro').style.display = 'block';
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-qrcode"></i> Gerar QR Code PIX';
      return;
    }

    document.getElementById('qbQrImage').src = data.qrcode;
    document.getElementById('qbPixSeller').textContent = data.sellerName;
    document.getElementById('qbChaveDisplay').textContent = 'Chave: ' + data.chave;
    qbUltimoPayload = data.payload;

    var resumo = document.getElementById('qbResumo');
    resumo.innerHTML =
      '<strong>Produto:</strong> ' + qbProduto.name + '<br>' +
      '<strong>Código:</strong> ' + dados.codigo + '<br>' +
      '<strong>Valor:</strong> ' + new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(qbTotal) + '<br>' +
      '<strong>Vendedor:</strong> ' + data.sellerName + '<br>' +
      '<strong>Comprador:</strong> ' + dados.nome + '<br>' +
      '<strong>WhatsApp:</strong> ' + dados.telefone + '<br>' +
      '<strong>E-mail:</strong> ' + dados.email + '<br>' +
      '<strong>Endereço:</strong> ' + dados.endereco;

    document.getElementById('quickbuyProduto').style.display = 'none';
    document.getElementById('quickbuyPix').style.display = 'block';
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-qrcode"></i> Gerar QR Code PIX';

    fetch('/api/finalizar-compra', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken() },
      body: JSON.stringify(dados)
    }).then(function(r) { return r.json(); }).then(function(resp) {
      var sellerWa = (qbProduto.whatsapp || '').replace(/\D/g, '');
      if (resp.success) {
        var waLink = '';
        if (sellerWa) {
          var waMsg = encodeURIComponent('Olá! Acabei de comprar o produto ' + dados.codigo + '. Meu WhatsApp é ' + dados.telefone);
          waLink = '<a href="https://wa.me/55' + sellerWa + '?text=' + waMsg + '" target="_blank" style="display:inline-flex;align-items:center;gap:8px;margin-top:12px;padding:11px 22px;background:#25D366;color:#fff;border-radius:8px;text-decoration:none;font-weight:700;font-size:14px;">' +
            '<i class="fab fa-whatsapp"></i> Falar com Vendedor</a>';
        }
        document.getElementById('qbResultado').innerHTML =
          '<div style="margin-top:16px;padding:16px;background:#e8f5e9;border-radius:8px;text-align:center;">' +
          '<i class="fas fa-check-circle" style="color:#2e7d32;font-size:26px;"></i>' +
          '<p style="font-weight:700;color:#2e7d32;margin:8px 0 4px;">Compra registrada com sucesso!</p>' +
          '<p style="font-size:13px;color:#555;margin:4px 0;">Código de rastreio:</p>' +
          '<p style="font-size:17px;font-weight:800;color:#1565c0;font-family:monospace;letter-spacing:1px;margin:4px 0;">' + resp.trackingCode + '</p>' +
          '<a href="/rastreio?codigo=' + resp.trackingCode + '" style="display:inline-block;margin-top:8px;padding:8px 16px;background:#1565c0;color:#fff;border-radius:8px;text-decoration:none;font-weight:600;font-size:13px;">' +
          '<i class="fas fa-truck"></i> Acompanhar Pedido</a>' +
          waLink +
          '<div style="margin-top:12px;"><button onclick="fecharCompraRapida()" style="padding:8px 16px;background:#eee;color:#555;border:none;border-radius:8px;font-weight:600;font-size:13px;cursor:pointer;">Fechar</button></div>' +
          '</div>';
      }
    }).catch(function() {});
  }).catch(function() {
    document.getElementById('qbErro').textContent = 'Erro ao gerar PIX. Tente novamente.';
    document.getElementById('qbErro').style.display = 'block';
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-qrcode"></i> Gerar QR Code PIX';
  });
}

function copiarPixRapido() {
  if (qbUltimoPayload) {
    navigator.clipboard.writeText(qbUltimoPayload).then(function() {
      alert('Código PIX copiado!');
    }).catch(function() {
      prompt('Copie o código PIX abaixo:', qbUltimoPayload);
    });
  }
}
</script>

