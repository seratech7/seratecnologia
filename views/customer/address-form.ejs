<%- include('../partials/header') %>

<div class="container" style="max-width:520px;margin:0 auto;padding:40px 16px;">
  <div style="text-align:center;margin-bottom:24px;">
    <i class="fas fa-map-marker-alt" style="font-size:40px;color:var(--primary);opacity:0.6;"></i>
    <h1 style="margin:8px 0 4px;font-size:22px;"><%= address ? 'Editar' : 'Novo' %> Endereço</h1>
  </div>

  <% if (error) { %>
  <div style="background:#fff3e0;color:#e65100;padding:14px 16px;border-radius:8px;margin-bottom:16px;font-size:14px;">
    <i class="fas fa-exclamation-circle"></i> <%= error %>
  </div>
  <% } %>

  <div style="background:#fff;border-radius:12px;box-shadow:0 1px 4px rgba(0,0,0,0.08);padding:28px;">
    <form method="POST" action="<%= address ? '/conta/enderecos/' + address.id + '/editar' : '/conta/enderecos/novo' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div style="margin-bottom:14px;">
        <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Identificação (ex: Casa, Trabalho)</label>
        <input type="text" name="label" value="<%= address ? address.label : '' %>" placeholder="Casa" style="width:100%;padding:12px 14px;border:2px solid #ddd;border-radius:8px;font-size:15px;">
      </div>
      <div style="margin-bottom:14px;">
        <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Destinatário</label>
        <input type="text" name="recipient" value="<%= address ? address.recipient : '' %>" placeholder="Nome de quem recebe" style="width:100%;padding:12px 14px;border:2px solid #ddd;border-radius:8px;font-size:15px;">
      </div>
      <div style="margin-bottom:14px;">
        <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Endereço *</label>
        <input type="text" name="address" value="<%= address ? address.address : '' %>" required placeholder="Rua, número, complemento, bairro" style="width:100%;padding:12px 14px;border:2px solid #ddd;border-radius:8px;font-size:15px;">
      </div>
      <div style="display:grid;grid-template-columns:2fr 1fr;gap:12px;margin-bottom:14px;">
        <div>
          <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Cidade</label>
          <input type="text" name="city" value="<%= address ? address.city : '' %>" style="width:100%;padding:12px 14px;border:2px solid #ddd;border-radius:8px;font-size:15px;">
        </div>
        <div>
          <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">UF</label>
          <input type="text" name="state" value="<%= address ? address.state : '' %>" maxlength="2" placeholder="SP" style="width:100%;padding:12px 14px;border:2px solid #ddd;border-radius:8px;font-size:15px;">
        </div>
      </div>
      <div style="margin-bottom:16px;">
        <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">CEP</label>
        <input type="text" name="zip" value="<%= address ? address.zip : '' %>" placeholder="00000-000" style="width:100%;padding:12px 14px;border:2px solid #ddd;border-radius:8px;font-size:15px;">
      </div>
      <button type="submit" class="btn-primary" style="width:100%;padding:13px;border-radius:8px;font-size:15px;font-weight:700;">
        <i class="fas fa-save"></i> Salvar endereço
      </button>
    </form>
    <div style="text-align:center;margin-top:14px;">
      <a href="/conta" style="color:#666;font-size:14px;text-decoration:none;"><i class="fas fa-arrow-left"></i> Voltar para Minha Conta</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
